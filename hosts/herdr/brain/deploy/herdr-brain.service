# herdr-brain — systemd USER unit (installed by deploy/install.sh).
#
# The GLM_API_KEY never lives in this repo. The installer extracts it from
# ~/.dotfiles/shell/private-env.sh into %h/.config/herdr-brain/env (outside
# the repo, mode 600) and this unit reads it from there. That is deliberate:
# systemd does not source interactive-shell dotfiles, so a manual
# `nohup ... &` from a tool shell silently loses the key and /ask 503s —
# exactly the incident this unit exists to prevent. The env file is the
# single stable contract between the dotfiles world and the service.

[Unit]
Description=Herdr Brain (voice PWA backend)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Code/personal/herdr-brain
ExecStart=%h/Code/personal/herdr-brain/.venv/bin/python -m herdr_brain.server
Environment=HERDR_BRAIN_HOST=0.0.0.0
# The systemd user manager PATH is minimal and excludes linuxbrew, where the
# herdr CLI lives. Without an absolute HERDR_BIN every `herdr agent list`
# fails to execute and /herd fail-softs to an empty herd ("NADIE, sin datos").
Environment=HERDR_BIN=/home/linuxbrew/.linuxbrew/bin/herdr
EnvironmentFile=%h/.config/herdr-brain/env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
