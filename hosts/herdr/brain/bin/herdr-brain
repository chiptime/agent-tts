#!/usr/bin/env bash
# herdr-brain — launcher and CLI entrypoint for Herdr plugin & standalone usage.
set -euo pipefail

# >>> herdr portable resolvers (AT-11 design Decision 4) >>>
# Minimal bash mirror of tools/herdr_onboarding/resolve.py for use before
# any Python is available. This block is byte-identical in bin/herdr-tts
# and bin/herdr-brain; $1 parameterizes the launcher, and each entry point
# calls only the resolvers it needs.
herdr_resolve_root() { # $1 = launcher basename -> installation root
  # HERDR_PLUGIN_ROOT wins; else ascend from this script's own resolved
  # directory (symlinks resolved), up to 6 levels, taking the first
  # directory whose bin/$1 exists.
  local d i
  if [[ -n "${HERDR_PLUGIN_ROOT:-}" ]]; then
    printf '%s\n' "$HERDR_PLUGIN_ROOT"
    return 0
  fi
  d="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
  for i in 1 2 3 4 5 6; do
    d="$(dirname "$d")"
    if [[ -f "$d/bin/$1" ]]; then
      printf '%s\n' "$d"
      return 0
    fi
  done
  echo "ERROR: cannot resolve the installation root; set HERDR_PLUGIN_ROOT to the root containing bin/$1 (design Decision 4)." >&2
  return 1
}

herdr_resolve_tts_home() { # $1 = brain installation root -> tts-plugin home
  # OQ-2 resolution (Engram #9681): an explicitly set AND valid
  # HERDR_TTS_HOME wins; unset or unusable derives <root>/../tts-plugin;
  # a hardcoded default is never exported. Neither candidate usable ->
  # error naming both.
  local sibling
  if [[ -n "${HERDR_TTS_HOME:-}" && -d "${HERDR_TTS_HOME}" ]]; then
    printf '%s\n' "$HERDR_TTS_HOME"
    return 0
  fi
  sibling="$(cd "$1/.." 2>/dev/null && pwd)/tts-plugin"
  if [[ -d "$sibling" ]]; then
    printf '%s\n' "$sibling"
    return 0
  fi
  echo "ERROR: cannot resolve the tts-plugin home: HERDR_TTS_HOME=${HERDR_TTS_HOME:-<unset>} is not a usable directory and $sibling does not exist; set HERDR_TTS_HOME to the tts-plugin root." >&2
  return 1
}

herdr_resolve_bin() { # -> herdr binary via six-step discovery
  # 1) HERDR_BIN 2) PATH 3) $HOMEBREW_PREFIX/bin/herdr 4) brew --prefix
  # 5) $HOME/.local/bin/herdr 6) bare "herdr". No literal prefixes.
  local prefix
  if [[ -n "${HERDR_BIN:-}" ]]; then
    printf '%s\n' "$HERDR_BIN"
    return 0
  fi
  if command -v herdr >/dev/null 2>&1; then
    command -v herdr
    return 0
  fi
  if [[ -n "${HOMEBREW_PREFIX:-}" && -x "$HOMEBREW_PREFIX/bin/herdr" ]]; then
    printf '%s\n' "$HOMEBREW_PREFIX/bin/herdr"
    return 0
  fi
  if command -v brew >/dev/null 2>&1; then
    if prefix="$(brew --prefix 2>/dev/null)" && [[ -n "$prefix" && -x "$prefix/bin/herdr" ]]; then
      printf '%s\n' "$prefix/bin/herdr"
      return 0
    fi
  fi
  if [[ -n "${HOME:-}" && -x "$HOME/.local/bin/herdr" ]]; then
    printf '%s\n' "$HOME/.local/bin/herdr"
    return 0
  fi
  printf '%s\n' "herdr"
}

herdr_resolve_port() { # $1 = brain config dir -> HERDR_BRAIN_PORT value
  # HERDR_BRAIN_PORT -> persisted config ($1/config.env, sourcable
  # KEY=VALUE lines) -> default 8741.
  local cfg line raw
  if [[ -n "${HERDR_BRAIN_PORT:-}" ]]; then
    printf '%s\n' "$HERDR_BRAIN_PORT"
    return 0
  fi
  cfg="$1/config.env"
  if [[ -f "$cfg" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      raw="${line%%#*}"
      raw="${raw#"${raw%%[![:space:]]*}"}"
      raw="${raw%"${raw##*[![:space:]]}"}"
      if [[ "$raw" == "HERDR_BRAIN_PORT="* ]]; then
        raw="${raw#HERDR_BRAIN_PORT=}"
        raw="${raw%\"}"; raw="${raw#\"}"
        raw="${raw%\'}"; raw="${raw#\'}"
        printf '%s\n' "$raw"
        return 0
      fi
    done < "$cfg"
  fi
  printf '%s\n' "8741"
}
# <<< herdr portable resolvers <<<

# >>> herdr first-run hand-off (AT-11 task 3.5) >>>
# Reaches the shared first-run wizard (tools/herdr_onboarding) through this
# entry point's own venv interpreter: PYTHONPATH=<tools> <venv python> -m
# herdr_onboarding --role <role>. This block is byte-identical in
# bin/herdr-tts and bin/herdr-brain. An unusable interpreter or an
# unreachable module is reported honestly (exit 127) and never aborts the
# launcher's real work; the wizard's own exit contract (0/10/20/30/40) is
# passed through untouched.
herdr_onboarding_lib() { # -> directory that directly contains herdr_onboarding/
  # 1) HERDR_ONBOARDING_HOME  2) ascend from this script's resolved real
  # directory, up to 6 levels, first D with D/tools/herdr_onboarding/
  # __main__.py -> D/tools  3) fail naming (1). The Homebrew keg stages
  # only the plugin subdirectory, so it honestly has no wizard.
  local d i
  if [[ -n "${HERDR_ONBOARDING_HOME:-}" ]]; then
    if [[ -f "${HERDR_ONBOARDING_HOME}/herdr_onboarding/__main__.py" ]]; then
      printf '%s\n' "$HERDR_ONBOARDING_HOME"
      return 0
    fi
    echo "ERROR: HERDR_ONBOARDING_HOME=${HERDR_ONBOARDING_HOME} does not contain herdr_onboarding/__main__.py." >&2
    return 1
  fi
  d="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
  for i in 1 2 3 4 5 6 7; do
    if [[ -f "$d/tools/herdr_onboarding/__main__.py" ]]; then
      printf '%s\n' "$d/tools"
      return 0
    fi
    d="$(dirname "$d")"
  done
  echo "ERROR: the first-run wizard is not available in this layout (no tools/herdr_onboarding within 6 levels; the Homebrew keg route does not include it); set HERDR_ONBOARDING_HOME to the directory containing herdr_onboarding/." >&2
  return 1
}

herdr_first_run_marker() { # -> completion marker path
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/herdr-tts/first-run.done"
}

herdr_first_run() { # $1 = role, $2 = venv python; rest = wizard args -> wizard exit code
  local role="$1" py="$2" lib
  shift 2
  if [[ ! -x "$py" ]]; then
    echo "ERROR: the first-run wizard is unavailable: interpreter $py is missing (run the installer or bootstrap first)." >&2
    return 127
  fi
  lib="$(herdr_onboarding_lib)" || return 127
  PYTHONPATH="$lib${PYTHONPATH:+:$PYTHONPATH}" "$py" -m herdr_onboarding --role "$role" "$@"
}

herdr_first_run_auto() { # $1 = role, $2 = venv python, $3 = launcher name, $4 = hint-only|auto
  # Startup-class commands only. Marker present or HERDR_ONBOARDING_NO_FIRST_RUN
  # set -> nothing. No TTY (or hint-only) -> print how to configure
  # unattended and carry on: startup NEVER blocks and never fails here.
  local role="$1" py="$2" name="$3" mode="${4:-auto}" rc=0
  [[ -n "${HERDR_ONBOARDING_NO_FIRST_RUN:-}" ]] && return 0
  [[ -f "$(herdr_first_run_marker)" ]] && return 0
  if [[ "$mode" == "auto" && -t 0 && -t 1 ]]; then
    herdr_first_run "$role" "$py" || rc=$?
    if (( rc != 0 )); then
      echo "$name: onboarding ended with exit $rc and wrote no completion marker (20 = answer missing, 30 = health gate failed, 40 = aborted, 127 = wizard unavailable); startup continues. Retry with: $name first-run" >&2
    fi
    return 0
  fi
  {
    echo "$name: first-run onboarding is not complete (no completion marker)."
    echo "  Interactive:   $name first-run"
    echo "  Unattended:    $name first-run --non-interactive   (answers via flags or HERDR_ONBOARDING_* variables; the GLM key via HERDR_ONBOARDING_SECRET_FD or HERDR_ONBOARDING_SECRET_FILE, never argv)"
    echo "  Skip for now:  $name --no-first-run <command>   (or export HERDR_ONBOARDING_NO_FIRST_RUN=1)"
  } >&2
  return 0
}
# <<< herdr first-run hand-off <<<

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(herdr_resolve_root herdr-brain)"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-brain"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/herdr-brain"
PID_FILE="$STATE_DIR/daemon.pid"
SUPERVISOR_STOP_FLAG="$STATE_DIR/supervisor.stop"
LOG_FILE="$STATE_DIR/server.log"

mkdir -p "$STATE_DIR" "$CONFIG_DIR"

# ---------------------------------------------------------------- env discovery
load_env() {
  export HERDR_BRAIN_HOST="${HERDR_BRAIN_HOST:-0.0.0.0}"
  # Port (design Decision 4): HERDR_BRAIN_PORT -> persisted config
  # ($CONFIG_DIR/config.env) -> default 8741; the resolved value is
  # exported so the server and the status paths see one knob.
  export HERDR_BRAIN_PORT="$(herdr_resolve_port "$CONFIG_DIR")"

  # OQ-2 precedence (Engram #9681 / design Decision 4): an explicitly
  # set-and-valid HERDR_TTS_HOME wins; unset derives the sibling
  # tts-plugin from this launcher's own location. No hardcoded default
  # is ever exported (the legacy per-machine default was removed by
  # delivering this precedence).
  local tts_home
  tts_home="$(herdr_resolve_tts_home "$REPO_DIR")" || exit 1
  export HERDR_TTS_HOME="$tts_home"

  # Discover HERDR_BIN if not pinned (six-step discovery, design Decision 4)
  if [[ -z "${HERDR_BIN:-}" ]]; then
    HERDR_BIN="$(herdr_resolve_bin)"
    export HERDR_BIN
  fi

  # Discover GLM_API_KEY if not in environment (design Decision 4):
  # process env -> $CONFIG_DIR/env -> plugin config dir. No interactive
  # dotfile is ever scraped.
  if [[ -z "${GLM_API_KEY:-}" ]]; then
    if [[ -f "$CONFIG_DIR/env" ]]; then
      # shellcheck disable=SC1090
      set -a; . "$CONFIG_DIR/env"; set +a
    fi
    local plugin_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/plugins/config/herdr.brain/config.env"
    if [[ -z "${GLM_API_KEY:-}" && -f "$plugin_cfg" ]]; then
      # shellcheck disable=SC1090
      set -a; . "$plugin_cfg"; set +a
    fi
  fi
}

# Optional remote-exposure URL (RF-AT-11-9): from the environment or the
# persisted $CONFIG_DIR/config.env only; never inferred or hardcoded.
remote_url() {
  local cfg="$CONFIG_DIR/config.env" line raw
  if [[ -n "${HERDR_BRAIN_REMOTE_URL:-}" ]]; then
    printf '%s\n' "$HERDR_BRAIN_REMOTE_URL"
    return 0
  fi
  [[ -f "$cfg" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    raw="${line%%#*}"
    raw="${raw#"${raw%%[![:space:]]*}"}"
    raw="${raw%"${raw##*[![:space:]]}"}"
    if [[ "$raw" == "HERDR_BRAIN_REMOTE_URL="* ]]; then
      raw="${raw#HERDR_BRAIN_REMOTE_URL=}"
      raw="${raw%\"}"; raw="${raw#\"}"
      raw="${raw%\'}"; raw="${raw#\'}"
      printf '%s\n' "$raw"
      return 0
    fi
  done < "$cfg"
}

ensure_venv() {
  local venv_py="$REPO_DIR/.venv/bin/python"
  if [[ ! -x "$venv_py" ]]; then
    if [[ -x "$REPO_DIR/scripts/bootstrap.sh" ]]; then
      bash "$REPO_DIR/scripts/bootstrap.sh"
    else
      echo "ERROR: Missing .venv in $REPO_DIR and bootstrap.sh not found." >&2
      exit 1
    fi
  fi
}

# ------------------------------------------------------- port ownership policy
# Audit C5 / design Decision 4: only a process this installation provably
# owns may be signalled. Ownership is (a) our pidfile naming a live
# herdr_brain process, or (b) the systemd unit's MainPID. Anything else on
# the port is foreign: exit non-zero and leave it alone.
EXIT_PORT_IN_USE=98

port_listener_pid() {
  local port="${HERDR_BRAIN_PORT:-8741}" pid=""
  pid="$(ss -tlnp "sport = :${port}" 2>/dev/null | grep -oE 'pid=[0-9]+' | head -n1 | cut -d= -f2 || true)"
  if [[ -z "$pid" ]] && command -v lsof >/dev/null 2>&1; then
    pid="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | head -n1 || true)"
  fi
  printf '%s\n' "$pid"
}

port_is_listening() { # true even when the listener's PID is not visible to us
  [[ -n "$(port_listener_pid)" ]] && return 0
  [[ -n "$(ss -tln "sport = :${HERDR_BRAIN_PORT:-8741}" 2>/dev/null | tail -n +2)" ]]
}

proc_command() { ps -o command= -p "$1" 2>/dev/null || true; }
proc_name() { ps -o comm= -p "$1" 2>/dev/null | head -n1 || true; }

is_brain_process() { # live process whose command line is our server/CLI
  [[ "$1" =~ ^[0-9]+$ ]] && kill -0 "$1" 2>/dev/null && [[ "$(proc_command "$1")" == *herdr_brain* ]]
}

pidfile_pid() {
  local p
  p="$(cat "$PID_FILE" 2>/dev/null || true)"
  if [[ "$p" =~ ^[0-9]+$ ]]; then printf '%s\n' "$p"; fi
  return 0
}

unit_main_pid() {
  local p
  p="$(systemctl --user show -P MainPID --value herdr-brain.service 2>/dev/null || true)"
  if [[ "$p" =~ ^[0-9]+$ && "$p" != "0" ]]; then printf '%s\n' "$p"; fi
  return 0
}

owner_of() { # $1 = pid -> "unit" | "pidfile" | "" (not ours)
  local unit_pid
  unit_pid="$(unit_main_pid)"
  if [[ -n "$unit_pid" && "$unit_pid" == "$1" ]]; then
    echo unit
  elif [[ "$(pidfile_pid)" == "$1" ]] && is_brain_process "$1"; then
    echo pidfile
  fi
  return 0
}

signal_owned() { # $1 = signal, $2 = pid; ownership re-verified right now
  if [[ "$(owner_of "$2")" == "pidfile" ]]; then
    kill -"$1" "$2" 2>/dev/null || true
    return 0
  fi
  return 1
}

clean_stale_pidfile() { # a pidfile that no longer names our process is dropped, never signalled
  local p
  p="$(pidfile_pid)"
  if [[ -n "$p" ]] && ! is_brain_process "$p"; then
    rm -f "$PID_FILE" 2>/dev/null || true
  fi
}

refuse_port() { # $1 = port, $2 = pid (may be empty)
  local name=""
  if [[ -n "${2:-}" ]]; then name="$(proc_name "$2")"; fi
  {
    if [[ -n "${2:-}" ]]; then
      echo "[herdr-brain] ERROR: port $1 is in use by PID $2 (${name:-unknown process}), which this installation does not own; refusing to signal it."
    else
      echo "[herdr-brain] ERROR: port $1 is in use by a process whose PID is not visible to this user; refusing to touch it."
    fi
    echo "  Fix: choose another port (export HERDR_BRAIN_PORT=<free port>, or persist it in $CONFIG_DIR/config.env),"
    echo "       or stop that process yourself and retry."
  } >&2
  exit "$EXIT_PORT_IN_USE"
}

claim_port() { # $1 = daemon | installer ; frees the port only from our own instance
  local mode="${1:-daemon}" port="${HERDR_BRAIN_PORT:-8741}" pid owner i
  clean_stale_pidfile
  pid="$(port_listener_pid)"
  if [[ -z "$pid" ]]; then
    if port_is_listening; then refuse_port "$port" ""; fi
    return 0
  fi
  if [[ "$pid" == "$$" ]]; then return 0; fi
  owner="$(owner_of "$pid")"
  case "$owner" in
    unit)
      if [[ "$mode" == "installer" ]]; then return 0; fi
      echo "[herdr-brain] Stopping systemd unit herdr-brain to allow the plugin daemon..."
      systemctl --user stop herdr-brain.service 2>/dev/null || true
      ;;
    pidfile)
      echo "[herdr-brain] Stopping the previous herdr-brain instance (PID $pid) on port $port..."
      signal_owned TERM "$pid" || true
      ;;
    *)
      refuse_port "$port" "$pid"
      ;;
  esac
  for i in $(seq 1 25); do
    if [[ -z "$(port_listener_pid)" ]]; then return 0; fi
    sleep 0.2
  done
  if [[ "$owner" == "pidfile" ]]; then
    signal_owned KILL "$pid" || true
    sleep 0.5
  fi
  pid="$(port_listener_pid)"
  if [[ -n "$pid" ]]; then refuse_port "$port" "$pid"; fi
  return 0
}

daemon_pid() { # pid of an instance we own (never an arbitrary port listener)
  local p lp
  p="$(pidfile_pid)"
  if [[ -n "$p" ]] && is_brain_process "$p"; then
    printf '%s\n' "$p"
    return 0
  fi
  lp="$(port_listener_pid)"
  if [[ -n "$lp" && -n "$(owner_of "$lp")" ]]; then
    printf '%s\n' "$lp"
    return 0
  fi
  return 1
}

# ---------------------------------------------------------------- commands
cmd_daemon() {
  load_env
  ensure_venv
  claim_port daemon

  printf '%s\n' "$$" > "$PID_FILE"
  trap 'rm -f "$PID_FILE" 2>/dev/null || true' EXIT

  echo "[herdr-brain] Starting server on $HERDR_BRAIN_HOST:$HERDR_BRAIN_PORT (PID $$)..."
  exec "$REPO_DIR/.venv/bin/python" -m herdr_brain.server
}

cmd_daemon_supervised() {
  local child_pid="" rc=0 forward_sig=""
  rm -f "$SUPERVISOR_STOP_FLAG" 2>/dev/null || true

  _sup_forward() {
    forward_sig="${1:-TERM}"
    if [[ -n "${child_pid:-}" ]] && kill -0 "$child_pid" 2>/dev/null; then
      kill -"$forward_sig" "$child_pid" 2>/dev/null || true
    else
      exit 0
    fi
  }

  _sup_reap() {
    if [[ -n "${child_pid:-}" ]] && kill -0 "$child_pid" 2>/dev/null; then
      kill "$child_pid" 2>/dev/null || true
      wait "$child_pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE" 2>/dev/null || true
  }

  trap '_sup_forward INT' INT
  trap '_sup_forward TERM' TERM
  trap '_sup_reap' EXIT

  while true; do
    forward_sig=""
    "$REAL_SCRIPT" _daemon &
    child_pid=$!
    rc=0
    wait "$child_pid" || rc=$?
    child_pid=""

    if [[ -n "$forward_sig" ]]; then
      exit 0
    fi

    if [[ "$rc" == "$EXIT_PORT_IN_USE" ]]; then
      echo "[herdr-brain] Supervisor: the port is held by a process we do not own; not restarting." >&2
      exit "$EXIT_PORT_IN_USE"
    fi

    if [[ -f "$SUPERVISOR_STOP_FLAG" ]]; then
      rm -f "$SUPERVISOR_STOP_FLAG" 2>/dev/null || true
      echo "[herdr-brain] Supervisor: stop requested, exiting."
      exit 0
    fi

    echo "[herdr-brain] Supervisor: server exited with code $rc, restarting in 2s..."
    sleep 2
  done
}

cmd_status() {
  load_env
  local url="http://127.0.0.1:${HERDR_BRAIN_PORT:-8741}/health"
  local pid=""
  pid="$(daemon_pid || true)"

  echo "─── Herdr Brain Status ───"
  if [[ -n "$pid" ]]; then
    echo "Process PID : $pid (running)"
  else
    echo "Process PID : not found (stopped)"
  fi

  local health
  if health=$(curl -fsS -m 2 "$url" 2>/dev/null); then
    echo "Health Check: OK (200)"
    echo "Details     : $health"
  else
    echo "Health Check: DOWN (cannot reach $url)"
  fi

  echo ""
  cmd_url
}

cmd_url() {
  load_env
  local port="${HERDR_BRAIN_PORT:-8741}"
  echo "Local URL: http://localhost:$port/"

  # Remote exposure is user-configured, never guessed (RF-AT-11-9).
  local remote
  remote="$(remote_url)"
  if [[ -n "$remote" ]]; then
    echo "Remote URL: $remote"
  fi
}

cmd_stop() {
  touch "$SUPERVISOR_STOP_FLAG" 2>/dev/null || true
  local pid owner
  pid="$(daemon_pid || true)"
  if [[ -n "$pid" ]]; then
    owner="$(owner_of "$pid")"
    echo "Stopping Herdr Brain (PID $pid)..."
    if [[ "$owner" == "unit" ]]; then
      systemctl --user stop herdr-brain.service 2>/dev/null || true
    else
      signal_owned TERM "$pid" || true
      for _ in $(seq 1 10); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.2
      done
      if kill -0 "$pid" 2>/dev/null; then
        signal_owned KILL "$pid" || true
      fi
    fi
    echo "Stopped."
  else
    echo "Herdr Brain is not running."
  fi
  rm -f "$PID_FILE" 2>/dev/null || true
}

cmd_restart() {
  echo "Restarting Herdr Brain..."
  cmd_stop
  sleep 1
  # Relaunch in background
  nohup "$REAL_SCRIPT" _daemon-supervised >> "$LOG_FILE" 2>&1 &
  sleep 1
  cmd_status
}

# ---------------------------------------------------------------- entrypoint
if [[ "${1:-}" == "--no-first-run" ]]; then
  export HERDR_ONBOARDING_NO_FIRST_RUN=1
  shift
fi
case "${1:-status}" in
  _daemon|_daemon-supervised|restart|--restart)
    herdr_first_run_auto brain "$REPO_DIR/.venv/bin/python" herdr-brain
    ;;
esac
case "${1:-status}" in
  first-run|--first-run)
    shift
    herdr_first_run brain "$REPO_DIR/.venv/bin/python" "$@"
    ;;
  _daemon)
    cmd_daemon
    ;;
  _daemon-supervised)
    cmd_daemon_supervised
    ;;
  status|--status)
    cmd_status
    ;;
  url|--url)
    cmd_url
    ;;
  stop|--stop)
    cmd_stop
    ;;
  restart|--restart)
    cmd_restart
    ;;
  _resolve)
    # Internal: one resolver surface for deploy/install.sh (design Decision 5).
    case "${2:-}" in
      bin) herdr_resolve_bin ;;
      tts-home) herdr_resolve_tts_home "$REPO_DIR" ;;
      port) herdr_resolve_port "$CONFIG_DIR" ;;
      root) printf '%s\n' "$REPO_DIR" ;;
      *)
        echo "Usage: bin/herdr-brain _resolve {bin|tts-home|port|root}" >&2
        exit 2
        ;;
    esac
    ;;
  _claim-port)
    # Single ownership policy shared with deploy/install.sh (audit C5).
    HERDR_BRAIN_PORT="$(herdr_resolve_port "$CONFIG_DIR")"
    export HERDR_BRAIN_PORT
    claim_port "${2:-daemon}"
    ;;
  help|--help|-h)
    echo "Usage: bin/herdr-brain [--no-first-run] [status|url|restart|stop|first-run|_daemon|_daemon-supervised]"
    ;;
  *)
    load_env
    ensure_venv
    exec "$REPO_DIR/.venv/bin/python" -m herdr_brain "$@"
    ;;
esac
