# A dotenv-style export from a legacy push panel, for the key import
# verb. The parser matches *_VAPID_PUBLIC / *_VAPID_PRIVATE /
# *_VAPID_SUBJECT generically so the operator never edits the source
# file; the prefix belongs to whatever wrote it.
OLDPANEL_VAPID_PUBLIC=BGD-1LolWp0xyWHrdMY1bWjASbiSO2H6bOZpYi5g8p-2eQP-EAi4vJmkGunpVii8ZPLxsgwtfp9Rd6PClNRGIpk
OLDPANEL_VAPID_PRIVATE=ya-p2EW6dRZrXCFXZ7HWk05Qw9s26JsSe4piKxIPZyE=
OLDPANEL_VAPID_SUBJECT=mailto:ops@legacy.example
