    "$(tt help.restart_daemon)"
    "$(tt help.restart_daemon2)"
    "$(tt help.restart_daemon3)"
    "$(tt help.dashboard)"
    "$(tt help.dashboard2)"
    "$(tt help.dashboard3)"
    "$(tt help.voice_palette)"
    "$(tt help.voice_palette2)"
    "$(tt help.voice_menu)"
    "$(tt help.voice_menu2)"
    "$(tt help.voice_menu3)"
    "$(tt help.voice_menu4)"
    "$(tt help.voice_settings)"
    "$(tt help.voice_settings2)"
    "$(tt help.voice_settings3)"
    "$(tt help.voice_settings4)"
    "$(tt help.voice_settings5)"
    "$(tt help.palette_preview)"
    "$(tt help.exit)"
    )
    printf '%s\n' "${_help_lines[@]}"
    ;;
  *)
    run_daemon
    ;;
esac
fi
