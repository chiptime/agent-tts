#!/usr/bin/env bash
# ╔═══════════════════════════════════════════════════════════╗
# ║  herdr-tts — Neural Text-To-Speech for Herdr agents       ║
# ║  Portable, parallel-chat safe, interruptible             ║
# ╚═══════════════════════════════════════════════════════════╝
set -euo pipefail

# Resolve plugin root portably (resolving symlinks if invoked via ~/bin)
REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${REAL_SCRIPT}")" && pwd)"
PLUGIN_ROOT="${HERDR_PLUGIN_ROOT:-$(cd "${SCRIPT_DIR}/.." && pwd)}"
# Canonical path for re-invocations spawned by children (fzf preview/binds,
# daemon_restart relaunch). The env override exists so tests can point the
# re-invocation at a recorder stub (same hermetic convention as CONFIG_FILE).
SCRIPT="${HERDR_TTS_SCRIPT:-${REAL_SCRIPT}}"

# Standard XDG paths
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/herdr-tts"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/herdr-tts"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-tts"
mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$STATE_DIR"

# Managed settings store (config.env). Env override keeps tests hermetic.
CONFIG_FILE="${HERDR_TTS_CONFIG_FILE:-${CONFIG_DIR}/config.env}"
AUTO_MUTE_FILE="${CONFIG_DIR}/auto_muted"
LOCK_FILE="/tmp/herdr-tts-playing.lock"
PID_FILE="/tmp/herdr-tts-current.pid"
IPC_SOCKET="/tmp/herdr-tts-player.sock"
# Lightweight gating state (snooze / mute / debounce timestamps). The default
# lives in /tmp; the env override exists so tests can run hermetically.
SNOOZE_STATE_FILE="${HERDR_TTS_SNOOZE_FILE:-/tmp/herdr-tts-snooze.json}"
# Append-only ledger of rendered audio (timestamp, pane, agent, duration)
# shown in the dashboard history tail; env override keeps tests hermetic.
HISTORY_FILE="${HERDR_TTS_HISTORY_FILE:-${STATE_DIR}/history.log}"
# Declarative, user-editable keymap (herdr-tts keymap init|check|emit|apply|adopt).
# Env override keeps tests hermetic.
KEYMAP_FILE="${HERDR_TTS_KEYMAP_FILE:-${CONFIG_DIR}/keymap.json}"

# Auto-bootstrap python environment if missing
VENV_PYTHON="${DATA_DIR}/venv/bin/python"
if [[ ! -x "$VENV_PYTHON" ]]; then
  "${PLUGIN_ROOT}/scripts/bootstrap.sh"
fi

ENGINE_SCRIPT="${PLUGIN_ROOT}/lib/tts_engine.py"

# Defaults
DEFAULT_PROVIDER="edge"
DEFAULT_VOICE="elvira"
DEFAULT_RATE="+20%"
DEFAULT_MAX_CHARS="0" # 0 = unlimited
DEFAULT_AUTO_SCOPE="focused" # "focused" = only speak active pane; "all" = speak any pane with mutex
DEFAULT_OPENAI_API_KEY=""
DEFAULT_OPENAI_BASE_URL="https://api.openai.com/v1"
DEFAULT_OPENAI_TTS_MODEL="tts-1"
DEFAULT_ELEVENLABS_API_KEY=""
DEFAULT_ELEVENLABS_MODEL="eleven_multilingual_v2"
DEFAULT_NTFY_TOPIC=""
DEFAULT_NTFY_SERVER="https://ntfy.sh"
DEFAULT_WEB_URL=""
DEFAULT_WEB_LABEL=""
DEFAULT_CLICK_REDIRECT="off"
DEFAULT_COLLIE_URL=""
DEFAULT_AUTO_LANG="off"
DEFAULT_PODCAST_ENABLED="off"
DEFAULT_PODCAST_PORT="8844"
DEFAULT_PIPER_MODEL=""
# Playback target for agent-tts: "local" (default), "winhost" (audio on the
# Windows host via agent-tts --winhost) or "wsl-ps" (PowerShell, zero install).
DEFAULT_TTS_PLAYBACK="local"
DEFAULT_DEBOUNCE_SECONDS="20" # anti-spam window per (pane, status); 0 disables
# Settle window: seconds a done must keep holding before the watcher fires
# the pipeline. Filters the working→done→working flickers of ONE logical
# turn (tool batches, subagents, thinking) that are NOT the end of the
# turn; only a done that survives the window reaches TTS + ntfy. 0 = off.
DEFAULT_SETTLE_SECONDS="5"
# Ambient pane-title glyphs (done/blocked ✔, mute 🔇, snooze 😴) synced on the
# daemon sweep; 0 = fully off (the sweep spawns nothing for titles).
DEFAULT_TTS_TITLE_GLYPHS="1"

notify_herdr() {
  local title="$1"
  local body="${2:-}"
  local sound="${3:-none}"
  herdr notification show "$title" --body "$body" --sound "$sound" 2>/dev/null || true
}

# Surface a captured TTS failure through the Herdr status popup.
# Usage: report_tts_error <context-label> <captured-stderr-file> <exit-code>
report_tts_error() {
  local context="$1"
  local err_file="$2"
  local ret="${3:-1}"
  cat "$err_file" >> /tmp/herdr-tts.log
  local raw_err
  raw_err=$(grep -iE "error|exception|fail|traceback" "$err_file" | tail -n 1)
  if [[ -z "$raw_err" ]]; then
    raw_err=$(tail -n 1 "$err_file")
  fi
  if [[ -z "$raw_err" ]]; then
    raw_err="Fallo de síntesis o reproducción (código ${ret})"
  fi
  local clean_err
  clean_err=$(echo "$raw_err" | sed -E 's/^[[:space:]]+//' | tr -d '\r\n' | cut -c1-80)
  notify_herdr "❌ Error en TTS (${context})" "$clean_err" "request"
}

# Load persisted settings if present
# Retention is HOT: the watcher re-reads it per event via
# audio_retention_days(), so a value that only came from config.env must
# NOT linger as a startup snapshot (it would shadow later file edits).
# Snapshot which retention keys were already set BEFORE the source
# (${var+x} is nounset-safe); after the source, keep only those — they
# are a real environment override (tests, user session) and outrank the
# file by design. File-sourced values get neutralized.
_had_herdr_ret=${HERDR_TTS_AUDIO_RETENTION_DAYS+x}
_had_agent_ret=${AGENT_TTS_AUDIO_RETENTION_DAYS+x}
_had_tts_ret=${TTS_AUDIO_RETENTION_DAYS+x}
if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
  [[ -n "$_had_herdr_ret" ]] || unset HERDR_TTS_AUDIO_RETENTION_DAYS
  [[ -n "$_had_agent_ret" ]] || unset AGENT_TTS_AUDIO_RETENTION_DAYS
  [[ -n "$_had_tts_ret" ]] || unset TTS_AUDIO_RETENTION_DAYS
fi
unset _had_herdr_ret _had_agent_ret _had_tts_ret

TTS_PROVIDER="${TTS_PROVIDER:-$DEFAULT_PROVIDER}"
TTS_VOICE="${TTS_VOICE:-$DEFAULT_VOICE}"
TTS_RATE="${TTS_RATE:-$DEFAULT_RATE}"
TTS_MAX_CHARS="${TTS_MAX_CHARS:-$DEFAULT_MAX_CHARS}"
TTS_AUTO_SCOPE="${TTS_AUTO_SCOPE:-$DEFAULT_AUTO_SCOPE}"
TTS_AUTO_LANG="${TTS_AUTO_LANG:-$DEFAULT_AUTO_LANG}"
TTS_PLAYBACK="${TTS_PLAYBACK:-$DEFAULT_TTS_PLAYBACK}"
PODCAST_ENABLED="${PODCAST_ENABLED:-$DEFAULT_PODCAST_ENABLED}"
PODCAST_PORT="${PODCAST_PORT:-$DEFAULT_PODCAST_PORT}"
TTS_DEBOUNCE_SECONDS="${TTS_DEBOUNCE_SECONDS:-$DEFAULT_DEBOUNCE_SECONDS}"
TTS_SETTLE_SECONDS="${TTS_SETTLE_SECONDS:-$DEFAULT_SETTLE_SECONDS}"
# Invalid hand-edited values fall back to the default instead of breaking sleep.
[[ "$TTS_SETTLE_SECONDS" =~ ^[0-9]+([.][0-9]+)?$ ]] || TTS_SETTLE_SECONDS="$DEFAULT_SETTLE_SECONDS"
TTS_TITLE_GLYPHS="${TTS_TITLE_GLYPHS:-$DEFAULT_TTS_TITLE_GLYPHS}"
OPENAI_API_KEY="${OPENAI_API_KEY:-$DEFAULT_OPENAI_API_KEY}"
OPENAI_BASE_URL="${OPENAI_BASE_URL:-$DEFAULT_OPENAI_BASE_URL}"
OPENAI_TTS_MODEL="${OPENAI_TTS_MODEL:-$DEFAULT_OPENAI_TTS_MODEL}"
ELEVENLABS_API_KEY="${ELEVENLABS_API_KEY:-$DEFAULT_ELEVENLABS_API_KEY}"
ELEVENLABS_MODEL="${ELEVENLABS_MODEL:-$DEFAULT_ELEVENLABS_MODEL}"
PIPER_MODEL="${PIPER_MODEL:-$DEFAULT_PIPER_MODEL}"
NTFY_TOPIC="${NTFY_TOPIC:-${HERDR_NTFY_TOPIC:-$DEFAULT_NTFY_TOPIC}}"
NTFY_SERVER="${NTFY_SERVER:-${HERDR_NTFY_SERVER:-$DEFAULT_NTFY_SERVER}}"
WEB_URL="${WEB_URL:-${COLLIE_URL:-${HERDR_WEB_URL:-${HERDR_COLLIE_URL:-$DEFAULT_WEB_URL}}}}"
WEB_LABEL="${WEB_LABEL:-${HERDR_WEB_LABEL:-$DEFAULT_WEB_LABEL}}"
CLICK_REDIRECT="${CLICK_REDIRECT:-$DEFAULT_CLICK_REDIRECT}"
# Backwards compatibility alias
COLLIE_URL="${WEB_URL}"

save_config() {
  cat > "$CONFIG_FILE" <<EOF
TTS_PROVIDER="${TTS_PROVIDER}"
TTS_VOICE="${TTS_VOICE}"
TTS_RATE="${TTS_RATE}"
TTS_MAX_CHARS="${TTS_MAX_CHARS}"
TTS_AUTO_SCOPE="${TTS_AUTO_SCOPE}"
TTS_AUTO_LANG="${TTS_AUTO_LANG}"
TTS_PLAYBACK="${TTS_PLAYBACK}"
PODCAST_ENABLED="${PODCAST_ENABLED}"
PODCAST_PORT="${PODCAST_PORT}"
TTS_DEBOUNCE_SECONDS="${TTS_DEBOUNCE_SECONDS}"
TTS_SETTLE_SECONDS="${TTS_SETTLE_SECONDS}"
TTS_TITLE_GLYPHS="${TTS_TITLE_GLYPHS}"
OPENAI_API_KEY="${OPENAI_API_KEY}"
OPENAI_BASE_URL="${OPENAI_BASE_URL}"
OPENAI_TTS_MODEL="${OPENAI_TTS_MODEL}"
ELEVENLABS_API_KEY="${ELEVENLABS_API_KEY}"
ELEVENLABS_MODEL="${ELEVENLABS_MODEL}"
PIPER_MODEL="${PIPER_MODEL}"
NTFY_TOPIC="${NTFY_TOPIC}"
NTFY_SERVER="${NTFY_SERVER}"
WEB_URL="${WEB_URL}"
WEB_LABEL="${WEB_LABEL}"
CLICK_REDIRECT="${CLICK_REDIRECT}"
COLLIE_URL="${WEB_URL}"
EOF
}

# ─── Managed config writer (settings popup) ──────────────────
# The settings popup persists exactly four knobs. This writer rewrites
# CONFIG_FILE preserving every unknown line and comment byte-for-byte:
# a managed `KEY="value"` line is upserted — the FIRST occurrence is
# replaced in place (exact KEY match, any value) and any duplicate is
# dropped, so repeats can never accumulate; only a truly absent key is
# added, inside the managed block when it exists or as a new small
# block appended at the end.
# Writes are atomic (tmp + mv) and the first write of the process keeps
# one ${CONFIG_FILE}.bak copy of the previous version. Fail-open: an
# unwritable location warns on stderr and returns 1 — never crashes.
# Values are always written quoted and rejected when they contain a
# double quote, so the file stays bash-sourceable (the block above
# sources it at startup).

CONFIG_SETTINGS_BLOCK_START='# >>> herdr-tts settings (managed by the settings popup) >>>'
CONFIG_SETTINGS_BLOCK_END='# <<< herdr-tts settings <<<'
CONFIG_SET_BACKED_UP=0

config_set() { # <KEY> <VALUE> → rc 1 on rejection or write failure (warning on stderr)
  local key="$1" value="$2"
  case "$key" in
    TTS_PROVIDER|TTS_PLAYBACK|HERDR_TTS_AUDIO_RETENTION_DAYS|TTS_SETTLE_SECONDS|WEB_URL|WEB_LABEL|CLICK_REDIRECT|COLLIE_URL) ;;
    *)
      echo "config_set: unmanaged key '${key}' (allowed: TTS_PROVIDER, TTS_PLAYBACK, HERDR_TTS_AUDIO_RETENTION_DAYS, TTS_SETTLE_SECONDS, WEB_URL, WEB_LABEL, CLICK_REDIRECT, COLLIE_URL)" >&2
      return 1
      ;;
  esac
  if [[ "$value" == *'"'* ]]; then
    echo "config_set: refused: value for '${key}' must not contain double quotes" >&2
    return 1
  fi

  local dir
  dir="$(dirname "$CONFIG_FILE")"
  if ! mkdir -p "$dir" 2>/dev/null || [[ ! -w "$dir" ]]; then
    echo "config_set: config directory is not writable: ${dir} (change skipped)" >&2
    return 1
  fi

  # One backup per invocation: snapshot the previous version only
  # before the first write of this process.
  if (( ! CONFIG_SET_BACKED_UP )) && [[ -f "$CONFIG_FILE" ]]; then
    cp -p "$CONFIG_FILE" "${CONFIG_FILE}.bak" 2>/dev/null || true
  fi
  CONFIG_SET_BACKED_UP=1

  local tmp="${CONFIG_FILE}.tmp.$$"
  local line replaced=0 in_block=0 write_rc=0
  {
    if [[ -f "$CONFIG_FILE" ]]; then
      while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" == "$CONFIG_SETTINGS_BLOCK_START" ]]; then
          in_block=1
        fi
        if [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?${key}= ]]; then
          # Upsert: the FIRST occurrence carries the new value; any
          # further occurrence is dropped so duplicates collapse to
          # exactly one line instead of growing on every write.
          if (( ! replaced )); then
            printf '%s="%s"\n' "$key" "$value"
            replaced=1
          fi
          continue
        fi
        # Absent key + our managed block closes here → add the line
        # right before the block end instead of a new block. Decided at
        # the END marker (not at the start one): at that point every key
        # line has already been seen, so an existing key is never
        # duplicated by the insert.
        if [[ "$line" == "$CONFIG_SETTINGS_BLOCK_END" ]] && (( in_block && ! replaced )); then
          printf '%s="%s"\n' "$key" "$value"
          replaced=1
        fi
        if [[ "$line" == "$CONFIG_SETTINGS_BLOCK_END" ]]; then
          in_block=0
        fi
        printf '%s\n' "$line"
      done < "$CONFIG_FILE"
    fi
    if (( ! replaced )); then
      if [[ -f "$CONFIG_FILE" && -s "$CONFIG_FILE" ]]; then
        printf '\n'
      fi
      printf '%s\n%s="%s"\n%s\n' \
        "$CONFIG_SETTINGS_BLOCK_START" "$key" "$value" "$CONFIG_SETTINGS_BLOCK_END"
    fi
  } > "$tmp" || write_rc=$?
  if (( write_rc != 0 )) || ! mv -f "$tmp" "$CONFIG_FILE" 2>/dev/null; then
    rm -f "$tmp" 2>/dev/null || true
    echo "config_set: failed to write ${CONFIG_FILE} (change skipped)" >&2
    return 1
  fi
  return 0
}

is_playing() {
  if [[ -f "$LOCK_FILE" ]]; then
    local pid
    pid=$(cat "$LOCK_FILE" 2>/dev/null || true)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi
  rm -f "$LOCK_FILE" "$PID_FILE"
  return 1
}

stop_audio() {
  local stopped=false

  if [[ -S "$IPC_SOCKET" ]]; then
    "$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd stop >/dev/null 2>&1 || true
    stopped=true
  fi

  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null || true)
    if [[ -n "$pid" ]]; then
      kill -TERM "$pid" 2>/dev/null || true
      stopped=true
    fi
  fi

  # Kill any orphan player processes playing temp wav
  if pkill -f "(paplay|afplay|mpv).*/tmp/.*\.wav" 2>/dev/null; then
    stopped=true
  fi

  rm -f "$LOCK_FILE" "$PID_FILE" "$IPC_SOCKET"

  if [[ "$stopped" == true ]]; then
    echo "⏹️ Audio detenido"
    notify_herdr "⏹️ Audio detenido" "Reproducción cancelada"
  fi
}

seek_audio() {
  local delta="$1"
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "seek ${delta}" 2>/dev/null || true)
  if [[ -z "$res" || "$res" == *"Error:"* ]]; then
    echo "⏹️ No hay audio reproduciéndose actualmente"
    return 1
  fi

  local pos total status
  pos=$(echo "$res" | grep -o 'pos=[0-9.]*' | cut -d= -f2)
  total=$(echo "$res" | grep -o 'total=[0-9.]*' | cut -d= -f2)
  status=$(echo "$res" | grep -o 'status=[a-z]*' | cut -d= -f2)

  local pos_int=${pos%.*}
  local total_int=${total%.*}
  [[ -z "$pos_int" ]] && pos_int=0
  [[ -z "$total_int" ]] && total_int=0

  local pos_m=$(( pos_int / 60 ))
  local pos_s=$(( pos_int % 60 ))
  local tot_m=$(( total_int / 60 ))
  local tot_s=$(( total_int % 60 ))
  local time_label
  time_label=$(printf "%d:%02d / %d:%02d" "$pos_m" "$pos_s" "$tot_m" "$tot_s")

  local sign="⏩ +"
  [[ "$delta" =~ ^- ]] && sign="⏪ "

  echo "${sign}${delta#+}s (${time_label})"
  notify_herdr "${sign}${delta#+}s" "Posición: ${time_label}"
}

next_sentence_audio() {
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "next-sentence" 2>/dev/null || true)
  if [[ -z "$res" || "$res" == *"Error:"* ]]; then
    echo "⏹️ No hay audio reproduciéndose actualmente"
    return 1
  fi

  local sentence
  sentence=$(echo "$res" | sed -n 's/.*sentence=//p')
  if [[ -z "$sentence" ]]; then
    sentence="Fin de la locución"
  fi

  echo "⏭️ Siguiente frase: ${sentence}"
  notify_herdr "⏭️ Siguiente frase" "${sentence}"
}

prev_sentence_audio() {
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "prev-sentence" 2>/dev/null || true)
  if [[ -z "$res" || "$res" == *"Error:"* ]]; then
    echo "⏹️ No hay audio reproduciéndose actualmente"
    return 1
  fi

  local sentence
  sentence=$(echo "$res" | sed -n 's/.*sentence=//p')
  if [[ -z "$sentence" ]]; then
    sentence="Inicio de la locución"
  fi

  echo "⏮️ Frase anterior: ${sentence}"
  notify_herdr "⏮️ Frase anterior" "${sentence}"
}

next_paragraph_audio() {
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "next-paragraph" 2>/dev/null || true)
  if [[ -z "$res" || "$res" == *"Error:"* ]]; then
    echo "⏹️ No hay audio reproduciéndose actualmente"
    return 1
  fi

  local paragraph
  paragraph=$(echo "$res" | sed -n 's/.*paragraph=//p')
  if [[ -z "$paragraph" ]]; then
    paragraph="Fin de la locución"
  fi

  echo "⏭️ Siguiente párrafo: ${paragraph}"
  notify_herdr "⏭️ Siguiente párrafo" "${paragraph}"
}

prev_paragraph_audio() {
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "prev-paragraph" 2>/dev/null || true)
  if [[ -z "$res" || "$res" == *"Error:"* ]]; then
    echo "⏹️ No hay audio reproduciéndose actualmente"
    return 1
  fi

  local paragraph
  paragraph=$(echo "$res" | sed -n 's/.*paragraph=//p')
  if [[ -z "$paragraph" ]]; then
    paragraph="Inicio de la locución"
  fi

  echo "⏮️ Párrafo anterior: ${paragraph}"
  notify_herdr "⏮️ Párrafo anterior" "${paragraph}"
}

toggle_pause_audio() {
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "toggle-pause" 2>/dev/null || true)
  if [[ -z "$res" || "$res" == *"Error:"* ]]; then
    echo "⏹️ No hay audio reproduciéndose actualmente"
    return 1
  fi

  local status pos total
  status=$(echo "$res" | grep -o 'status=[a-z]*' | cut -d= -f2)
  pos=$(echo "$res" | grep -o 'pos=[0-9.]*' | cut -d= -f2)
  total=$(echo "$res" | grep -o 'total=[0-9.]*' | cut -d= -f2)

  local pos_int=${pos%.*}
  local total_int=${total%.*}
  [[ -z "$pos_int" ]] && pos_int=0
  [[ -z "$total_int" ]] && total_int=0

  local pos_m=$(( pos_int / 60 ))
  local pos_s=$(( pos_int % 60 ))
  local tot_m=$(( total_int / 60 ))
  local tot_s=$(( total_int % 60 ))
  local time_label
  time_label=$(printf "%d:%02d / %d:%02d" "$pos_m" "$pos_s" "$tot_m" "$tot_s")

  if [[ "$status" == "paused" ]]; then
    echo "⏸️ Audio pausado (${time_label})"
    notify_herdr "⏸️ Audio pausado" "${time_label} (reanudable con prefix+p)"
  else
    echo "▶️ Audio reanudado (${time_label})"
    notify_herdr "▶️ Audio reanudado" "${time_label}"
  fi
}

pause_audio() {
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "status" 2>/dev/null || true)
  if [[ "$res" == *"status=playing"* ]]; then
    toggle_pause_audio
  elif [[ "$res" == *"status=paused"* ]]; then
    echo "⏸️ Audio ya está pausado"
  else
    echo "⏹️ No hay audio reproduciéndose actualmente"
  fi
}

resume_audio() {
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "resume" 2>/dev/null || true)
  if [[ -n "$res" && "$res" != *"Error:"* ]]; then
    echo "▶️ Audio reanudado"
    notify_herdr "▶️ Audio reanudado" ""
  else
    echo "⏹️ No hay audio reproduciéndose actualmente"
  fi
}

get_player_status() {
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "status" 2>/dev/null || true)
  if [[ -z "$res" || "$res" == *"Error:"* ]]; then
    echo "⏹️ En reposo (sin reproducción activa)"
    return 0
  fi
  local status pos total
  status=$(echo "$res" | grep -o 'status=[a-z]*' | cut -d= -f2)
  pos=$(echo "$res" | grep -o 'pos=[0-9.]*' | cut -d= -f2)
  total=$(echo "$res" | grep -o 'total=[0-9.]*' | cut -d= -f2)
  local sent
  sent=$(echo "$res" | sed -n 's/.*sentence=//p')

  if [[ "$status" == "synthesizing" ]]; then
    echo "⏳ Estado: sintetizando respuesta de voz..."
    return 0
  fi

  local pos_int=${pos%.*}
  local total_int=${total%.*}
  [[ -z "$pos_int" ]] && pos_int=0
  [[ -z "$total_int" ]] && total_int=0

  local pos_m=$(( pos_int / 60 ))
  local pos_s=$(( pos_int % 60 ))
  local tot_m=$(( total_int / 60 ))
  local tot_s=$(( total_int % 60 ))
  local time_label
  time_label=$(printf "%d:%02d / %d:%02d" "$pos_m" "$pos_s" "$tot_m" "$tot_s")

  local icon="🔊"
  [[ "$status" == "paused" ]] && icon="⏸️"
  if [[ -n "$sent" ]]; then
    echo "${icon} Estado: ${status} (${time_label}) | Frase: \"${sent}\""
  else
    echo "${icon} Estado: ${status} (${time_label})"
  fi
}

adjust_rate() {
  local step="$1" # +10 or -10
  local current_num
  current_num=$(echo "${TTS_RATE}" | tr -d '+%' | grep -o '[-0-9]*' || echo "20")
  [[ -z "$current_num" ]] && current_num=20
  local new_num=$(( current_num + step ))
  (( new_num > 100 )) && new_num=100
  (( new_num < -50 )) && new_num=-50
  if (( new_num >= 0 )); then
    TTS_RATE="+${new_num}%"
  else
    TTS_RATE="${new_num}%"
  fi
  save_config
  echo "✓ Velocidad ajustada: ${TTS_RATE}"
  notify_herdr "⚡ Velocidad de voz" "${TTS_RATE}"
}

build_provider_flags() {
  PROVIDER_FLAGS=(--provider "${TTS_PROVIDER:-edge}")
  [[ -n "${OPENAI_API_KEY:-}" ]] && PROVIDER_FLAGS+=(--openai-key "$OPENAI_API_KEY")
  [[ -n "${OPENAI_BASE_URL:-}" ]] && PROVIDER_FLAGS+=(--openai-base-url "$OPENAI_BASE_URL")
  [[ -n "${OPENAI_TTS_MODEL:-}" ]] && PROVIDER_FLAGS+=(--openai-model "$OPENAI_TTS_MODEL")
  local el_key="${ELEVENLABS_API_KEY:-${ELEVENLABS_KEY:-}}"
  [[ -n "$el_key" ]] && PROVIDER_FLAGS+=(--eleven-key "$el_key")
  [[ -n "${ELEVENLABS_MODEL:-}" ]] && PROVIDER_FLAGS+=(--eleven-model "$ELEVENLABS_MODEL")
  [[ -n "${PIPER_MODEL:-}" ]] && PROVIDER_FLAGS+=(--piper-model "$PIPER_MODEL")
  if [[ "${TTS_AUTO_LANG:-off}" == "on" || "${TTS_AUTO_LANG:-off}" == "true" || "${TTS_AUTO_LANG:-off}" == "1" ]]; then
    PROVIDER_FLAGS+=(--auto-lang)
  fi
  # Optional playback target: forward to the engine only when not local
  # (default behavior unchanged otherwise).
  if [[ -n "${TTS_PLAYBACK:-}" && "${TTS_PLAYBACK}" != "local" ]]; then
    PROVIDER_FLAGS+=(--playback "${TTS_PLAYBACK}")
  fi
}

speak_text() {
  local text="$1"
  local voice="${2:-$TTS_VOICE}"
  local rate="${3:-$TTS_RATE}"
  local tldr_flag="${4:-}"
  local target_pane="${5:-}"
  local agent_kind="${6:-}"
  local session_id="${7:-}"

  # Stop any currently playing audio first (new request takes priority)
  stop_audio

  build_provider_flags

  local -a extra_flags=()
  if [[ "$tldr_flag" == "--tldr" || "$tldr_flag" == "tldr" ]]; then
    extra_flags+=(--tldr)
  fi

  # Agent Transcript Connectors (Vision B): the engine owns transcript
  # knowledge; this host only hands over the agent identity + session id.
  # Empty values (agy/shell panes) are omitted -> scrollback fallback.
  [[ -n "$agent_kind" ]] && extra_flags+=(--agent "$agent_kind")
  [[ -n "$session_id" ]] && extra_flags+=(--session-id "$session_id")

  local err_tmp
  err_tmp=$(mktemp "/tmp/herdr-tts-err.XXXXXX")

  # Launch audio synthesis asynchronously in background and catch any runtime/synthesis errors
  (
    set +e
    "$VENV_PYTHON" "$ENGINE_SCRIPT" "$text" --voice "$voice" --rate "$rate" --max-chars "$TTS_MAX_CHARS" "${extra_flags[@]}" "${PROVIDER_FLAGS[@]}" > "$err_tmp" 2>&1
    local ret=$?
    if [[ $ret -ne 0 ]]; then
      report_tts_error "${target_pane:-Herdr}" "$err_tmp" "$ret"
    fi
    rm -f "$err_tmp"
  ) &
  local child_pid=$!
  echo "$child_pid" > "$PID_FILE"
  echo "$child_pid" > "$LOCK_FILE"
}

play_audio_file() {
  local file="$1"
  # Cheap guard: palette ctrl-r on a "-" placeholder or a deleted stored
  # path must fail gracefully instead of spawning a doomed engine run.
  if [[ ! -s "$file" ]]; then
    echo "⚠️ Nada que reproducir: el audio no existe o está vacío" >&2
    return 1
  fi
  stop_audio
  local err_tmp
  err_tmp=$(mktemp "/tmp/herdr-tts-play-err.XXXXXX")
  # Playback errors must surface through the status popup, not only the log
  (
    set +e
    "$VENV_PYTHON" "$ENGINE_SCRIPT" --play-file "$file" > "$err_tmp" 2>&1
    local ret=$?
    if [[ $ret -ne 0 ]]; then
      report_tts_error "reproducción local" "$err_tmp" "$ret"
    fi
    rm -f "$err_tmp"
  ) &
  local child_pid=$!
  echo "$child_pid" > "$PID_FILE"
  echo "$child_pid" > "$LOCK_FILE"
}

send_ntfy_push() {
  local pane_id="$1"
  local agent="$2"
  local state="$3"
  local workspace="${4:-}"
  local title_desc="${5:-}"
  local audio_path="${6:-}"

  [[ -z "$NTFY_TOPIC" ]] && return 0

  local ntfy_url="${NTFY_SERVER}/${NTFY_TOPIC}"
  local focus_cmd="herdr agent focus ${pane_id}"
  local display_name="${agent} (${pane_id})"
  if [[ -n "$title_desc" && "$title_desc" != "$agent" ]]; then
    display_name="${agent} [${title_desc}] (${pane_id})"
  fi

  local action_buttons=""
  local target_url=""

  if [[ -n "$WEB_URL" ]]; then
    if [[ "$WEB_URL" == *"{pane_id}"* ]]; then
      target_url="${WEB_URL//\{pane_id\}/${pane_id}}"
    elif [[ -n "$pane_id" ]]; then
      target_url="${WEB_URL%/}/pane/${pane_id}"
    else
      target_url="${WEB_URL}"
    fi

    local btn_label="Abrir Web"
    if [[ -n "$WEB_LABEL" ]]; then
      btn_label="Abrir ${WEB_LABEL}"
    elif [[ "${WEB_URL,,}" =~ collie ]]; then
      btn_label="Abrir Collie"
    fi

    action_buttons="view, 📱 ${btn_label}, ${target_url}; copy, 📋 Copiar comando, ${focus_cmd}, clear=true"
  else
    action_buttons="copy, 📋 Copiar comando, ${focus_cmd}, clear=true"
  fi

  local title=""
  local body=""
  local priority="default"
  local tags="robot"

  case "$state" in
    done)
      title="✅ ${display_name} terminó"
      body="Agente ${display_name}${workspace:+ en ${workspace}} finalizó su tarea.\n\n→ Para ver: ${focus_cmd}"
      priority="default"
      tags="white_check_mark,robot"
      [[ -n "$audio_path" && -s "$audio_path" ]] && tags="white_check_mark,robot,loudspeaker"
      ;;
    blocked)
      title="🔴 ${display_name} necesita atención"
      body="Agente ${display_name}${workspace:+ en ${workspace}} está bloqueado y espera input.\n\n→ Para ver: ${focus_cmd}"
      priority="high"
      tags="rotating_light,warning"
      [[ -n "$audio_path" && -s "$audio_path" ]] && tags="rotating_light,warning,loudspeaker"
      ;;
    idle)
      title="💤 ${display_name} idle"
      body="Agente ${display_name}${workspace:+ en ${workspace}} pasó a idle."
      priority="low"
      tags="zzz"
      ;;
    *)
      return 0
      ;;
  esac

  local -a headers=(
    -H "Title: ${title}"
    -H "Priority: ${priority}"
    -H "Tags: ${tags}"
  )
  if [[ -n "$target_url" && "$CLICK_REDIRECT" == "on" ]]; then
    headers+=(-H "Click: ${target_url}")
  fi
  if [[ -n "$action_buttons" ]]; then
    headers+=(-H "Actions: ${action_buttons}")
  fi

  if [[ -n "$audio_path" && -f "$audio_path" && -s "$audio_path" ]]; then
    local safe_body="${body//$'\n'/ · }"
    local audio_bytes
    audio_bytes=$(stat -c%s "$audio_path" 2>/dev/null || echo "unknown")
    headers+=(
      -H "Message: ${safe_body}"
      -H "Filename: ${pane_id//:/_}-response.mp3"
    )
    echo "[$(date +%H:%M:%S)] [ntfy] 📤 Enviando push con audio (${audio_bytes} bytes) para ${pane_id} a ${NTFY_TOPIC}"
    curl -s --connect-timeout 5 --max-time 30 "${headers[@]}" -T "${audio_path}" "${ntfy_url}" > /dev/null 2>&1 || true
  else
    echo "[$(date +%H:%M:%S)] [ntfy] 📤 Enviando push de texto para ${pane_id} a ${NTFY_TOPIC}"
    curl -s --connect-timeout 5 --max-time 15 "${headers[@]}" -d "${body}" "${ntfy_url}" > /dev/null 2>&1 || true
  fi
}

get_focused_pane() {
  local pane
  # 1. Check Herdr API snapshot focused_pane_id
  pane=$(herdr api snapshot 2>/dev/null | jq -r '.result.snapshot.focused_pane_id // empty' 2>/dev/null || true)
  if [[ -n "$pane" ]]; then
    echo "$pane"
    return 0
  fi

  # 2. Check herdr pane current helper
  pane=$(herdr pane current 2>/dev/null | jq -r '.result.pane.pane_id // empty' 2>/dev/null || true)
  if [[ -n "$pane" ]]; then
    echo "$pane"
    return 0
  fi

  # 3. Check snapshot for focused == true
  pane=$(herdr api snapshot 2>/dev/null | jq -r '(.result.snapshot.panes[]? | select(.focused == true) | .pane_id) // empty' 2>/dev/null | head -n 1 || true)
  if [[ -n "$pane" ]]; then
    echo "$pane"
    return 0
  fi

  # 4. Fallback to env
  echo "${HERDR_PANE_ID:-${HERDR_PANE:-}}"
}

read_pane_text() {
  local target_pane="$1"
  local raw=""

  # 1. Prefer herdr pane read (works for ANY pane: agents, OpenCode, Claude, shells)
  raw=$(herdr pane read "$target_pane" --lines 300 --format text 2>/dev/null || true)

  # 2. Fallback to herdr agent read if pane read was empty
  if [[ -z "$raw" || "$raw" =~ ^[[:space:]]*$ ]]; then
    raw=$(herdr agent read "$target_pane" --lines 300 --format text 2>/dev/null || true)
  fi

  # If output is JSON wrapped, extract result.text
  if [[ "$raw" =~ ^[[:space:]]*\{.*"result" ]]; then
    local parsed
    parsed=$(echo "$raw" | jq -r '.result.text // .result // empty' 2>/dev/null || true)
    if [[ -n "$parsed" ]]; then
      echo "$parsed"
      return 0
    fi
  fi
  echo "$raw"
}

# Structured transcript knowledge lives in the ENGINE (agent-tts): this host
# only forwards the agent identity + session id via --agent/--session-id, and
# agent-tts resolves the last assistant message with its connector layer
# (OpenCode SQLite, Claude Code JSONL) or falls back to scrollback itself.

publish_podcast_episode() {
  local title="$1"
  local description="$2"
  local audio_file="$3"

  local pod_dir="${DATA_DIR}/podcast"
  mkdir -p "$pod_dir"
  "$VENV_PYTHON" -c "
import sys
from agent_tts.podcast import PodcastFeed
with open('$audio_file', 'rb') as f:
    data = f.read()
feed = PodcastFeed(base_dir='$pod_dir', base_url='http://localhost:${PODCAST_PORT}')
feed.add_episode(data, title='''$title''', description='''$description''')
" 2>/dev/null || true
  echo "[$(date +%H:%M:%S)] 🎙️ Episodio publicado en el feed privado de podcast"
}

publish_current_pane_podcast() {
  local target_pane
  target_pane=$(get_focused_pane)
  if [[ -z "$target_pane" ]]; then
    echo "⚠️ No hay ningún pane enfocado en Herdr" >&2
    return 1
  fi
  local text
  text=$(read_pane_text "$target_pane")
  if [[ -z "$text" || "$text" =~ ^[[:space:]]*$ ]]; then
    echo "ℹ️ El pane ${target_pane} no tiene contenido para publicar"
    return 0
  fi
  local tmp_audio="/tmp/herdr-tts-pod-${target_pane//:/_}-$RANDOM.mp3"
  echo "🎙️ Generando audio y publicando episodio en el feed de podcast..."
  render_text_audio "$tmp_audio" "$text" >/dev/null 2>&1 || true
  if [[ -s "$tmp_audio" ]]; then
    publish_podcast_episode "Actualización en ${target_pane}" "$text" "$tmp_audio"
    notify_herdr "🎙️ Podcast RSS" "Nuevo episodio publicado"
    echo "✓ Episodio publicado con éxito. RSS: http://localhost:${PODCAST_PORT}/podcast.xml"
    rm -f "$tmp_audio"
  else
    echo "Error: Falló la síntesis de audio" >&2
  fi
}

read_current_pane() {
  local target_pane="${1:-}"
  local tldr_flag="${2:-}"
  if [[ -z "$target_pane" ]]; then
    target_pane=$(get_focused_pane)
  fi

  if [[ -z "$target_pane" ]]; then
    echo "⚠️ No hay ningún pane enfocado en Herdr" >&2
    notify_herdr "⚠️ Herdr Voice" "No hay ningún pane enfocado"
    return 1
  fi

  local text
  text=$(read_pane_text "$target_pane")

  if [[ -z "$text" || "$text" =~ ^[[:space:]]*$ ]]; then
    echo "ℹ️ El pane ${target_pane} no tiene contenido para leer"
    notify_herdr "ℹ️ Herdr Voice" "El pane ${target_pane} no tiene contenido para leer"
    return 0
  fi

  # Agent identity for the connector layer: the engine (agent-tts) resolves
  # the transcript itself from these two ids; agy/shell panes yield empty
  # values and keep the scrollback path with turn extraction.
  local agent_kind=""
  local session_id=""
  local agent_info
  agent_info=$(herdr agent get "$target_pane" 2>/dev/null) || true
  if [[ -n "$agent_info" ]]; then
    agent_kind=$(echo "$agent_info" | jq -r '.result.agent.agent_session.agent // empty' 2>/dev/null || true)
    session_id=$(echo "$agent_info" | jq -r '.result.agent.agent_session.value // empty' 2>/dev/null || true)
  fi

  if [[ "$tldr_flag" == "--tldr" || "$tldr_flag" == "tldr" ]]; then
    echo "▶️ Resumiendo (TL;DR) y leyendo respuesta en ${target_pane}..."
    notify_herdr "Resumen TL;DR" "Sintetizando resumen para ${target_pane}..."
    speak_text "$text" "$TTS_VOICE" "$TTS_RATE" "--tldr" "$target_pane" "$agent_kind" "$session_id"
  else
    echo "▶️ Transcribiendo y leyendo respuesta en ${target_pane}..."
    notify_herdr "Transcribiendo respuesta" "Sintetizando voz para ${target_pane}..."
    speak_text "$text" "$TTS_VOICE" "$TTS_RATE" "" "$target_pane" "$agent_kind" "$session_id"
  fi
}

read_current_pane_visual() {
  local -a visual_flags=()
  local target_pane=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --highlight|-H) visual_flags+=(--highlight); shift ;;
      --autoscroll) visual_flags+=(--autoscroll); shift ;;
      --bionic) visual_flags+=(--bionic); shift ;;
      --zen) visual_flags+=(--zen); shift ;;
      --tldr|--summarize) visual_flags+=(--tldr); shift ;;
      *)
        if [[ -z "$target_pane" && "$1" != -* ]]; then
          target_pane="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$target_pane" ]]; then
    target_pane=$(get_focused_pane)
  fi

  if [[ -z "$target_pane" ]]; then
    echo "⚠️ No hay ningún pane enfocado en Herdr" >&2
    notify_herdr "⚠️ Herdr Voice" "No hay ningún pane enfocado"
    return 1
  fi

  local text
  text=$(read_pane_text "$target_pane")

  if [[ -z "$text" || "$text" =~ ^[[:space:]]*$ ]]; then
    echo "ℹ️ El pane ${target_pane} no tiene contenido para leer"
    notify_herdr "ℹ️ Herdr Voice" "El pane ${target_pane} no tiene contenido para leer"
    return 0
  fi

  # Agent identity for the connector layer (see read_current_pane): the
  # engine resolves the transcript from these ids; scrollback text is the
  # fallback the engine applies itself when no connector matches.
  local agent_kind=""
  local session_id=""
  local agent_info
  agent_info=$(herdr agent get "$target_pane" 2>/dev/null) || true
  if [[ -n "$agent_info" ]]; then
    agent_kind=$(echo "$agent_info" | jq -r '.result.agent.agent_session.agent // empty' 2>/dev/null || true)
    session_id=$(echo "$agent_info" | jq -r '.result.agent.agent_session.value // empty' 2>/dev/null || true)
  fi

  local -a source_flags=()
  [[ -n "$agent_kind" ]] && source_flags+=(--agent "$agent_kind")
  [[ -n "$session_id" ]] && source_flags+=(--session-id "$session_id")

  stop_audio
  build_provider_flags

  echo "▶️ Iniciando lectura sincronizada en ${target_pane}..."
  if ! "$VENV_PYTHON" "$ENGINE_SCRIPT" "$text" --voice "$TTS_VOICE" --rate "$TTS_RATE" --max-chars "$TTS_MAX_CHARS" "${visual_flags[@]}" "${source_flags[@]}" "${PROVIDER_FLAGS[@]}"; then
    notify_herdr "❌ Error en TTS (${target_pane})" "Fallo en reproducción o lectura visual" "request"
  fi
}

render_pane_audio() {
  local target_pane="${1:-}"
  local output_file="${2:-}"

  if [[ -z "$target_pane" ]]; then
    target_pane=$(get_focused_pane)
  fi

  if [[ -z "$target_pane" || -z "$output_file" ]]; then
    echo "Uso: herdr-tts --render-pane <pane_id> <output_file.mp3>" >&2
    return 1
  fi

  local text
  text=$(read_pane_text "$target_pane")
  if [[ -z "$text" || "$text" =~ ^[[:space:]]*$ ]]; then
    return 1
  fi

  build_provider_flags
  if "$VENV_PYTHON" "$ENGINE_SCRIPT" "$text" --voice "$TTS_VOICE" --rate "$TTS_RATE" --max-chars "$TTS_MAX_CHARS" --output "$output_file" --no-play "${PROVIDER_FLAGS[@]}"; then
    # Audio ledger for the dashboard history (best effort; no agent context
    # here). The 5th field carries the first ~120 chars of the spoken text.
    local hist_snippet
    history_snippet hist_snippet "$text"
    append_audio_history "$target_pane" "-" "$(audio_duration_secs "$output_file")" "$hist_snippet"
    return 0
  fi
  return 1
}

render_text_audio() {
  local output_file="${1:-}"
  shift || true
  local -a source_flags=()
  local -a text_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent)
        source_flags+=(--agent "${2:-}")
        { [[ $# -ge 2 ]] && shift 2; } || shift
        ;;
      --session-id)
        source_flags+=(--session-id "${2:-}")
        { [[ $# -ge 2 ]] && shift 2; } || shift
        ;;
      *)
        text_args+=("$1")
        shift
        ;;
    esac
  done
  local text="${text_args[*]:-}"

  if [[ -z "$output_file" ]]; then
    echo "Uso: herdr-tts --render-text <output_file.mp3> [texto...] [--agent <tipo>] [--session-id <id>]" >&2
    return 1
  fi

  if [[ -z "$text" && ! -t 0 ]]; then
    text=$(cat)
  fi

  if [[ -z "$text" ]]; then
    return 1
  fi

  build_provider_flags
  "$VENV_PYTHON" "$ENGINE_SCRIPT" "$text" --voice "$TTS_VOICE" --rate "$TTS_RATE" --max-chars "$TTS_MAX_CHARS" --output "$output_file" --no-play "${source_flags[@]}" "${PROVIDER_FLAGS[@]}"
}

toggle_play() {
  local target_pane=""
  local tldr_flag=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --tldr|tldr)
        tldr_flag="--tldr"
        shift
        ;;
      *)
        if [[ -z "$target_pane" ]]; then
          target_pane="$1"
        fi
        shift
        ;;
    esac
  done

  if is_playing; then
    stop_audio
  else
    read_current_pane "$target_pane" "$tldr_flag"
  fi
}

is_auto_muted() {
  [[ -f "$AUTO_MUTE_FILE" ]]
}

toggle_auto() {
  if is_auto_muted; then
    rm -f "$AUTO_MUTE_FILE"
    echo "🔊 Lectura automática de fondo activada"
    notify_herdr "🔊 Herdr Voice" "Lectura automática activada"
    speak_text "Lectura automática activada."
  else
    touch "$AUTO_MUTE_FILE"
    echo "🔇 Lectura automática de fondo silenciada"
    notify_herdr "🔇 Herdr Voice" "Lectura automática silenciada (solo manual)"
    speak_text "Lectura automática silenciada."
  fi
}

show_status() {
  echo "━━━ Herdr TTS Status ━━━"
  local p_status
  p_status=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "status" 2>/dev/null || true)
  if [[ -n "$p_status" && "$p_status" != *"Error:"* ]]; then
    local status pos total
    status=$(echo "$p_status" | grep -o 'status=[a-z]*' | cut -d= -f2)
    pos=$(echo "$p_status" | grep -o 'pos=[0-9.]*' | cut -d= -f2)
    total=$(echo "$p_status" | grep -o 'total=[0-9.]*' | cut -d= -f2)
    local pos_int=${pos%.*}
    local total_int=${total%.*}
    local pos_m=$(( ${pos_int:-0} / 60 ))
    local pos_s=$(( ${pos_int:-0} % 60 ))
    local tot_m=$(( ${total_int:-0} / 60 ))
    local tot_s=$(( ${total_int:-0} % 60 ))
    local time_label
    time_label=$(printf "%d:%02d / %d:%02d" "$pos_m" "$pos_s" "$tot_m" "$tot_s")
    if [[ "$status" == "synthesizing" ]]; then
      echo "  Reproducción: ⏳ Sintetizando respuesta de voz (Lock activo)"
    elif [[ "$status" == "paused" ]]; then
      echo "  Reproducción: ⏸️ Pausado en ${time_label} (Lock activo)"
    else
      echo "  Reproducción: 🔊 Hablando en ${time_label} (Lock activo)"
    fi
  elif is_playing; then
    echo "  Reproducción: 🔊 Hablando ahora (Lock activo)"
  else
    echo "  Reproducción: ⏹️ En reposo"
  fi

  if is_auto_muted; then
    echo "  Auto-lectura: 🔇 Silenciada en PC (Solo manual vía prefix+r)"
  else
    echo "  Auto-lectura: 🔊 Activa en altavoces del PC"
  fi

  # Snooze / mute / debounce gating state
  local gate_state g_until muted_list
  gate_state=$(load_snooze_state)
  g_until=$(jq -r '(.global_snooze_until // 0)' <<<"$gate_state")
  if (( g_until > $(date +%s) )); then
    echo "  Snooze global: 😴 activo hasta las $(fmt_epoch_clock "$g_until") (prefix+Z cicla 5m → 30m → 2h → off)"
  else
    echo "  Snooze global: ⚪ Desactivado (prefix+Z cicla 5m → 30m → 2h → off)"
  fi
  muted_list=$(jq -r '[.panes // {} | to_entries[] | select(.value.muted == true) | .key] | join(", ")' <<<"$gate_state")
  echo "  Panes silenciados: ${muted_list:-ninguno} (prefix+m, se reactivan al cerrarse el pane)"
  echo "  Debounce anti-spam: ${TTS_DEBOUNCE_SECONDS}s por (pane, estado) — TTS_DEBOUNCE_SECONDS / --debounce"

  echo "  Alcance auto: ${TTS_AUTO_SCOPE} (focused = solo chat activo; all = cualquiera sin solaparse)"
  echo "  Proveedor:    ${TTS_PROVIDER} (edge = Edge Neural TTS gratuito; openai = OpenAI TTS; elevenlabs = ElevenLabs; piper = 100% Offline Local Neural)"
  local ret_raw
  config_get_retention_raw ret_raw
  if [[ "$ret_raw" =~ ^[1-9][0-9]*$ ]] && (( ret_raw > 0 )); then
    echo "  Audio retenido: ${ret_raw} días (${ret_raw}) — HERDR_TTS_AUDIO_RETENTION_DAYS"
  elif [[ -n "$ret_raw" ]]; then
    echo "  Audio retenido: apagado (${ret_raw}) — HERDR_TTS_AUDIO_RETENTION_DAYS"
  else
    echo "  Audio retenido: apagado (no definido) — HERDR_TTS_AUDIO_RETENTION_DAYS"
  fi
  # Daemon liveness: pidfile + /proc check (PID-reuse guarded, same as takeover).
  local d_pid
  d_pid=$(daemon_pid)
  if [[ -n "$d_pid" ]]; then
    echo "  Daemon TTS: vivo (pid ${d_pid})"
  else
    echo "  Daemon TTS: no corriendo (arranca con el plugin o --restart-daemon)"
  fi
  if [[ "$TTS_PROVIDER" == "openai" ]]; then
    local masked_key="no configurada"
    if [[ -n "$OPENAI_API_KEY" ]]; then
      masked_key="${OPENAI_API_KEY:0:7}...${OPENAI_API_KEY: -4}"
    fi
    echo "  OpenAI TTS:   Modelo: ${OPENAI_TTS_MODEL} | Base URL: ${OPENAI_BASE_URL} | API Key: ${masked_key}"
  elif [[ "$TTS_PROVIDER" =~ ^eleven ]]; then
    local masked_key="no configurada"
    if [[ -n "$ELEVENLABS_API_KEY" ]]; then
      masked_key="${ELEVENLABS_API_KEY:0:5}...${ELEVENLABS_API_KEY: -4}"
    fi
    echo "  ElevenLabs:   Modelo: ${ELEVENLABS_MODEL} | API Key: ${masked_key}"
  elif [[ "$TTS_PROVIDER" == "piper" || "$TTS_PROVIDER" == "local" ]]; then
    echo "  Piper Local:  Modelo ONNX: ${PIPER_MODEL:-'(voz por defecto / PATH)'}"
  fi
  echo "  Voz:          ${TTS_VOICE}"
  echo "  Velocidad:    ${TTS_RATE}"
  echo "  Max chars:    ${TTS_MAX_CHARS}"
  echo "  Idioma auto:  ${TTS_AUTO_LANG} (detección automática y cambio de voz entre ES y EN)"
  if [[ "$PODCAST_ENABLED" == "on" ]]; then
    echo "  Podcast RSS:  🔔 Activo (http://localhost:${PODCAST_PORT}/podcast.xml | Servidor: --podcast-serve)"
  else
    echo "  Podcast RSS:  ⚪ Desactivado (opcional vía --podcast on | servidor vía --podcast-serve)"
  fi

  if [[ -n "$NTFY_TOPIC" ]]; then
    echo "  Push móvil:   🔔 Activo (ntfy: ${NTFY_TOPIC} | Servidor: ${NTFY_SERVER})"
  else
    echo "  Push móvil:   ⚪ Desactivado (opcional vía --ntfy-topic <topic>)"
  fi
  if [[ -n "$WEB_URL" ]]; then
    local label="${WEB_LABEL:-}"
    if [[ -z "$label" ]]; then
      [[ "${WEB_URL,,}" =~ collie ]] && label="Collie" || label="Web"
    fi
    echo "  Redirección:  📱 ${label} (${WEB_URL})"
    echo "  Click directo: ${CLICK_REDIRECT} (on = abrir web al tocar notificación; off = abrir reproductor de audio)"
  else
    echo "  Redirección:  ⚪ Desactivada (opcional vía --web-url <url> o --collie-url <url>)"
  fi

  echo "  Plugin root:  ${PLUGIN_ROOT}"
  echo "  Config:       ${CONFIG_FILE}"
}

# ─── Snooze / Mute / Debounce gating (pre-engine) ────────────
# Lightweight timestamp state shared by all watchers and CLI toggles.
# Writes are atomic (temp file + mv in the same directory); reads fail
# open: a missing or corrupt file is treated as "no snooze, no mute"
# so speech never breaks because of leftover state.

SNOOZE_STAGE_SECONDS=(300 1800 7200) # 5m → 30m → 2h
SNOOZE_STAGE_LABELS=("5 minutos" "30 minutos" "2 horas")

fmt_epoch_clock() {
  local epoch="$1"
  date -d "@${epoch}" +%H:%M 2>/dev/null || date -r "$epoch" +%H:%M 2>/dev/null || echo "??:??"
}

load_snooze_state() {
  if [[ -s "$SNOOZE_STATE_FILE" ]]; then
    jq -c . "$SNOOZE_STATE_FILE" 2>/dev/null || echo '{}'
  else
    echo '{}'
  fi
}

save_snooze_state() {
  local json="$1"
  local tmp
  tmp=$(mktemp "${SNOOZE_STATE_FILE}.XXXXXX") 2>/dev/null || return 1
  printf '%s' "$json" > "$tmp" && mv -f "$tmp" "$SNOOZE_STATE_FILE"
}

# Cycle snooze for the focused pane (scope=pane) or for all agents
# (scope=global): 5m → 30m → 2h → off. Announces the new state. An
# explicit pane id (used by the dashboard cursor) wins over focus.
cycle_snooze() {
  local scope="${1:-pane}" # pane | global
  local target_pane="${2:-}"

  if [[ "$scope" == "pane" ]]; then
    if [[ -z "$target_pane" ]]; then
      target_pane=$(get_focused_pane)
    fi
    if [[ -z "$target_pane" ]]; then
      echo "⚠️ No hay ningún pane enfocado en Herdr" >&2
      notify_herdr "⚠️ Herdr Voice" "No hay ningún pane enfocado"
      return 1
    fi
  fi

  local now state stage until_ts new_stage new_until msg
  now=$(date +%s)
  state=$(load_snooze_state)

  if [[ "$scope" == "pane" ]]; then
    stage=$(jq -r --arg p "$target_pane" '(.panes[$p].snooze_stage // 0)' <<<"$state")
    until_ts=$(jq -r --arg p "$target_pane" '(.panes[$p].snooze_until // 0)' <<<"$state")
  else
    stage=$(jq -r '(.global_snooze_stage // 0)' <<<"$state")
    until_ts=$(jq -r '(.global_snooze_until // 0)' <<<"$state")
  fi

  # An expired snooze counts as off for the cycle
  (( until_ts <= now )) && stage=0

  new_stage=$(( stage + 1 ))
  if (( new_stage > ${#SNOOZE_STAGE_SECONDS[@]} )); then
    new_stage=0
  fi

  if (( new_stage > 0 )); then
    new_until=$(( now + SNOOZE_STAGE_SECONDS[new_stage - 1] ))
    local label="${SNOOZE_STAGE_LABELS[new_stage - 1]}"
    local clock
    clock=$(fmt_epoch_clock "$new_until")
    if [[ "$scope" == "pane" ]]; then
      msg="😴 Snooze ${target_pane}: ${label} (sin voz hasta las ${clock})"
    else
      msg="😴 Snooze GLOBAL: ${label} (todos los agentes en silencio hasta las ${clock})"
    fi
  else
    new_until=0
    if [[ "$scope" == "pane" ]]; then
      msg="🔊 Snooze desactivado en ${target_pane}"
    else
      msg="🔊 Snooze GLOBAL desactivado (los agentes vuelven a hablar)"
    fi
  fi

  if [[ "$scope" == "pane" ]]; then
    state=$(jq -c --arg p "$target_pane" --argjson stage "$new_stage" --argjson until "$new_until" \
      '.panes = ((.panes // {}) + {($p): ((.panes[$p] // {}) + {snooze_stage: $stage, snooze_until: $until})})' <<<"$state")
  else
    state=$(jq -c --argjson stage "$new_stage" --argjson until "$new_until" \
      '. + {global_snooze_stage: $stage, global_snooze_until: $until}' <<<"$state")
  fi
  save_snooze_state "$state" || true

  echo "$msg"
  notify_herdr "😴 Herdr TTS Snooze" "$msg"
}

# Exclusive mute of the focused pane (or of an explicitly passed pane id,
# as done by the dashboard cursor). Tied to the pane lifecycle, not to a
# timer: the daemon prune drops the flag as soon as the pane disappears
# from `herdr agent list`, so it auto-clears when the pane closes.
toggle_pane_mute() {
  local target_pane="${1:-}"
  if [[ -z "$target_pane" ]]; then
    target_pane=$(get_focused_pane)
  fi
  if [[ -z "$target_pane" ]]; then
    echo "⚠️ No hay ningún pane enfocado en Herdr" >&2
    notify_herdr "⚠️ Herdr Voice" "No hay ningún pane enfocado"
    return 1
  fi

  local state muted
  state=$(load_snooze_state)
  muted=$(jq -r --arg p "$target_pane" '(.panes[$p].muted // false)' <<<"$state")

  if [[ "$muted" == "true" ]]; then
    state=$(jq -c --arg p "$target_pane" '.panes[$p].muted = false' <<<"$state")
    echo "🔊 Voz reactivada en ${target_pane}"
    notify_herdr "🔊 Herdr TTS" "Voz reactivada en ${target_pane}"
  else
    state=$(jq -c --arg p "$target_pane" \
      '.panes = ((.panes // {}) + {($p): ((.panes[$p] // {}) + {muted: true})})' <<<"$state")
    echo "🔇 Pane ${target_pane} silenciado (se reactiva al cerrarse el pane)"
    notify_herdr "🔇 Herdr TTS" "Pane ${target_pane} silenciado (auto al cerrar)"
  fi
  save_snooze_state "$state" || true
}

# Pane lifecycle hook: runs on every daemon sweep with the live agent list.
# Mute (plus snooze/debounce leftovers) for panes that no longer exist are
# dropped, which is what makes pane mute auto-clear when the pane closes.
prune_snooze_state() {
  local raw_agents="$1"
  local panes now state pruned
  panes=$(printf '%s' "$raw_agents" | jq -c '[.result.agents[]?.pane_id | select(. != null)]' 2>/dev/null) || return 0
  now=$(date +%s)
  state=$(load_snooze_state)
  pruned=$(jq -c --argjson panes "$panes" --argjson now "$now" --argjson win "${TTS_DEBOUNCE_SECONDS:-20}" '
    .panes = ((.panes // {}) | with_entries(select(.key as $k | ($panes | index($k)) != null)))
    | .debounce = ((.debounce // {}) | with_entries(
        select((.key as $k | ($panes | index($k)) != null)
               and (($now - (.value.done // 0)) < $win))))' <<<"$state") || return 0
  [[ "$pruned" == "$state" ]] || save_snooze_state "$pruned" || true
}

# ─── Ambient pane-title glyphs (v0.11) ───────────────────────
# The daemon sweep piggybacks a title sync: agent panes whose voice state
# needs attention (done/blocked, muted, snoozed) get a glyph prefix on
# their pane title. Idempotent and rename-only-on-change: the pane's
# ORIGINAL title is cached once in the snooze state file (field
# `title_original` under the pane key — the existing prune sweep drops it
# for free when the pane closes) and every sweep only calls
# `herdr pane rename` when the live title drifted from the expected one.
# RESTORE is sacred: as soon as no glyph applies, the pane goes back to
# its cached original title and the cache entry is dropped; without a
# cache, any leading run of our own markers is stripped instead. Titles
# that match neither the expected value nor our marker pattern (and have
# no cache) are ADOPTED as the new original so integrations that rename
# panes are never fought over.

TITLE_GLYPH_DONE="✔"     # agent_status done/blocked
TITLE_GLYPH_MUTE="🔇"    # pane muted in the gating ledger
TITLE_GLYPH_SNOOZE="😴"  # per-pane snooze active in the gating ledger
TITLE_GLYPH_SEP=" | "    # joins the glyph block with the original title
# Leading marker run matcher/stripper (literal alternation, multibyte-safe).
TITLE_GLYPHS_RE='^((✔|🔇|😴)[[:space:]]?)+\|[[:space:]]?'

strip_title_glyphs() { # <out-var> <title>
  local _sg_s="$2"
  while [[ "$_sg_s" =~ $TITLE_GLYPHS_RE ]]; do
    _sg_s="${_sg_s#${BASH_REMATCH[0]}}"
  done
  printf -v "$1" '%s' "$_sg_s"
}

# One sweep of title sync over the agent list the daemon already fetched:
# ONE jq pass over the agents snapshot + ONE over the gating ledger, then
# only the drifted panes get a `herdr pane rename` spawn. Fails open: no
# agents snapshot or no jq output means nothing to do.
sync_pane_titles() { # <raw_agents_json>
  local now state rows
  now=$(date +%s)
  state=$(load_snooze_state)
  rows=$(printf '%s' "$1" | jq -r '
      .result.agents[]?
      | "\(.pane_id // "")\t\(.agent_status // "")\t\((.terminal_title_stripped // .terminal_title // "") | gsub("[\\t\\r\\n]"; " "))"
    ' 2>/dev/null) || return 0
  [[ -z "$rows" ]] && return 0

  # Single pass over the gating ledger: muted flag, active per-pane snooze
  # and any cached original title, keyed by pane_id.
  local -A s_muted=() s_snoozed=() s_orig=()
  local kp km ku ko
  while IFS=$'\t' read -r kp km ku ko; do
    [[ -z "$kp" ]] && continue
    [[ "$km" == "true" ]] && s_muted["$kp"]=1
    if [[ "$ku" =~ ^[0-9]+$ ]] && (( ku > now )); then
      s_snoozed["$kp"]=1
    fi
    [[ -n "$ko" ]] && s_orig["$kp"]="$ko"
  done < <(jq -r '
      ((.panes // {}) | to_entries[])
      | [ .key,
          ((.value.muted // false)|tostring),
          ((.value.snooze_until // 0)|tostring),
          ((.value.title_original // "")|tostring) ] | @tsv
    ' <<<"$state" 2>/dev/null || true)

  # Rename surface: `herdr pane rename` sets the pane LABEL — terminal_title
  # never changes after a rename (verified live). Compare against current
  # labels, falling back to the terminal title when pane list is unavailable.
  local -A s_label=()
  local lp ll
  while IFS=$'\t' read -r lp ll; do
    [[ -z "$lp" ]] && continue
    s_label["$lp"]="$ll"
  done < <(herdr pane list 2>/dev/null | jq -r '.result.panes[]? | "\(.pane_id)\t\(.label // "")"' 2>/dev/null)

  local changed=false
  local p st title glyphs original expected clean current
  while IFS=$'\t' read -r p st title; do
    # Never touch panes without an agent entry or without a title to guard.
    [[ -z "$p" || "$p" == "null" || -z "$title" ]] && continue
    original="${s_orig[$p]:-}"

    glyphs=""
    case "$st" in done|blocked) glyphs+="$TITLE_GLYPH_DONE" ;; esac
    [[ -n "${s_muted[$p]:-}" ]] && glyphs+="$TITLE_GLYPH_MUTE"
    [[ -n "${s_snoozed[$p]:-}" ]] && glyphs+="$TITLE_GLYPH_SNOOZE"

    if [[ -z "$glyphs" ]]; then
      # Restore path: no glyph applies anymore.
      current="${s_label[$p]:-$title}"
      if [[ -n "$original" ]]; then
        if [[ "$current" != "$original" ]]; then
          herdr pane rename "$p" "$original" >/dev/null 2>&1 || true
          changed=true
        fi
        state=$(jq -c --arg p "$p" 'del(.panes[$p].title_original)' <<<"$state")
        changed=true
      else
        strip_title_glyphs clean "$current"
        if [[ "$clean" != "$current" ]]; then
          herdr pane rename "$p" "$clean" >/dev/null 2>&1 || true
          changed=true
        fi
      fi
      continue
    fi

    # Prefix path: recover (or adopt) the original title first.
    current="${s_label[$p]:-$title}"
    if [[ -z "$original" ]]; then
      if [[ "$current" =~ $TITLE_GLYPHS_RE ]]; then
        strip_title_glyphs clean "$current" # daemon restarted, cache lost
      else
        clean="$current"
      fi
      original="$clean"
      state=$(jq -c --arg p "$p" --arg o "$original" \
        '.panes = ((.panes // {}) + {($p): ((.panes[$p] // {}) + {title_original: $o})})' <<<"$state")
      changed=true
    elif [[ "$current" != *"$original"* && ! "$current" =~ $TITLE_GLYPHS_RE ]]; then
      # Integration renamed the pane mid-session: adopt its title as the
      # new original instead of fighting over the label.
      original="$current"
      state=$(jq -c --arg p "$p" --arg o "$original" \
        '.panes = ((.panes // {}) + {($p): ((.panes[$p] // {}) + {title_original: $o})})' <<<"$state")
      changed=true
    fi
    expected="${glyphs}${TITLE_GLYPH_SEP}${original}"
    if [[ "$current" != "$expected" ]]; then
      herdr pane rename "$p" "$expected" >/dev/null 2>&1 || true
      changed=true
    fi
  done <<<"$rows"

  if [[ "$changed" == true ]]; then
    save_snooze_state "$state" || true
  fi
  return 0
}

# Daemon call-site guard: with TTS_TITLE_GLYPHS=0 the title sync is fully
# off and the sweep spawns NOTHING for titles (not even a jq pass).
daemon_title_sync() { # <raw_agents_json>
  [[ "${TTS_TITLE_GLYPHS:-1}" == "0" ]] && return 0
  sync_pane_titles "$1"
}

# Decide whether a watcher done/blocked event must be silenced BEFORE it
# reaches the synthesis engine. Returns 0 = gate (no speech, no engine
# call, log only), 1 = allow. Allowed events refresh the (pane, status)
# debounce ledger; the same pane repeating the same status inside the
# window is dropped, while a different status (done right after blocked)
# is never debounced.
gate_agent_event() {
  local pane_id="$1"
  local status="$2"
  local agent_name="${3:-$pane_id}"
  local now state muted until_ts last_seen

  now=$(date +%s)
  state=$(load_snooze_state)

  # 1. Per-pane mute (lifecycle-tied, cleared on pane close)
  muted=$(jq -r --arg p "$pane_id" '(.panes[$p].muted // false)' <<<"$state")
  if [[ "$muted" == "true" ]]; then
    echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): ${status} omitido (pane silenciado con prefix+m)"
    return 0
  fi

  # 2. Per-pane snooze
  until_ts=$(jq -r --arg p "$pane_id" '(.panes[$p].snooze_until // 0)' <<<"$state")
  if (( until_ts > now )); then
    echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): ${status} omitido (snooze hasta las $(fmt_epoch_clock "$until_ts"))"
    return 0
  fi

  # 3. Global snooze (meetings / focus)
  until_ts=$(jq -r '(.global_snooze_until // 0)' <<<"$state")
  if (( until_ts > now )); then
    echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): ${status} omitido (snooze GLOBAL hasta las $(fmt_epoch_clock "$until_ts"))"
    return 0
  fi

  # 4. Anti-spam debounce keyed by (pane_id, status)
  last_seen=$(jq -r --arg p "$pane_id" --arg s "$status" '(.debounce[$p][$s] // 0)' <<<"$state")
  if (( now - last_seen < TTS_DEBOUNCE_SECONDS )); then
    echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): ${status} repetido en menos de ${TTS_DEBOUNCE_SECONDS}s (debounce, omitido)"
    return 0
  fi

  # Allowed: record this (pane, status) sighting atomically
  state=$(jq -c --arg p "$pane_id" --arg s "$status" --argjson t "$now" \
    '.debounce = ((.debounce // {}) + {($p): ((.debounce[$p] // {}) + {($s): $t})})' <<<"$state")
  save_snooze_state "$state" || true
  return 1
}

# ─── Audio history ledger ────────────────────────────────────
# Append-only TSV ledger consumed by the dashboard: one line per rendered
# audio — <ISO timestamp> <TAB> <pane> <TAB> <agent> <TAB> <duration>
# [<TAB> <snippet> [<TAB> <audio path>]]. v0.11 added the 5th field: the
# first ~120 chars of the spoken text, single-line sanitized. The optional
# 6th field carries the path of the audio persisted in the agent-tts audio
# store while retention is on; "-" means retention is off, the turn was
# streamed without storage, or the render belongs to the caller. Consumers
# must treat each row as 4-field (legacy), 5-field or 6-field; rows are
# never rewritten in place. Mid-row fields are NEVER empty: bash `read`
# with tab IFS collapses adjacent delimiters, so an empty field would
# corrupt downstream parsing (a literal "-" is written instead).
# Best effort by design: a history write failure must never break the
# speech path.

# How many days the agent-tts audio store keeps finished-turn audio.
# First non-empty of the HERDR_TTS_/AGENT_TTS_/TTS_-prefixed knobs wins;
# a non-integer value falls back to the 7-day default and values <= 0
# disable persistence (0 → the watcher keeps the legacy tmp + rm flow).
# Fork-free on purpose: pure parameter expansion, [[ ]] tests and
# arithmetic (no self-referencing assignments inside (( ))).
config_get_retention_raw() { # <out-var> — raw retention ("" = unset everywhere)
  # Shared tier read: tier 1 = process variables (a real environment
  # override; the config loader unsets file-sourced startup values so they
  # cannot shadow later edits), tier 2 = the live config.env line (what the
  # settings menu writes). printf -v keeps this fork-free.
  local _cgr="${HERDR_TTS_AUDIO_RETENTION_DAYS:-${AGENT_TTS_AUDIO_RETENTION_DAYS:-${TTS_AUDIO_RETENTION_DAYS:-}}}"
  if [[ -z "$_cgr" && -r "$CONFIG_FILE" ]]; then
    local line fh="" fa="" ft="" v
    while IFS= read -r line; do
      case "$line" in
        HERDR_TTS_AUDIO_RETENTION_DAYS=*)
          [[ -n "$fh" ]] || { v="${line#*=}"; v="${v%\"}"; v="${v#\"}"; fh="$v"; } ;;
        AGENT_TTS_AUDIO_RETENTION_DAYS=*)
          [[ -n "$fa" ]] || { v="${line#*=}"; v="${v%\"}"; v="${v#\"}"; fa="$v"; } ;;
        TTS_AUDIO_RETENTION_DAYS=*)
          [[ -n "$ft" ]] || { v="${line#*=}"; v="${v%\"}"; v="${v#\"}"; ft="$v"; } ;;
      esac
    done < "$CONFIG_FILE"
    _cgr="${fh:-${fa:-${ft:-}}}"
  fi
  printf -v "$1" '%s' "$_cgr"
}

audio_retention_days() {
  # HOT knob (see config_get_retention_raw): normalized to 0 when unset or
  # invalid; a positive value enables the store with that pruning window.
  local raw
  config_get_retention_raw raw
  [[ "$raw" =~ ^-?[0-9]+$ ]] || raw=0
  if (( raw > 0 )); then
    printf '%s\n' "$raw"
  else
    printf '0\n'
  fi
}

# Root directory of the agent-tts audio store (one dated folder per day).
audio_store_dir() {
  printf '%s\n' "${AGENT_TTS_AUDIO_DIR:-$HOME/.local/share/agent-tts/audio}"
}

# Duration (seconds, 1 decimal) of a finished render. The engine prints no
# duration on --no-play renders and no IPC session survives them, so the
# real value comes from decoding the MP3 with the engine's own miniaudio
# (already in the venv). Budget: one extra engine-environment invocation
# per completed render, best effort, never blocking on failure.
audio_duration_secs() {
  local audio_file="$1"
  [[ -s "$audio_file" ]] || return 0
  "$VENV_PYTHON" -c '
import sys
import miniaudio
decoded = miniaudio.decode(open(sys.argv[1], "rb").read())
print(len(decoded.samples) / float(decoded.sample_rate * decoded.nchannels))
' "$audio_file" 2>/dev/null || true
}

# First ~120 chars of the spoken text as a single sanitized line: ANSI
# escape sequences stripped, CR/LF/tabs folded to spaces, control chars
# dropped, whitespace collapsed. Internal names are _hs_-prefixed on
# purpose: printf -v must reach the CALLER's variable, so no local may
# shadow a plausible out-var name (same discipline as dashboard_clamp_line).
history_snippet() { # <out-var> <text>
  local _hs_esc=$'\033' _hs_buf
  _hs_buf=$(printf '%s' "$2" \
    | sed -E -e "s/${_hs_esc}\\[[0-9;?]*[a-zA-Z]//g" -e "s/${_hs_esc}[@-Z\\\\-_]//g" \
    | tr '\n\t\r' '   ' \
    | tr -d '\000-\010\013\014\016-\037\177' \
    | tr -s ' ' \
    | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  printf -v "$1" '%s' "${_hs_buf:0:120}"
}

append_audio_history() { # <pane_id> <agent> <duration> [snippet] [audio_path]
  local pane_id="${1:--}"
  local agent="${2:--}"
  local duration="${3:--}"
  local snippet
  history_snippet snippet "${4:-}"
  local audio_path="${5:-}"
  # An empty probe result (engine decode failed) keeps the v1 "-" column.
  [[ -n "$duration" ]] || duration="-"
  mkdir -p "${HISTORY_FILE%/*}" 2>/dev/null || true
  local ts
  ts=$(date +%Y-%m-%dT%H:%M:%S)
  if [[ -n "$audio_path" ]]; then
    # Stored audio → ALWAYS 6 fields; the snippet column becomes a
    # literal "-" when empty (never an empty mid-row TSV field).
    if [[ -n "$snippet" ]]; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$ts" "$pane_id" "$agent" "$duration" "$snippet" "$audio_path" \
        >> "$HISTORY_FILE" 2>/dev/null || true
    else
      printf '%s\t%s\t%s\t%s\t-\t%s\n' "$ts" "$pane_id" "$agent" "$duration" "$audio_path" \
        >> "$HISTORY_FILE" 2>/dev/null || true
    fi
  elif [[ -n "$snippet" ]]; then
    printf '%s\t%s\t%s\t%s\t%s\n' "$ts" "$pane_id" "$agent" "$duration" "$snippet" \
      >> "$HISTORY_FILE" 2>/dev/null || true
  else
    # No usable snippet → keep the plain legacy 4-field row (no empty tail).
    printf '%s\t%s\t%s\t%s\n' "$ts" "$pane_id" "$agent" "$duration" \
      >> "$HISTORY_FILE" 2>/dev/null || true
  fi
}

# ─── Audio-store retention prune (daemon sweep) ──────────────
# Today the retention sweep only runs when the engine CLI starts, so an
# idle machine never prunes expired audio. The daemon sweep piggybacks
# the prune: it spawns the engine venv python OFF the audio critical
# path (after the sweep's pane work, at most once per hour) and fails
# open — a broken venv or a failed sweep is logged once and never
# affects the daemon loop. With retention off (0 days) it does nothing:
# no spawn, no timestamp bookkeeping.

AUDIO_PRUNE_STAMP="${STATE_DIR}/last-audio-prune" # hourly gate (file mtime)
AUDIO_PRUNE_MIN_SECS=3600

audio_store_prune() {
  # Retention disabled → nothing to prune and nothing to track.
  local days
  days=$(audio_retention_days)
  (( days > 0 )) || return 0

  # Hourly gate, fork-free: epoch now comes from the printf builtin and
  # the age comparison is plain bash arithmetic. The stamp's mtime is
  # the last attempt (success or failure), so a broken engine retries
  # at most once per hour instead of flooding every sweep. Freshly
  # declared locals are assigned before use — no self-referencing
  # assignment inside (( )) (an undeclared name silently evaluates to
  # 0 there).
  local now mtime=0 age
  printf -v now '%(%s)T' -1
  if [[ -f "$AUDIO_PRUNE_STAMP" ]]; then
    mtime=$(stat -c %Y "$AUDIO_PRUNE_STAMP" 2>/dev/null) || mtime=0
    [[ "$mtime" =~ ^[0-9]+$ ]] || mtime=0
  fi
  age=$(( now - mtime ))
  (( age >= AUDIO_PRUNE_MIN_SECS )) || return 0

  # Arm the gate before spawning: one attempt per hour even on failure.
  touch "$AUDIO_PRUNE_STAMP" 2>/dev/null || true
  if ! "$VENV_PYTHON" -c 'from agent_tts.audio_store import prune_expired; prune_expired()' >/dev/null 2>&1; then
    echo "[$(date +%H:%M:%S)] [retención] ⚠️ Purga del almacén de audio falló (reintento en la próxima hora)"
  fi
  return 0
}

# ─── Watcher daemon ──────────────────────────────────────────

watch_agent_pane() {
  local pane_id="$1"
  local agent_name="$2"
  local prev_state="working"

  while true; do
    herdr agent wait "$pane_id" --until done --until blocked --until idle 2>/dev/null || {
      sleep 3
      continue
    }

    local info
    info=$(herdr agent get "$pane_id" 2>/dev/null) || { sleep 3; continue; }
    local new_state
    new_state=$(echo "$info" | jq -r '.result.agent.agent_status // .result.agent_status // "unknown"' 2>/dev/null || echo "unknown")

    # Settle window (v0.16): agents flicker working→done→working between the
    # steps of ONE logical turn (tool batches, subagents, thinking), and
    # every flicker used to fire the full synthesis + ntfy push pipeline as
    # if the turn had ended. Only a done that STILL holds after
    # TTS_SETTLE_SECONDS is treated as the real end of turn; one that
    # reverted to working is logged and dropped. A state change DURING the
    # window re-targets the event (a done that became blocked fires as
    # blocked). 0 disables the window (legacy immediate fire).
    if [[ "$new_state" == "done" && "$TTS_SETTLE_SECONDS" != "0" ]]; then
      sleep "$TTS_SETTLE_SECONDS"
      local settled_state
      settled_state=$(herdr agent get "$pane_id" 2>/dev/null | jq -r '.result.agent.agent_status // .result.agent_status // "unknown"' 2>/dev/null || echo "unknown")
      if [[ "$settled_state" == "working" ]]; then
        echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): done intermedio descartado (volvió a working dentro de la ventana de asentamiento de ${TTS_SETTLE_SECONDS}s)"
        new_state="working"
      elif [[ "$settled_state" != "unknown" && "$settled_state" != "$new_state" ]]; then
        new_state="$settled_state"
      fi
    fi
    # Agent identity for the connector layer: the engine (agent-tts) owns the
    # transcript knowledge and resolves the last assistant message itself.
    local agent_kind
    agent_kind=$(echo "$info" | jq -r '.result.agent.agent_session.agent // empty' 2>/dev/null || true)
    local session_id
    session_id=$(echo "$info" | jq -r '.result.agent.agent_session.value // empty' 2>/dev/null || true)

    if [[ "$new_state" != "$prev_state" && "$new_state" != "working" && "$new_state" != "unknown" ]]; then
      local workspace
      workspace=$(echo "$info" | jq -r '.result.agent.workspace_id // .result.workspace_id // ""' 2>/dev/null || true)
      local title_desc
      title_desc=$(echo "$info" | jq -r '.result.agent.terminal_title_stripped // .result.agent.terminal_title // .result.terminal_title // ""' 2>/dev/null || true)

      echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): ${prev_state} → ${new_state}"

      # Pre-engine gating: snooze / mute / debounce. A gated event is
      # logged and dropped before any synthesis, playback or push; the
      # audio mutex below is untouched (it only serializes playback).
      if [[ "$new_state" == "done" || "$new_state" == "blocked" ]] && ! gate_agent_event "$pane_id" "$new_state" "$agent_name"; then
        # 0.6s grace period for multiplexer scrollback flush
        sleep 0.6

        # Connector flags only: the engine resolves the structured transcript
        # (OpenCode SQLite, Claude Code JSONL) and falls back to the scrollback
        # text on its own when no connector matches.
        local -a render_flags=()
        [[ -n "$agent_kind" ]] && render_flags+=(--agent "$agent_kind")
        [[ -n "$session_id" ]] && render_flags+=(--session-id "$session_id")

        local pane_text
        pane_text=$(read_pane_text "$pane_id")

        if [[ -n "$pane_text" && ! "$pane_text" =~ ^[[:space:]]*$ ]]; then
          # Turn-audio persistence: with retention on, the render lands
          # DIRECTLY in the agent-tts audio store (no tmp file, no
          # cross-filesystem mv) and retention owns the file lifecycle.
          # An uncreatable store dir fails open to the legacy tmp flow so
          # speech never depends on the store; with retention off the
          # tmp + rm flow runs exactly as before.
          local hist_audio=""
          if (( $(audio_retention_days) > 0 )); then
            local store_dir
            store_dir="$(audio_store_dir)/$(date +%F)"
            mkdir -p "$store_dir" 2>/dev/null || true
            if [[ -d "$store_dir" ]]; then
              hist_audio="${store_dir}/$(date +%s)-${pane_id//[^A-Za-z0-9_-]/_}.mp3"
            fi
          fi
          local render_target="${hist_audio:-/tmp/herdr-tts-${pane_id//:/_}-${BASHPID:-$$}-$RANDOM.mp3}"

          # 1. Synthesize audio file once, surfacing failures through the status popup
          local synth_err
          synth_err=$(mktemp "/tmp/herdr-tts-synth-err.XXXXXX")
          if ! render_text_audio "$render_target" "$pane_text" "${render_flags[@]}" > "$synth_err" 2>&1; then
            report_tts_error "${pane_id}" "$synth_err" 1
          fi
          rm -f "$synth_err"

          # Audio ledger for the dashboard history (best effort). The
          # 5th field carries the first ~120 chars of the spoken text;
          # the 6th carries the stored audio path (only when retention
          # actually kept the file).
          if [[ -s "$render_target" ]]; then
            local hist_snippet
            history_snippet hist_snippet "$pane_text"
            if [[ -n "$hist_audio" ]]; then
              append_audio_history "$pane_id" "${agent_kind:-$agent_name}" "$(audio_duration_secs "$render_target")" "$hist_snippet" "$hist_audio"
            else
              append_audio_history "$pane_id" "${agent_kind:-$agent_name}" "$(audio_duration_secs "$render_target")" "$hist_snippet"
            fi
          fi

          # 2. Push notification (mobile via ntfy, if configured)
          if [[ -n "$NTFY_TOPIC" ]]; then
            send_ntfy_push "$pane_id" "$agent_name" "$new_state" "$workspace" "$title_desc" "$render_target"
          fi

          # 2.5 Private Podcast Feed (if enabled)
          if [[ "$PODCAST_ENABLED" == "on" && -s "$render_target" ]]; then
            publish_podcast_episode "${agent_name} (${new_state}): ${title_desc:-$workspace}" "$pane_text" "$render_target"
          fi

          # 3. Local desktop voice playback
          local should_speak_local=true
          if is_auto_muted; then
            should_speak_local=false
          elif [[ "$TTS_AUTO_SCOPE" == "focused" ]]; then
            local current_focused
            current_focused=$(get_focused_pane)
            if [[ "$current_focused" != "$pane_id" ]]; then
              echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): terminó en segundo plano (no enfocado, omitiendo voz local)"
              should_speak_local=false
            fi
          fi

          if is_playing; then
            echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): ya hay otro chat hablando en local (omitido para evitar solapamiento)"
            should_speak_local=false
          fi

          if [[ "$should_speak_local" == true && -s "$render_target" ]]; then
            echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): vocalizando en altavoces locales"
            play_audio_file "$render_target"
          fi

          # Clean up temporary audio file after local player decodes it.
          # With retention on the stored file IS the product: cleanup is
          # skipped and the retention job owns its lifecycle.
          if [[ -z "$hist_audio" ]]; then
            if [[ "$should_speak_local" == true ]]; then
              ( sleep 6 && rm -f "$render_target" ) &
            else
              rm -f "$render_target"
            fi
          fi
        fi
      elif [[ "$new_state" == "idle" && "$prev_state" == "working" && -n "$NTFY_TOPIC" ]]; then
        send_ntfy_push "$pane_id" "$agent_name" "idle" "$workspace" "$title_desc" ""
      fi
    fi

    prev_state="$new_state"
    herdr agent wait "$pane_id" --until working 2>/dev/null || sleep 3
    prev_state="working"
  done
}

# Apply the declarative keymap once at daemon startup (idempotent; refuses
# on hard keymap errors without touching the target; shadow warnings are
# non-fatal and go to stderr). Missing keymap.json → silent no-op: bindings
# stay as they are until the user runs `keymap init`.
daemon_keymap_autostart() {
  [[ -f "$KEYMAP_FILE" ]] || return 0
  # Announce only when the target actually changed (apply is rc-0 on no-op).
  local target="${HERDR_CONFIG_DIR:-$HOME/.config}/herdr/config.toml"
  local before="" after=""
  [[ -f "$target" ]] && before=$(md5sum "$target" 2>/dev/null | cut -d' ' -f1)
  if keymap_apply "" 0 >/dev/null 2>&1; then
    [[ -f "$target" ]] && after=$(md5sum "$target" 2>/dev/null | cut -d' ' -f1)
    [[ -n "$after" && "$after" != "$before" ]] \
      && echo "🔊 Keymap aplicado desde $(basename "$KEYMAP_FILE")"
  else
    echo "⚠️ keymap apply falló en el arranque; atajos sin cambios." >&2
    echo "   Revísalo con: herdr-tts keymap check" >&2
  fi
}

# Single-instance takeover: exactly one daemon may gate events. At startup,
# a live previous daemon (orphan from a prior session/launch) is terminated
# before this one proceeds. PID reuse is guarded by checking /proc cmdline.
DAEMON_PID_FILE="${HERDR_TTS_DAEMON_PID_FILE:-/tmp/herdr-tts-daemon.pid}"
# Daemon observability + supervisor coordination. daemon.log is appended
# directly by the daemon/supervisor (a silent death must leave a trace
# even when stdout goes to /dev/null). The stop flag is armed BEFORE any
# intentional daemon kill (stop paths, single-instance takeover): the
# supervisor consumes it and exits instead of relaunching. Env overrides
# keep tests hermetic.
DAEMON_LOG="${HERDR_TTS_DAEMON_LOG:-${STATE_DIR}/daemon.log}"
SUPERVISOR_STOP_FLAG="${HERDR_TTS_SUPERVISOR_STOP_FILE:-${STATE_DIR}/daemon-supervisor.stop}"
SUPERVISOR_BACKOFF="${HERDR_TTS_SUPERVISOR_BACKOFF:-5}"

daemon_log() { # <msg> → timestamped line appended to daemon.log (fail-open)
  echo "[$(date +%H:%M:%S)] $*" >> "$DAEMON_LOG" 2>/dev/null || true
}

daemon_takeover() {
  if [[ -f "$DAEMON_PID_FILE" ]]; then
    local old_pid
    old_pid=$(cat "$DAEMON_PID_FILE" 2>/dev/null || true)
    if [[ "$old_pid" =~ ^[0-9]+$ && "$old_pid" != "$$" ]] \
       && grep -aq "herdr-tts" "/proc/$old_pid/cmdline" 2>/dev/null; then
      # The old daemon's supervisor must not read this death as a crash:
      # arm the stop flag BEFORE the kill (it consumes the flag and exits).
      { : > "$SUPERVISOR_STOP_FLAG"; } 2>/dev/null || true
      kill "$old_pid" 2>/dev/null || true
      sleep 0.3
    fi
  fi
  printf '%s\n' "$$" > "$DAEMON_PID_FILE"
}

# ─── Daemon lifecycle: pid / stop / restart ─────────────────
# Liveness probe for the current daemon: the pidfile pid is trusted only
# while the process is alive AND its /proc cmdline mentions herdr-tts
# (same PID-reuse guard as daemon_takeover). Prints the pid when alive,
# nothing otherwise; rc is always 0 so `x=$(daemon_pid)` is set -e safe.
daemon_pid() {
  local pid
  pid=$(cat "${DAEMON_PID_FILE}" 2>/dev/null || true)
  if [[ "$pid" =~ ^[0-9]+$ ]] \
     && kill -0 "$pid" 2>/dev/null \
     && grep -aq "herdr-tts" "/proc/$pid/cmdline" 2>/dev/null; then
    printf '%s\n' "$pid"
  fi
  return 0
}

# Bounded wait (~2s) for a pid to disappear. A zombie counts as gone: the
# process is dead, its entry just lingers unreaped by the parent.
daemon_wait_gone() { # <pid>
  local pid="$1" i stat state
  for (( i = 0; i < 20; i++ )); do
    kill -0 "$pid" 2>/dev/null || return 0
    stat=$(cat "/proc/$pid/stat" 2>/dev/null || true)
    state="${stat##*) }"
    state="${state%% *}"
    [[ "$state" == "Z" ]] && return 0
    sleep 0.1
  done
  return 1
}

# Best-effort stop of any live TTS daemon. Preferred path: the pidfile
# (kill + bounded wait). Legacy daemons predate the pidfile: fall back to
# a cmdline sweep of `bin/herdr-tts _daemon` (our own invocation never
# matches — it is not a _daemon). Fail-open throughout: a missing pidfile,
# a dead pid or a sweep with no match all exit 0. What happened is
# reported through the optional out-var ("pidfile" | "fallback" | "none");
# without one, non-noop results go to stderr.
# Legacy-daemon sweep for daemons the pidfile does not know about (pre-
# v0.14.1 starts). Strict argv match instead of `pkill -f`: a process only
# counts when one of its arguments ends with "herdr-tts" AND another is
# EXACTLY "_daemon". A substring sweep (pkill -f) would also kill innocent
# processes that merely mention the string inside a larger argument — e.g.
# an AI session or an editor holding this script's text. Fork-free /proc
# walk; never touches our own pid or our parent's.
daemon_sweep_legacy() { # [out-var] → "killed" | "none"
  local d pid arg prev="" _dsl_result="none"
  for d in /proc/[0-9]*; do
    pid="${d#/proc/}"
    [[ "$pid" == "$$" || "$pid" == "$PPID" ]] && continue
    [[ -r "$d/cmdline" ]] || continue
    prev=""
    while IFS= read -r -d '' arg; do
      # Adjacent-argv signature: <...herdr-tts> <_daemon> — exactly how the
      # supervisor and daemon_restart spawn the daemon CHILD (the supervisor
      # itself runs _daemon-supervised and never matches). Embedded mentions
      # inside a larger single argument (AI sessions, editors) never match.
      if [[ -n "$prev" && "$prev" == *herdr-tts && "$arg" == "_daemon" ]]; then
        # Smoke-suite safety: when the sweep itself runs under the suite
        # marker, only kill daemons that carry it too — a REAL daemon on
        # this machine (no marker) must survive a test battery run.
        if [[ "${HERDR_TTS_SMOKE:-}" == 1 ]] \
           && ! grep -aq HERDR_TTS_SMOKE "/proc/$pid/environ" 2>/dev/null; then
          prev="$arg"
          continue
        fi
        kill "$pid" 2>/dev/null || true
        daemon_wait_gone "$pid" || true
        _dsl_result="killed"
        break
      fi
      prev="$arg"
    done < "$d/cmdline"
  done
  if [[ -n "${1:-}" ]]; then
    printf -v "$1" '%s' "$_dsl_result"
  fi
  [[ "$_dsl_result" == "killed" ]]
}

daemon_stop_running() { # [out-var]
  # NOTE: the result local is function-prefixed so a caller's out-var can
  # never collide with it (printf -v would write the local, lost on return).
  local out_var="${1:-}" pid _dsr_result="none" _dsr_sweep="none"
  # Deliberate-stop coordination: arm the supervisor stop flag BEFORE the
  # kill so the supervisor consumes it and exits instead of relaunching a
  # daemon this stop (restart paths) meant to end.
  { : > "$SUPERVISOR_STOP_FLAG"; } 2>/dev/null || true
  pid=$(daemon_pid)
  if [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
    daemon_wait_gone "$pid" || true
    _dsr_result="pidfile"
  elif daemon_sweep_legacy _dsr_sweep; then
    sleep 0.2 # grace so the swept daemon settles before any relaunch
    _dsr_result="fallback"
  fi
  if [[ -n "$out_var" ]]; then
    printf -v "$out_var" '%s' "$_dsr_result"
  elif [[ "$_dsr_result" != "none" ]]; then
    echo "daemon stop: ${_dsr_result}" >&2
  fi
  return 0
}

# User-facing restart: stop whatever is running, relaunch detached through
# the SCRIPT re-invocation mechanism (setsid so it survives terminal
# close; plain nohup fallback when setsid is unavailable), then wait up to
# ~3s for the new daemon to claim the pidfile. Fail-open: a pidfile that
# never shows up still exits 0 (the daemon may still be initializing —
# venv bootstrap, keymap autostart); only an unusable spawn target is rc 1.
daemon_restart() {
  local prev_pid="" new_pid="" spawn_pid="" i
  [[ -f "$DAEMON_PID_FILE" ]] && prev_pid=$(cat "$DAEMON_PID_FILE" 2>/dev/null || true)
  daemon_stop_running
  if [[ ! -x "$SCRIPT" ]]; then
    echo "⚠️ No se pudo relanzar el daemon: $SCRIPT no es ejecutable" >&2
    return 1
  fi
  if command -v setsid >/dev/null 2>&1; then
    setsid nohup "$SCRIPT" _daemon-supervised >/dev/null 2>&1 &
  else
    nohup "$SCRIPT" _daemon-supervised >/dev/null 2>&1 &
  fi
  spawn_pid=$!
  for (( i = 0; i < 30; i++ )); do
    if [[ -f "$DAEMON_PID_FILE" ]]; then
      new_pid=$(cat "$DAEMON_PID_FILE" 2>/dev/null || true)
      if [[ "$new_pid" =~ ^[0-9]+$ && "$new_pid" != "$prev_pid" ]]; then
        echo "✓ Daemon reiniciado (pid ${new_pid})" >&2
        return 0
      fi
    fi
    sleep 0.1
  done
  echo "⚠️ Daemon relanzado (pid ${spawn_pid}) pero el pidfile no apareció; puede seguir inicializando" >&2
  return 0
}

run_daemon() {
  # Startup line lands in daemon.log even when stdout is /dev/null (a
  # --restart-daemon relaunch): a silent start or death can never happen.
  daemon_log "🔊 daemon iniciado (pid $$, scope ${TTS_AUTO_SCOPE})"
  echo "🔊 Iniciando Herdr TTS Daemon (con Mutex y Scope ${TTS_AUTO_SCOPE})..."
  show_status
  daemon_takeover

  # Startup auto-apply of the declarative keymap (Bruno's flow: edit
  # keymap.json → restart Herdr → bindings land). Never auto-inits; a
  # missing/broken keymap.json is skipped with a warning, bindings stay.
  daemon_keymap_autostart

  CHILD_PIDS=()
  DAEMON_EXIT_REASON="apagado limpio"
  cleanup() {
    for pid in "${CHILD_PIDS[@]:-}"; do
      kill "$pid" 2>/dev/null || true
    done
    rm -f /tmp/herdr-tts-watcher-*.lock 2>/dev/null || true
    rm -f "$DAEMON_PID_FILE" 2>/dev/null || true
    stop_audio
    daemon_log "🛑 daemon detenido (pid $$ — ${DAEMON_EXIT_REASON})"
    exit 0
  }
  # Signals mark the exit reason and reuse the EXIT cleanup (trap order:
  # TERM/INT handlers exit, which fires the cleanup trap last).
  trap 'DAEMON_EXIT_REASON="señal TERM recibida"; exit 0' TERM
  trap 'DAEMON_EXIT_REASON="señal INT recibida"; exit 0' INT
  trap cleanup EXIT

  while true; do
    local raw_agents
    raw_agents=$(herdr agent list 2>/dev/null) || { sleep 4; continue; }

    # Pane lifecycle: drop mute/snooze/debounce state for closed panes
    prune_snooze_state "$raw_agents"

    # Ambient title glyphs (done/muted/snoozed) piggyback on this sweep —
    # no extra `herdr agent list`, only rename spawns for drifted panes.
    daemon_title_sync "$raw_agents"

    while IFS=$'\t' read -r pane_id agent_name; do
      [[ -z "$pane_id" || "$pane_id" == "null" ]] && continue

      local lock_file="/tmp/herdr-tts-watcher-${pane_id//:/_}.lock"
      if [[ -f "$lock_file" ]]; then
        local existing_pid
        existing_pid=$(cat "$lock_file" 2>/dev/null || true)
        if [[ -n "$existing_pid" ]] && kill -0 "$existing_pid" 2>/dev/null; then
          continue
        fi
      fi

      watch_agent_pane "$pane_id" "$agent_name" &
      local child_pid=$!
      echo "$child_pid" > "$lock_file"
      CHILD_PIDS+=("$child_pid")
    done < <(echo "$raw_agents" | jq -r '.result.agents[]? | "\(.pane_id)\t\(.agent)"' 2>/dev/null || true)

    # Retention prune (hour-gated): runs AFTER the sweep's audio work
    # (gating, title glyphs, watcher spawning) so it can never delay or
    # block audio; itself best-effort and fail-open.
    audio_store_prune

    sleep 4
  done
}

# ─── Daemon supervisor (plugin-native watchdog) ──────────────
# Foreground loop re-invoking `"$SCRIPT" _daemon` as a child: an UNPLANNED
# daemon death is logged and the child relaunched after SUPERVISOR_BACKOFF
# seconds; a death armed via the stop flag (daemon_stop_running before an
# intentional kill, daemon_takeover before a takeover) is consumed and ends
# supervision. run_daemon is NEVER called in-process — its cleanup trap
# exits the shell, which would kill the supervisor itself. TERM/INT are
# forwarded to the child and the supervisor exits without orphaning it.

daemon_supervisor_should_relaunch() { # <rc> → 0 = relaunch, 1 = stop
  # Deliberate-stop coordination: a present flag means this death was
  # asked for — consume it (one-shot) and do not relaunch.
  if [[ -f "$SUPERVISOR_STOP_FLAG" ]]; then
    rm -f "$SUPERVISOR_STOP_FLAG" 2>/dev/null || true
    return 1
  fi
  return 0
}

run_daemon_supervised() {
  local child_pid="" rc=0 forward_sig=""
  # A stale flag (armed by a stop whose supervisor died before consuming)
  # must not swallow this session's first real stop: start clean.
  rm -f "$SUPERVISOR_STOP_FLAG" 2>/dev/null || true
  _sup_forward() { # INT/TERM: relay to the live child, else die at once
    forward_sig="${1:-TERM}"
    if [[ -n "${child_pid:-}" ]] && kill -0 "$child_pid" 2>/dev/null; then
      kill -"$forward_sig" "$child_pid" 2>/dev/null || true
    else
      daemon_log "🛑 supervisor: ${forward_sig} sin daemon hijo — saliendo (pid $$)"
      exit 0
    fi
  }
  _sup_reap() { # EXIT guard: never orphan the daemon child
    if [[ -n "${child_pid:-}" ]] && kill -0 "$child_pid" 2>/dev/null; then
      kill "$child_pid" 2>/dev/null || true
      wait "$child_pid" 2>/dev/null || true
    fi
  }
  trap '_sup_forward INT' INT
  trap '_sup_forward TERM' TERM
  trap '_sup_reap' EXIT

  daemon_log "🛰️ supervisor de daemon activo (pid $$, relanzamiento en ${SUPERVISOR_BACKOFF}s)"
  while true; do
    forward_sig=""
    "$SCRIPT" _daemon &
    child_pid=$!
    rc=0
    wait "$child_pid" || rc=$?
    if [[ -n "$forward_sig" ]]; then
      wait "$child_pid" 2>/dev/null || true # reap the signaled child
      child_pid=""
      daemon_log "🛑 supervisor: ${forward_sig} recibido — parada con el daemon (rc=${rc})"
      exit 0
    fi
    child_pid=""
    if ! daemon_supervisor_should_relaunch "$rc"; then
      daemon_log "🛑 supervisor: parada deliberada del daemon (rc=${rc}) — sin relanzamiento"
      exit 0
    fi
    daemon_log "⚠️ daemon murió (rc=${rc}) — relanzando en ${SUPERVISOR_BACKOFF}s"
    sleep "$SUPERVISOR_BACKOFF"
  done
}

# ─── Dashboard pane (v3, per-chat view) ──────────────────────
# Compact in-terminal status panel (--dashboard), designed to run as a
# Herdr plugin pane ([[panes]] entrypoint). Pure ANSI clear+redraw at a
# ~1s cadence; zero external TUI dependencies. v3 reorganizes the panel
# around CHATS instead of TTS internals: the roster merges `herdr agent
# list` (agent state + chat title), the snooze/mute ledger and the
# debounce ledger under the same pane_id merge key, and the audio history
# renders grouped per chat. Read-only with respect to the gate/mutex/
# watcher machinery: every mutation goes through the existing mute /
# snooze / rate functions, never through side channels.

DASHBOARD_ROSTER_REFRESH_TICKS=3   # `herdr agent list` every N ticks (cached)
DASHBOARD_ENGINE_REFRESH_TICKS=3   # engine IPC status every N ticks (cached, v2)
DASHBOARD_SNIPPET_MAX_CHARS=48     # width cap for the engine text snippet
DASHBOARD_ROSTER_TITLE_CHARS=40    # chat title width cap in the roster
DASHBOARD_HISTORY_TITLE_CHARS=30   # chat title width cap in history headers
DASHBOARD_HISTORY_BUDGET=24        # global row budget for the history section
DASHBOARD_HISTORY_AUDIO_ROWS=3     # audios rendered per chat group
DASHBOARD_HISTORY_SCAN_LINES=400   # ledger tail scanned per tick (bounded cost)
DASH_TERM_FALLBACK_LINES=40        # pty-size fallback when LINES/COLUMNS/tput fail
DASH_TERM_FALLBACK_COLS=100
DASH_WIDTH_BASE=110                # field caps scale down below this popup width
DASH_ANSI_RE=$'\e\[[0-9;?]*[a-zA-Z]' # CSI matcher for visible-width math
DASH_LAST_FRAME=""                 # previous tick's frame (change-detection)

# Globals shared between refresh / scan / order / render ticks.
declare -A DASH_TITLE_BY_PANE=()   # pane_id -> chat title (from agent list)
declare -A HIST_RANK=()            # pane_id -> audio recency rank (0 = newest)
DASH_DROPPED=0                     # chats hidden by the roster overflow cap
DASH_HIST_ROWS_TOTAL=0             # rows the full history render would need
HIST_PANES=(); HIST_COUNTS=(); HIST_LASTTS=(); HIST_LASTEPOCH=(); HIST_ITEMS=()

fmt_mmss() {
  local secs="$1"
  printf '%02d:%02d' $(( secs / 60 )) $(( secs % 60 ))
}

# Fit a string to a fixed CHARACTER width (truncate with an ellipsis, or
# pad with spaces) into <out-var>. Bash parameter expansion is multibyte
# aware, unlike printf field precision which counts bytes and breaks
# UTF-8 chat titles. Var-setting on purpose: render loops call this per
# line and must not fork a subshell per row.
dashboard_fit() { # <out-var> <string> <width>
  local s="$2" w="$3"
  if (( ${#s} > w )); then
    s="${s:0:w-1}…"
  fi
  while (( ${#s} < w )); do
    s+=" "
  done
  printf -v "$1" '%s' "$s"
}

# Sets <out-var> to a compact Spanish age label: 42s / 5m / 2h.
dashboard_fmt_age() { # <out-var> <secs>
  local secs="$2"
  (( secs < 0 )) && secs=0
  if (( secs < 60 )); then
    printf -v "$1" '%ss' "$secs"
  elif (( secs < 3600 )); then
    printf -v "$1" '%sm' "$(( secs / 60 ))"
  else
    printf -v "$1" '%sh' "$(( secs / 3600 ))"
  fi
  return 0
}

# Sets <out-var> to the duration label: numeric seconds -> mm:ss; anything
# else (the "-" probe-failure marker from the ledger) passes through.
dashboard_fmt_dur() { # <out-var> <value>
  local d="$2"
  if [[ "$d" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    printf -v "$1" '%02d:%02d' $(( ${d%%.*} / 60 )) $(( ${d%%.*} % 60 ))
  else
    printf -v "$1" '%s' "$d"
  fi
}

dashboard_cleanup() {
  printf '\033[0m\033[?25h\033[2J\033[H'
}

# ─── Render pipeline (v3.1): atomic single-write frames ──────
# The popup is repainted by building the WHOLE frame in a buffer and
# emitting it once (cursor-home + content + erase-below), never with a
# full-screen clear or per-line writes. Every line is clamped to the
# real popup width and the frame height is capped at LINES-1 so long
# lines and tall frames can never wrap or scroll the layout apart.

# Resolve the popup pty size each tick: exported LINES/COLUMNS first,
# then tput against the tty, then a fixed 40x100 fallback. Both values
# are validated so a stale or garbage source can't poison the clamps.
dashboard_term_size() { # sets DASH_LINES / DASH_COLS
  if [[ "${LINES:-}" =~ ^[0-9]+$ && "${COLUMNS:-}" =~ ^[0-9]+$ ]] \
     && (( LINES > 2 && COLUMNS > 10 )); then
    DASH_LINES=$LINES
    DASH_COLS=$COLUMNS
    return 0
  fi
  local l="" c=""
  if command -v tput >/dev/null 2>&1; then
    l=$(tput lines 2>/dev/null) || l=""
    c=$(tput cols 2>/dev/null) || c=""
  fi
  if [[ "$l" =~ ^[0-9]+$ && "$c" =~ ^[0-9]+$ ]] && (( l > 2 && c > 10 )); then
    DASH_LINES=$l
    DASH_COLS=$c
    return 0
  fi
  DASH_LINES=$DASH_TERM_FALLBACK_LINES
  DASH_COLS=$DASH_TERM_FALLBACK_COLS
}

# Dynamic field widths: below DASH_WIDTH_BASE columns the padded
# title/agent/snippet fields shrink proportionally (with floors) so the
# worst-case composed line still lands inside the popup width. Exact
# wcwidth is impossible in pure bash; these caps plus the per-line clamp
# below are the wrap guarantee.
dashboard_calc_widths() { # $1 = COLUMNS
  local cols="$1"
  DASH_W_ROSTER_TITLE=$DASHBOARD_ROSTER_TITLE_CHARS
  DASH_W_AGENT=9
  DASH_W_HIST_TITLE=$DASHBOARD_HISTORY_TITLE_CHARS
  DASH_W_SNIPPET=$DASHBOARD_SNIPPET_MAX_CHARS
  if (( cols >= DASH_WIDTH_BASE )); then
    return 0
  fi
  DASH_W_ROSTER_TITLE=$(( cols * DASHBOARD_ROSTER_TITLE_CHARS / DASH_WIDTH_BASE ))
  DASH_W_AGENT=$(( cols * 9 / DASH_WIDTH_BASE ))
  DASH_W_HIST_TITLE=$(( cols * DASHBOARD_HISTORY_TITLE_CHARS / DASH_WIDTH_BASE ))
  DASH_W_SNIPPET=$(( cols * DASHBOARD_SNIPPET_MAX_CHARS / DASH_WIDTH_BASE ))
  if (( DASH_W_ROSTER_TITLE < 10 )); then DASH_W_ROSTER_TITLE=10; fi
  if (( DASH_W_AGENT < 3 )); then DASH_W_AGENT=3; fi
  if (( DASH_W_HIST_TITLE < 8 )); then DASH_W_HIST_TITLE=8; fi
  if (( DASH_W_SNIPPET < 8 )); then DASH_W_SNIPPET=8; fi
}

# Truncate a raw line to <max> visible chars. ANSI escapes are not
# counted and always survive (trailing SGR resets can never be cut, so
# colors never leak across lines); visible width is the codepoint count
# of the ANSI-free text — an upper bound of the rendered column width,
# which is exactly the safe direction for wrap-avoidance. Fork-free:
# the render loop calls this once per line.
dashboard_clamp_line() { # <out-var> <raw-line> <max-visible>
  # Internal names are clamp-prefixed on purpose: `printf -v "$1"` must
  # reach the CALLER's variable, so no local may shadow a plausible
  # out-var name like `out` or `line`.
  local _clamp_buf="" _clamp_rest="$2" _clamp_max="$3" _clamp_run=""
  while [[ -n "$_clamp_rest" ]]; do
    if [[ "$_clamp_rest" =~ ^($DASH_ANSI_RE) ]]; then
      _clamp_buf+="${BASH_REMATCH[0]}"
      _clamp_rest="${_clamp_rest#"${BASH_REMATCH[0]}"}"
    else
      _clamp_run="${_clamp_rest%%$'\033'*}"
      _clamp_rest="${_clamp_rest#"$_clamp_run"}"
      if (( _clamp_max > 0 )); then
        if (( ${#_clamp_run} > _clamp_max )); then _clamp_run="${_clamp_run:0:_clamp_max}"; fi
        _clamp_buf+="$_clamp_run"
        _clamp_max=$(( _clamp_max - ${#_clamp_run} ))
      fi
    fi
  done
  printf -v "$1" '%s' "$_clamp_buf"
}

# Frame-buffer append: format one line, clamp it to the popup width and
# append it to the caller's `frame` variable (dynamic scoping). Fork-free.
_dash_add() { # <fmt> [args...]
  local out
  printf -v out "$@"
  dashboard_clamp_line out "$out" "$DASH_COLS"
  frame+="$out"$'\n'
}

# Chat roster from Herdr (v3): pane_id, agent kind, agent_status and chat
# title in a single jq pass. Fails open: with no CLI or no agents the
# roster stays empty and the chats section renders "sin datos de herdr".
dashboard_refresh_roster() {
  DASH_PANES=()
  DASH_AGENTS=()
  DASH_STATUSES=()
  DASH_TITLES=()
  DASH_TITLE_BY_PANE=()
  local raw
  raw=$(herdr agent list 2>/dev/null) || return 0
  local pid agent st title
  while IFS=$'\t' read -r pid agent st title; do
    [[ -z "$pid" || "$pid" == "null" ]] && continue
    agent="${agent:-desconocido}"
    st="${st:-unknown}"
    DASH_PANES+=("$pid")
    DASH_AGENTS+=("$agent")
    DASH_STATUSES+=("$st")
    DASH_TITLES+=("$title")
    DASH_TITLE_BY_PANE["$pid"]="$title"
  done < <(printf '%s' "$raw" | jq -r '
      .result.agents[]?
      | "\(.pane_id // "")\t\(.agent // "")\t\(.agent_status // "")\t\((.terminal_title_stripped // .terminal_title // "") | gsub("[\\t\\r\\n]"; " "))"
    ' 2>/dev/null || true)
}

# Live engine status (v2) through the same host→engine invocation the
# --toggle-pause flow uses. Queried on the roster cache cadence: one python
# spawn every N ticks for the WHOLE dashboard, never per pane. Fails open:
# with no engine session the cache stays empty and the Motor line renders
# the static fallback plus an explicit "motor: no responde" note.
dashboard_refresh_engine() {
  DASH_ENGINE_STATUS=""
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd status 2>/dev/null) || return 0
  [[ -z "$res" || "$res" == *"Error:"* ]] && return 0
  DASH_ENGINE_STATUS="$res"
}

# Word-field extraction from the single-line engine payload (`key=value`
# tokens whose values never contain spaces). First match wins: engine
# fields precede the free-text fields, so a snippet containing e.g.
# "pos=" can never shadow the real field. Set-e safe via `|| true`.
dashboard_engine_field() {
  local payload="$1" key="$2" value=""
  value=$(printf '%s' "$payload" | grep -o "${key}=[^ ]*" | head -n 1 | cut -d= -f2) || true
  printf '%s' "$value"
}

# Trailing free-text snippet (may contain spaces): everything after the
# last `text=` marker, v1's `sed -n 's/.*key=//p'` convention.
dashboard_engine_text() {
  printf '%s' "$1" | sed -n 's/.*text=//p'
}

# Spanish label for the engine state word reported by the IPC payload.
dashboard_engine_state_label() {
  case "$1" in
    playing)      printf '▶ reproduciendo' ;;
    paused)       printf '⏸ pausado' ;;
    stopped)      printf '⏹ detenido' ;;
    synthesizing) printf '⌛ sintetizando' ;;
    *)            printf '%s' "${1:-desconocido}" ;;
  esac
}

# Audio history grouped per chat (v3): ONE python pass over the ledger
# tail does the grouping, the last-audio recency ordering and the
# local-time -> epoch conversion (datetime applies per-date DST rules,
# which a hand-rolled calendar or a cached zone offset cannot). It emits
# TSV rows — `H <pane> <count> <last_iso> <last_epoch>` group headers,
# each followed by `A <iso> <epoch> <dur> <path>` audio rows in
# chronological order (the render walks them backwards for newest-first). Per-chat
# counts are computed within the scanned window so cost stays bounded on
# a ledger that is append-only and never rotated. Fails open: no file,
# no python or corrupt rows leave the history arrays empty and the
# section hidden.
dashboard_scan_history() {
  HIST_PANES=(); HIST_COUNTS=(); HIST_LASTTS=(); HIST_LASTEPOCH=(); HIST_ITEMS=()
  HIST_RANK=()
  DASH_HIST_ROWS_TOTAL=0
  [[ -s "$HISTORY_FILE" ]] || return 0
  local rows
  rows=$(tail -n "$DASHBOARD_HISTORY_SCAN_LINES" "$HISTORY_FILE" 2>/dev/null | "$VENV_PYTHON" -c '
import sys
from datetime import datetime

def epoch(ts):
    try:
        return str(int(datetime.fromisoformat(ts).timestamp()))
    except ValueError:
        return "-"

rows = []
for line in sys.stdin.read().split("\n"):
    f = line.split("\t")
    if len(f) < 2 or not f[1]:
        continue
    rows.append(f)
groups = {}
for idx, f in enumerate(rows):
    ts = f[0] if f[0] else "-"
    dur = f[3] if len(f) > 3 else "-"
    path = f[5] if len(f) > 5 else "-"
    g = groups.setdefault(f[1], {"count": 0, "last": 0, "items": []})
    g["count"] += 1
    g["last"] = idx
    g["items"].append((ts, dur, path))
    del g["items"][:-3]
out = []
for pane, g in sorted(groups.items(), key=lambda kv: -kv[1]["last"]):
    items = g["items"]
    last_ts = items[-1][0] if items else "-"
    out.append("\t".join(["H", pane, str(g["count"]), last_ts, epoch(last_ts)]))
    for ts, dur, path in items:
        out.append("\t".join(["A", ts, epoch(ts), dur, path]))
sys.stdout.write("\n".join(out) + ("\n" if out else ""))
' 2>/dev/null) || rows=""
  [[ -z "$rows" ]] && return 0
  local kind f2 f3 f4 f5 gi=-1
  while IFS=$'\t' read -r kind f2 f3 f4 f5; do
    case "$kind" in
      H)
        gi=$(( gi + 1 ))
        HIST_PANES[gi]="$f2"
        HIST_COUNTS[gi]="$f3"
        HIST_LASTTS[gi]="$f4"
        HIST_LASTEPOCH[gi]="$f5"
        HIST_ITEMS[gi]=""
        ;;
      A)
        # f5 absorbs the trailing path column (the python pass always
        # emits it, "-" when the audio was not persisted); paths are
        # charset-safe by construction, never containing | or ;.
        (( gi >= 0 )) && HIST_ITEMS[gi]+="${f2}|${f3}|${f4}|${f5};"
        ;;
    esac
  done <<<"$rows"
  local i shown
  for (( i = 0; i < ${#HIST_PANES[@]}; i++ )); do
    HIST_RANK[${HIST_PANES[$i]}]="$i"
    shown=$(( HIST_COUNTS[i] < DASHBOARD_HISTORY_AUDIO_ROWS ? HIST_COUNTS[i] : DASHBOARD_HISTORY_AUDIO_ROWS ))
    DASH_HIST_ROWS_TOTAL=$(( DASH_HIST_ROWS_TOTAL + 1 + shown ))
  done
  return 0
}

# Sort the roster into visible order (v3): needs-attention first
# (done/blocked -> working -> idle -> unknown), ties broken by most recent
# audio in the history ledger, then by agent-list order (stable insertion
# sort). The visible order is written back into the DASH_* arrays so the
# j/k cursor walks exactly what is on screen. The overflow cap drops from
# the tail — the oldest-idle chats — and never hides needs-attention
# (done/blocked) chats.
dashboard_order_roster() {
  local cap="$1"
  DASH_DROPPED=0
  local n=${#DASH_PANES[@]}
  if (( n == 0 )); then
    return 0
  fi
  (( cap >= 1 )) || cap=1
  local -a pri=() rank=() idx=()
  local i p pri0=0
  for (( i = 0; i < n; i++ )); do
    p="${DASH_STATUSES[$i]}"
    case "$p" in
      done|blocked) pri[i]=0 ;;
      working)      pri[i]=1 ;;
      idle)         pri[i]=2 ;;
      *)            pri[i]=3 ;; # unknown states render literally, sort last
    esac
    rank[i]=${HIST_RANK[${DASH_PANES[$i]}]:-999999}
    idx[i]=$i
    (( pri[i] == 0 )) && pri0=$(( pri0 + 1 ))
  done
  # Needs-attention chats are never dropped, even when the cap is tight.
  (( cap < pri0 )) && cap=$pri0
  local a b j
  for (( i = 1; i < n; i++ )); do
    a=${idx[i]}
    j=$(( i - 1 ))
    while (( j >= 0 )); do
      b=${idx[j]}
      if (( pri[b] < pri[a] || (pri[b] == pri[a] && rank[b] <= rank[a]) )); then
        break
      fi
      idx[$(( j + 1 ))]=$b
      j=$(( j - 1 ))
    done
    idx[$(( j + 1 ))]=$a
  done
  if (( n > cap )); then
    local keep=$(( cap - 1 )) # reserve one row for the "more chats" notice
    (( keep < pri0 )) && keep=$pri0
    DASH_DROPPED=$(( n - keep ))
    n=$keep
  fi
  local -a np=() na=() ns=() nt=()
  for (( i = 0; i < n; i++ )); do
    a=${idx[i]}
    np+=("${DASH_PANES[a]}")
    na+=("${DASH_AGENTS[a]}")
    ns+=("${DASH_STATUSES[a]}")
    nt+=("${DASH_TITLES[a]}")
  done
  DASH_PANES=("${np[@]}")
  DASH_AGENTS=("${na[@]}")
  DASH_STATUSES=("${ns[@]}")
  DASH_TITLES=("${nt[@]}")
}

# Keep the cursor on a rendered chat: after a resort or an overflow cap
# the previously selected pane may no longer be visible; snap to the
# first visible chat instead of aiming m/z at a hidden row.
dashboard_cursor_ensure() {
  local current="$1" i n=${#DASH_PANES[@]}
  if (( n == 0 )); then
    printf ''
    return 0
  fi
  for (( i = 0; i < n; i++ )); do
    if [[ "${DASH_PANES[i]}" == "$current" ]]; then
      printf '%s' "$current"
      return 0
    fi
  done
  printf '%s' "${DASH_PANES[0]}"
}

# Move the selection cursor inside the roster (delta +1 / -1, wrapping).
dashboard_step_cursor() {
  local current="$1" delta="$2"
  local n=${#DASH_PANES[@]}
  if (( n == 0 )); then
    printf '%s' "$current"
    return 0
  fi
  local idx i=0
  for (( idx = 0; idx < n; idx++ )); do
    if [[ "${DASH_PANES[$idx]}" == "$current" ]]; then
      i=$idx
      break
    fi
  done
  i=$(( (i + delta + n) % n ))
  printf '%s' "${DASH_PANES[$i]}"
}

# One screen of the dashboard. State reads reuse the existing gating
# helpers (load_snooze_state, is_playing, is_auto_muted) and fail open:
# a missing or corrupt state file renders "off / sin datos", never an error.
dashboard_render() {
  local selected="$1" msg="${2:-}" msg_time="${3:-}"
  local now
  now=$(date +%s)

  # v3.1: resolve the popup pty size and scale the padded field widths
  # before composing anything.
  dashboard_term_size
  dashboard_calc_widths "$DASH_COLS"
  local frame="" roster_fmt
  roster_fmt="║ %s%s%s %s %-${DASH_W_AGENT}s%s\033[0m"

  _dash_add '╔═══ 🎙️  herdr-tts · Panel de voz ════════════════════ %s ═╗' "$(date +%H:%M:%S)"

  # Single jq pass over the cached gate state: line 1 = global summary,
  # then one TSV row per tracked pane (muted, snooze_until, last event
  # seen by the debounce ledger + its timestamp). Everything sanitized
  # to numeric defaults so a hand-edited state file can't crash the loop.
  local state
  state=$(load_snooze_state)
  local g_until=0 f1 f2 f3 f4 f5
  local -A pane_muted pane_until pane_last_status pane_last_ts
  while IFS=$'\t' read -r f1 f2 f3 f4 f5; do
    if [[ "$f1" == "__GLOBAL__" ]]; then
      [[ "$f2" =~ ^[0-9]+$ ]] && g_until="$f2"
      continue
    fi
    [[ -z "$f1" ]] && continue
    [[ "$f2" == "true" ]] && pane_muted["$f1"]="true"
    [[ "$f3" =~ ^[0-9]+$ ]] && pane_until["$f1"]="$f3"
    [[ -n "$f4" && "$f4" != "-" ]] && pane_last_status["$f1"]="$f4"
    [[ "$f5" =~ ^[0-9]+$ ]] && pane_last_ts["$f1"]="$f5"
  done < <(jq -r '
    . as $root
    | (["__GLOBAL__", ((.global_snooze_until // 0)|tostring)] | @tsv),
      ((((.panes // {}) | keys) + (($root.debounce // {}) | keys) | unique) as $all
      | $all[]
      | . as $p
      | (($root.panes[$p].muted // false)|tostring) as $m
      | (($root.panes[$p].snooze_until // 0)|tostring) as $u
      | (($root.debounce[$p] // {}) | to_entries | sort_by(.value) | (last // {key:"-", value:0})) as $e
      | [ $p, $m, $u, ($e.key|tostring), ($e.value|tostring) ] | @tsv)
  ' <<<"$state" 2>/dev/null || true)

  if (( g_until > now )); then
    _dash_add '║ Global  😴 snooze GLOBAL activo · quedan %s (hasta %s)' \
      "$(fmt_mmss $(( g_until - now )))" "$(fmt_epoch_clock "$g_until")"
  else
    _dash_add '║ Global  ⚪ snooze global off · (Z cicla 5m → 30m → 2h → off)'
  fi

  # Motor line (v2): live IPC status when the engine answers — colored
  # state, mm:ss progress, provider/voice and a truncated text snippet.
  # Otherwise the v1 static lock-file fallback stays, upgraded with an
  # explicit "motor: no responde" fail-open note.
  local auto_label="🔊 activa"
  if is_auto_muted; then
    auto_label="🔇 silenciada"
  fi
  if [[ -n "${DASH_ENGINE_STATUS:-}" ]]; then
    local e_state e_pos e_total e_provider e_voice e_text e_color
    e_state=$(dashboard_engine_field "$DASH_ENGINE_STATUS" status)
    e_pos=$(dashboard_engine_field "$DASH_ENGINE_STATUS" pos)
    e_total=$(dashboard_engine_field "$DASH_ENGINE_STATUS" total)
    e_provider=$(dashboard_engine_field "$DASH_ENGINE_STATUS" provider)
    e_voice=$(dashboard_engine_field "$DASH_ENGINE_STATUS" voice)
    e_text=$(dashboard_engine_text "$DASH_ENGINE_STATUS")
    if ! [[ "$e_pos" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then e_pos=0; fi
    if ! [[ "$e_total" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then e_total=0; fi
    case "$e_state" in
      playing)      e_color=$'\033[32m' ;;
      paused)       e_color=$'\033[33m' ;;
      synthesizing) e_color=$'\033[36m' ;;
      *)            e_color=$'\033[90m' ;;
    esac
    _dash_add '║ Motor   %s%s · %s / %s · %s · %s · %.*s\033[0m · auto-lectura %s' \
      "$e_color" "$(dashboard_engine_state_label "$e_state")" \
      "$(fmt_mmss "${e_pos%%.*}")" "$(fmt_mmss "${e_total%%.*}")" \
      "${e_provider:-?}" "${e_voice:-?}" \
      "$DASH_W_SNIPPET" "${e_text:-—}" \
      "$auto_label"
  else
    local engine_label="⚪ En reposo"
    if is_playing; then
      engine_label="🔊 Reproduciendo"
    fi
    _dash_add '║ Motor   %s · motor: no responde · auto-lectura %s' "$engine_label" "$auto_label"
  fi
  _dash_add '║ Config  proveedor %s · voz %s (%s) · playback %s · debounce %ss' \
    "$TTS_PROVIDER" "$TTS_VOICE" "$TTS_RATE" "${TTS_PLAYBACK:-local}" "$TTS_DEBOUNCE_SECONDS"

  # v3.1 height budget: the frame may never exceed LINES-1 rows (the
  # last line's newline lands on the bottom row without scrolling).
  # Fixed cost is header + global + motor + config + roster header +
  # footer; under height pressure the history budget shrinks first
  # (24 → 0) and only then the roster cap drops oldest-idle chats —
  # needs-attention chats and the fixed lines are never sacrificed.
  # The scan runs before printing because the roster sort needs per-chat
  # audio recency and the cap needs the history row count.
  dashboard_scan_history
  local rows_cap=$(( DASH_LINES - 1 ))
  if (( rows_cap < 1 )); then rows_cap=1; fi
  local n=${#DASH_PANES[@]}
  local hist_budget=$DASHBOARD_HISTORY_BUDGET
  if (( hist_budget > DASH_HIST_ROWS_TOTAL )); then hist_budget=$DASH_HIST_ROWS_TOTAL; fi
  local fixed=6 # header + global + motor + config + roster header + footer
  if [[ -n "$msg" ]]; then fixed=$(( fixed + 1 )); fi
  local avail=$(( rows_cap - fixed ))
  local hist_header=0
  if (( hist_budget > 0 && avail >= 2 )); then
    hist_header=1
    avail=$(( avail - 1 ))
  fi
  if (( hist_budget + n > avail )); then
    hist_budget=$(( avail - n ))
    if (( hist_budget < 0 )); then hist_budget=0; fi
    if (( hist_budget == 0 && hist_header == 1 )); then
      hist_header=0
      avail=$(( avail + 1 ))
    fi
  fi
  dashboard_order_roster $(( avail - hist_budget ))
  n=${#DASH_PANES[@]} # the roster cap may have shrunk the visible roster

  _dash_add '╠═══ Chats (j/k mueve el cursor · m silencia · z snooze) ══════'
  local i pid agent st title marker color icon overlay overlay_lbl
  if (( n == 0 )); then
    _dash_add '║  (sin datos de herdr: CLI no disponible o sin agentes)'
  fi
  for (( i = 0; i < n; i++ )); do
    pid="${DASH_PANES[i]}"
    agent="${DASH_AGENTS[i]}"
    st="${DASH_STATUSES[i]}"
    title="${DASH_TITLES[i]}"
    marker="  "
    [[ "$pid" == "$selected" ]] && marker="▸ "
    # Agent state icon + color: needs-attention states first by design.
    case "$st" in
      working)      color=$'\033[32m'; icon="▶" ;;
      done|blocked) color=$'\033[33m'; icon="✔" ;;
      idle)         color=$'\033[90m'; icon="·" ;;
      *)            color=$'\033[90m'; icon="$st" ;; # unknown: literal value
    esac
    # Voice overlays appended after the agent kind: mute, active snooze
    # countdown, then the anti-spam (debounce) hold with its remaining
    # window. All three can stack on the same chat line.
    overlay=""
    if [[ "${pane_muted[$pid]:-false}" == "true" ]]; then
      overlay+=" 🔇"
    fi
    if (( ${pane_until[$pid]:-0} > now )); then
      printf -v overlay_lbl '%02d:%02d' \
        $(( (${pane_until[$pid]} - now) / 60 )) $(( (${pane_until[$pid]} - now) % 60 ))
      overlay+=" 😴 ${overlay_lbl}"
    fi
    if (( TTS_DEBOUNCE_SECONDS > 0 )) \
       && [[ -n "${pane_last_status[$pid]:-}" ]] \
       && (( now - ${pane_last_ts[$pid]:-0} < TTS_DEBOUNCE_SECONDS )); then
      overlay+=" ⏱$(( now - ${pane_last_ts[$pid]} ))s"
    fi
    dashboard_fit title "$title" "$DASH_W_ROSTER_TITLE"
    _dash_add "$roster_fmt" "$marker" "$color" "$icon" "$title" "$agent" "$overlay"
  done
  if (( DASH_DROPPED > 0 )); then
    _dash_add '║  … y %d chats más (los que piden atención nunca se ocultan)' "$DASH_DROPPED"
  fi

  # History grouped per chat (v3): header + last audios per group, newest
  # group first (the scan already ordered groups by last-audio recency).
  # Hidden when the ledger is empty OR when the height budget shrank it
  # away (hist_budget == 0).
  if (( hist_budget > 0 )); then
    _dash_add '╠═══ Historial por chat (más reciente arriba) ════════════════'
    local remaining=$hist_budget gi k ts epoch dur age_lbl dur_lbl gtitle gcount audio_word
    local rest hist_audio replay_marker
    local -a parts_arr=()
    for (( gi = 0; gi < ${#HIST_PANES[@]} && remaining > 0; gi++ )); do
      pid="${HIST_PANES[gi]}"
      gtitle="${DASH_TITLE_BY_PANE[$pid]:-}"
      # Closed panes (no agent-list entry anymore) keep their audio group,
      # labeled by pane id so the ledger never loses the thread.
      [[ -z "$gtitle" ]] && gtitle="$pid"
      gcount="${HIST_COUNTS[gi]}"
      audio_word="audios"
      (( gcount == 1 )) && audio_word="audio"
      epoch="${HIST_LASTEPOCH[gi]}"
      if [[ "$epoch" =~ ^[0-9]+$ ]]; then
        dashboard_fmt_age age_lbl $(( now - epoch ))
      else
        age_lbl="-"
      fi
      dashboard_fit gtitle "$gtitle" "$DASH_W_HIST_TITLE"
      _dash_add '║ ── %s · %d %s · último hace %s' "$gtitle" "$gcount" "$audio_word" "$age_lbl"
      remaining=$(( remaining - 1 ))
      # Last ≤3 audios, newest first (items are stored chronological as
      # iso|epoch|duration|path quads; path is "-" when the audio was
      # not persisted in the store).
      parts_arr=()
      IFS=';' read -r -a parts_arr <<< "${HIST_ITEMS[gi]%;}"
      for (( k = ${#parts_arr[@]} - 1; k >= 0 && remaining > 0; k-- )); do
        ts="${parts_arr[k]%%|*}"
        rest="${parts_arr[k]#*|}"         # epoch|dur|path
        epoch="${rest%%|*}"
        rest="${rest#*|}"                 # dur|path
        dur="${rest%%|*}"
        hist_audio="${rest#*|}"
        if [[ "$epoch" =~ ^[0-9]+$ ]]; then
          dashboard_fmt_age age_lbl $(( now - epoch ))
        else
          age_lbl="-"
        fi
        dashboard_fmt_dur dur_lbl "$dur"
        # ▶ marks audios that still exist in the store and can be replayed
        # from the palette. Builtin-only discipline: no subshell or command
        # substitution per row.
        replay_marker=""
        if [[ -n "$hist_audio" && "$hist_audio" != "-" && -f "$hist_audio" ]]; then
          replay_marker="▶ "
        fi
        _dash_add '║    · %s%s · hace %s' "$replay_marker" "$dur_lbl" "$age_lbl"
        remaining=$(( remaining - 1 ))
      done
    done
  fi

  _dash_add '╚═══ q salir · j/k chat · m silenciar · z snooze pane · Z snooze global · +/- velocidad ═╝'
  if [[ -n "$msg" ]]; then
    _dash_add '   » [%s] %s' "${msg_time:-}" "$msg"
  fi

  # v3.1 atomic repaint: ONE physical write per tick — cursor-home, the
  # whole frame, erase-below. No full-screen clear (which scrolled and
  # painted progressively) and no per-line output. A frame byte-identical
  # to the previous tick skips the write; the clock line is part of the
  # frame, so a live dashboard still redraws at ~1Hz while an idle one
  # stays perfectly still.
  if [[ "$frame" != "$DASH_LAST_FRAME" ]]; then
    printf '\033[H%s\033[J' "$frame"
    DASH_LAST_FRAME=$frame
  fi
}

# adjust_rate mutates TTS_RATE in its own process: when invoked from the
# key loop it runs in a command-substitution subshell, so the parent must
# adopt the value the function just persisted or repeated presses would
# all start from the stale session rate.
dashboard_sync_rate() {
  local new_rate
  new_rate=$(printf '%s' "$1" | grep -oE '^[^:]*: [+-][0-9]+%$' | grep -oE '[+-][0-9]+%' | head -n 1) || return 0
  [[ -n "$new_rate" ]] && TTS_RATE="$new_rate"
  return 0
}

# Entry point of the dashboard pane. The key loop doubles as the refresh
# loop: `read -t 1` waits up to one second for a key, so an idle dashboard
# redraws at ~1Hz while keypresses are handled instantly. Only the chat
# roster and the engine status hit external processes, both on the same
# every-N-ticks cache cadence; the history scan is one tail + one jq pass
# per tick and everything else is local, fork-free bash.
run_dashboard() {
  local refresh_secs="${HERDR_TTS_DASHBOARD_REFRESH:-1}"
  local selected="" msg="" msg_time="" key="" rc=0 tick=0
  local -a DASH_PANES=() DASH_AGENTS=() DASH_STATUSES=() DASH_TITLES=()
  local DASH_ENGINE_STATUS=""

  trap dashboard_cleanup EXIT
  trap 'exit 0' INT TERM
  printf '\033[?25l'

  while true; do
    if (( tick % DASHBOARD_ROSTER_REFRESH_TICKS == 0 )) || (( ${#DASH_PANES[@]} == 0 )); then
      dashboard_refresh_roster
    fi
    if (( tick % DASHBOARD_ENGINE_REFRESH_TICKS == 0 )); then
      dashboard_refresh_engine
    fi
    tick=$(( tick + 1 ))

    if [[ -z "$selected" ]] && (( ${#DASH_PANES[@]} > 0 )); then
      selected="${DASH_PANES[0]}"
    fi

    dashboard_render "$selected" "$msg" "$msg_time"
    msg="" msg_time=""
    # The render may have re-sorted or overflow-capped the roster; keep
    # the cursor on a chat that is actually on screen so m/z never fire
    # against a hidden row.
    selected=$(dashboard_cursor_ensure "$selected")

    rc=0
    key=""
    read -rsn1 -t "$refresh_secs" key || rc=$?
    if (( rc == 1 )); then
      break # stdin closed: leave instead of spinning on EOF
    fi
    case "$key" in
      q|Q) break ;;
      j|J) selected=$(dashboard_step_cursor "$selected" 1) ;;
      k|K) selected=$(dashboard_step_cursor "$selected" -1) ;;
      m|M)
        msg=$(toggle_pane_mute "$selected" 2>&1 || true)
        msg="${msg%%$'\n'*}"; msg_time=$(date +%H:%M:%S)
        ;;
      z)
        msg=$(cycle_snooze pane "$selected" 2>&1 || true)
        msg="${msg%%$'\n'*}"; msg_time=$(date +%H:%M:%S)
        ;;
      Z)
        msg=$(cycle_snooze global 2>&1 || true)
        msg="${msg%%$'\n'*}"; msg_time=$(date +%H:%M:%S)
        ;;
      +|=)
        msg=$(adjust_rate 10 2>&1 || true)
        dashboard_sync_rate "$msg"
        msg="${msg%%$'\n'*}"; msg_time=$(date +%H:%M:%S)
        ;;
      -|_)
        msg=$(adjust_rate -10 2>&1 || true)
        dashboard_sync_rate "$msg"
        msg="${msg%%$'\n'*}"; msg_time=$(date +%H:%M:%S)
        ;;
      *) ;; # ignore anything else (arrow escapes, modifiers, ...)
    esac
  done

  dashboard_cleanup
  trap - EXIT INT TERM
}

# ─── Voice palette (v0.11, fzf popup) ────────────────────────
# `--voice-palette` renders an fzf picker inside a Herdr popup pane with
# one entry per audio turn (newest first, from the history ledger) plus
# one entry per agent chat with zero audios. Snapshot per open: no live
# loop. Accept focuses the chat; ctrl-m / ctrl-z apply mute / snooze to
# the selected pane through the existing CLI flags (they accept an
# optional explicit pane id) and exit without focusing anything.

PALETTE_TITLE_CHARS=35         # chat title cap in the entry line
PALETTE_SNIPPET_CHARS=60       # snippet cap in the entry line
PALETTE_HISTORY_SCAN_LINES=400 # ledger tail scanned per palette open

palette_trunc() { # <out-var> <string> <width> — truncate with ellipsis, no padding
  local _pt_s="$2" _pt_w="$3"
  if (( ${#_pt_s} > _pt_w )); then
    _pt_s="${_pt_s:0:_pt_w-1}…"
  fi
  printf -v "$1" '%s' "$_pt_s"
}

# Reversed history rows (newest first) as TSV: hhmm, pane, dur, snippet,
# epoch, audio path. ONE python pass (same interpreter as the dashboard
# scan) because datetime applies per-date DST rules to the epoch column,
# which a hand-rolled calendar cannot. Legacy 4-field rows yield snippet
# "-" and path "-". Fails open: no file, no python or corrupt rows →
# empty output.
palette_history_rows() { # [scan_lines] (omit = whole ledger)
  local cap="${1:-}" input_lines
  [[ -s "$HISTORY_FILE" ]] || return 0
  if [[ -n "$cap" ]]; then
    input_lines=$(tail -n "$cap" "$HISTORY_FILE" 2>/dev/null) || return 0
  else
    input_lines=$(cat "$HISTORY_FILE" 2>/dev/null) || return 0
  fi
  [[ -z "$input_lines" ]] && return 0
  printf '%s\n' "$input_lines" | "$VENV_PYTHON" -c '
import sys
from datetime import datetime

rows = []
for line in sys.stdin.read().split("\n"):
    f = line.split("\t")
    if len(f) < 4 or not f[1]:
        continue
    ts, pane, dur = f[0], f[1], f[3]
    snippet = f[4] if len(f) > 4 and f[4] else "-"
    path = f[5] if len(f) > 5 and f[5] else "-"
    hhmm = ts[11:16] if len(ts) >= 16 else "??:??"
    try:
        epoch = str(int(datetime.fromisoformat(ts).timestamp()))
    except ValueError:
        epoch = "0"
    rows.append("\t".join([hhmm, pane, dur, snippet, epoch, path]))
sys.stdout.write("".join(r + "\n" for r in reversed(rows)))
' 2>/dev/null || return 0
}

# Palette entries, one per line: display field + tab-delimited hidden
# fields (<pane_id> <ts_epoch> <audio_path>, or <pane_id> "chat" "-" for
# zero-audio rows). Audio turns come newest first; zero-audio chats
# follow in agent-list order. Prints to stdout so the smoke battery can
# diff the format.
palette_build_entries() {
  local -A p_title=()
  local -a p_order=()
  local raw pid title
  raw=$(herdr agent list 2>/dev/null) || raw=""
  if [[ -n "$raw" ]]; then
    while IFS=$'\t' read -r pid title; do
      [[ -z "$pid" || "$pid" == "null" ]] && continue
      p_title["$pid"]="${title:-$pid}"
      p_order+=("$pid")
    done < <(printf '%s' "$raw" | jq -r '
        .result.agents[]?
        | "\(.pane_id // "")\t\((.terminal_title_stripped // .terminal_title // "") | gsub("[\\t\\r\\n]"; " "))"
      ' 2>/dev/null || true)
  fi

  local -a entries=()
  local -A has_audio=()
  local hhmm pane dur snippet epoch path line chat_title dur_lbl
  while IFS=$'\t' read -r hhmm pane dur snippet epoch path; do
    [[ -z "$pane" ]] && continue
    has_audio["$pane"]=1
    chat_title="${p_title[$pane]:-$pane}"
    palette_trunc chat_title "$chat_title" "$PALETTE_TITLE_CHARS"
    palette_trunc snippet "$snippet" "$PALETTE_SNIPPET_CHARS"
    dashboard_fmt_dur dur_lbl "$dur"
    # 4 hidden positional fields: pane, epoch, stored-audio path — fzf
    # {4} feeds the ctrl-r replay bind; "-" when nothing was stored.
    printf -v line '%s · %s · %s · %s\t%s\t%s\t%s' "$hhmm" "$chat_title" "$dur_lbl" "$snippet" "$pane" "$epoch" "$path"
    entries+=("$line")
  done < <(palette_history_rows "$PALETTE_HISTORY_SCAN_LINES")

  local pid2
  for pid2 in ${p_order[@]+"${p_order[@]}"}; do
    [[ -n "${has_audio[$pid2]:-}" ]] && continue
    chat_title="${p_title[$pid2]:-$pid2}"
    palette_trunc chat_title "$chat_title" "$PALETTE_TITLE_CHARS"
    # Trailing "-" keeps fzf {4} positional stability across all rows.
    entries+=("(sin audios) · ${chat_title}"$'\t'"${pid2}"$'\t'"chat"$'\t'"-")
  done

  local e
  for e in ${entries[@]+"${entries[@]}"}; do
    printf '%s\n' "$e"
  done
  return 0
}

run_voice_palette() {
  if ! command -v fzf >/dev/null 2>&1; then
    echo "❌ fzf no está instalado: la paleta de voz lo necesita para funcionar" >&2
    echo "   Instálalo (p. ej. 'sudo apt install fzf' o 'brew install fzf') y vuelve a abrirla." >&2
    return 1
  fi

  local -a entries=()
  mapfile -t entries < <(palette_build_entries)
  if (( ${#entries[@]} == 0 )); then
    echo "ℹ️ Sin chats ni audios que mostrar en la paleta"
    return 0
  fi

  local sel pane_id
  # Snapshot-per-open: fzf exits on accept (enter / ctrl-o) or on the
  # ctrl-m / ctrl-z / ctrl-r actions (execute-silent applies the mutation
  # or the stored-audio replay through the CLI flags and abort skips the
  # accept path entirely).
  sel=$(printf '%s\n' "${entries[@]}" | fzf \
    --delimiter '\t' \
    --with-nth 1 \
    --reverse \
    --height 100% \
    --header 'enter/ctrl-o: enfocar chat · ctrl-m: silenciar pane · ctrl-z: snooze pane · ctrl-r: reproducir audio · esc: salir' \
    --preview "'$SCRIPT' --palette-preview {2}" \
    --preview-window 'right:50%:wrap' \
    --bind 'ctrl-o:accept' \
    --bind "ctrl-m:execute-silent('$SCRIPT' --mute-pane {2})+abort" \
    --bind "ctrl-z:execute-silent('$SCRIPT' --snooze-pane {2})+abort" \
    --bind "ctrl-r:execute-silent('$SCRIPT' --play-file {4})+abort") || return 0

  pane_id=$(printf '%s' "$sel" | cut -f2)
  [[ -z "$pane_id" ]] && return 0
  herdr pane focus "$pane_id" >/dev/null 2>&1 || true
  echo "🎯 Chat ${pane_id} enfocado (la paleta se cierra en 2s)"
  sleep 2
  return 0
}

# fzf preview helper: chat header (title, agent+state, voice gating) plus
# ALL history turns of the pane, newest first. Fails open everywhere.
palette_preview() { # <pane_id>
  local pane_id="${1:-}"
  if [[ -z "$pane_id" ]]; then
    echo "Uso: herdr-tts --palette-preview <pane_id>" >&2
    return 1
  fi

  # Chat header: title/agent/status from the agent roster (fail-open: no
  # herdr CLI still renders the pane id and an explicit note).
  local raw="" pid agent st title=""
  raw=$(herdr agent list 2>/dev/null) || raw=""
  if [[ -n "$raw" ]]; then
    while IFS=$'\t' read -r pid agent st title; do
      if [[ "$pid" == "$pane_id" ]]; then
        break
      fi
      title=""
    done < <(printf '%s' "$raw" | jq -r '
        .result.agents[]?
        | "\(.pane_id // "")\t\(.agent // "")\t\(.agent_status // "")\t\((.terminal_title_stripped // .terminal_title // "") | gsub("[\\t\\r\\n]"; " "))"
      ' 2>/dev/null || true)
  fi
  [[ -z "$title" ]] && title="$pane_id"
  echo "📌 ${title}"
  if [[ -z "$raw" ]]; then
    echo "   ⚠️ herdr CLI no disponible (sin datos de agente)"
  else
    echo "   agente: ${agent:-?} · estado: ${st:-?}"
  fi

  # Voice gating state for the pane, mirroring the dashboard overlays.
  local now state muted until_ts last_status last_ts gate=""
  now=$(date +%s)
  state=$(load_snooze_state)
  muted=$(jq -r --arg p "$pane_id" '(.panes[$p].muted // false)' <<<"$state" 2>/dev/null) || muted=false
  until_ts=$(jq -r --arg p "$pane_id" '(.panes[$p].snooze_until // 0)' <<<"$state" 2>/dev/null) || until_ts=0
  last_status=$(jq -r --arg p "$pane_id" \
    '(.debounce[$p] // {} | to_entries | sort_by(.value) | (last // {key:"",value:0}).key)' \
    <<<"$state" 2>/dev/null) || last_status=""
  last_ts=$(jq -r --arg p "$pane_id" \
    '(.debounce[$p] // {} | to_entries | sort_by(.value) | (last // {key:"",value:0}).value)' \
    <<<"$state" 2>/dev/null) || last_ts=0
  if [[ "$muted" == "true" ]]; then
    gate="🔇 silenciado"
  fi
  if [[ "$until_ts" =~ ^[0-9]+$ ]] && (( until_ts > now )); then
    gate+="${gate:+ · }😴 snooze $(fmt_mmss $(( until_ts - now ))) restantes (hasta $(fmt_epoch_clock "$until_ts"))"
  fi
  if (( TTS_DEBOUNCE_SECONDS > 0 )) \
     && [[ -n "$last_status" && "$last_status" != "null" ]] \
     && [[ "$last_ts" =~ ^[0-9]+$ ]] \
     && (( now - last_ts < TTS_DEBOUNCE_SECONDS )); then
    gate+="${gate:+ · }⏱ debounce activo ($(( TTS_DEBOUNCE_SECONDS - (now - last_ts) ))s)"
  fi
  [[ -z "$gate" ]] && gate="🔊 voz activa"
  echo "   gating: ${gate}"
  echo

  echo "── Turnos de audio (recientes primero) ──"
  local hhmm pid dur snippet epoch path dur_lbl n=0
  # The explicit 6th read var matters: without it `epoch` would absorb
  # "epoch<TAB>path" as the trailing remainder and corrupt the display.
  while IFS=$'\t' read -r hhmm pid dur snippet epoch path; do
    [[ "$pid" != "$pane_id" ]] && continue
    dashboard_fmt_dur dur_lbl "$dur"
    echo "${hhmm} · ${dur_lbl} · ${snippet}"
    n=$(( n + 1 ))
  done < <(palette_history_rows) # whole ledger, newest first
  if (( n == 0 )); then
    echo "sin turnos"
  fi
  return 0
}

# ─── Voice menu (v0.12, one-key popup) ───────────────────────
# Herdr core has no key sequences: every binding is a single prefix+X
# chord, so a literal "prefix + namespace + command" chain cannot be
# expressed. The voice menu simulates it with ONE free core letter
# (suggested binding: prefix+u → the open-menu action): the popup
# renders a static cheat sheet, reads exactly one key and dispatches it
# to the same functions/flags the CLI flags, the palette and the
# dashboard already use (no explicit pane id → focused pane, the same
# default as --mute-pane / --snooze-pane). Herdr closes a popup when
# its command exits, so one key = one action = popup closes = focus
# restored. v0.15: the settings popup lives INSIDE the menu as a second
# view (key `a`), so the settings never spend a core chord of their own.

MENU_CONFIRM_SECS="${HERDR_TTS_MENU_CONFIRM_SECS:-1.5}"
[[ "$MENU_CONFIRM_SECS" =~ ^[0-9]+([.][0-9]+)?$ ]] || MENU_CONFIRM_SECS=1.5

# Herdr allows ONE popup pane at a time (server replies ui_busy: "a popup
# pane is already open"). The menu IS a popup, so opening the dashboard or
# palette from a menu key fails while the menu is still alive — the old
# fire-and-forget call was silently swallowed and the user only saw the
# menu close. Two traps handled here:
#   1. The popup slot is busy until the menu exits → retry every 0.1s.
#   2. Herdr kills the popup's PROCESS GROUP on exit → a plain disowned
#      subshell dies with the menu before it can succeed (observed live:
#      no success, no exhausted-retries log line). The retry loop must run
#      in its OWN SESSION (setsid) to survive the teardown.
# Every attempt outcome is logged (ok with attempt number, or exhausted),
# never silently dropped.
MENU_OPEN_LOG="${HERDR_TTS_MENU_OPEN_LOG:-/tmp/herdr-tts-menu.log}"
MENU_OPEN_RETRIES="${HERDR_TTS_MENU_OPEN_RETRIES:-50}" # × 0.1s = 5s ceiling

_menu_open_retry() { # <entrypoint> — runs inside the detached session
  local entry="$1" log="${HERDR_TTS_MENU_OPEN_LOG:-/tmp/herdr-tts-menu.log}"
  local max="${HERDR_TTS_MENU_OPEN_RETRIES:-50}" err="" i=0
  while (( i < max )); do
    if err=$(herdr plugin pane open --plugin herdr.tts --entrypoint "$entry" 2>&1); then
      printf '[%s] [menu] open %s: ok (intento %d)\n' \
        "$(date +%H:%M:%S)" "$entry" "$(( i + 1 ))" >> "$log"
      return 0
    fi
    sleep 0.1
    i=$(( i + 1 ))
  done
  printf '[%s] [menu] open %s falló tras %s intentos: %s\n' \
    "$(date +%H:%M:%S)" "$entry" "$max" "${err:-sin salida}" >> "$log"
  return 1
}

menu_open_after_exit() { # <entrypoint>
  export -f _menu_open_retry 2>/dev/null || true
  if command -v setsid >/dev/null 2>&1; then
    HERDR_TTS_MENU_OPEN_LOG="$MENU_OPEN_LOG" HERDR_TTS_MENU_OPEN_RETRIES="$MENU_OPEN_RETRIES" \
      setsid bash -c '_menu_open_retry "$@"' _ "$1" >/dev/null 2>&1 </dev/null &
  else
    # macOS: no setsid — legacy background subshell (best effort).
    HERDR_TTS_MENU_OPEN_LOG="$MENU_OPEN_LOG" HERDR_TTS_MENU_OPEN_RETRIES="$MENU_OPEN_RETRIES" \
      bash -c '_menu_open_retry "$@"' _ "$1" >/dev/null 2>&1 </dev/null &
  fi
  disown 2>/dev/null || true
  return 0
}

# Cheat-sheet data: two columns of key + description, zipped at render
# time. Static on purpose — the menu never queries Herdr, so the frame
# costs nothing and is always a single physical write.
MENU_L_KEYS=("r" "p" "s" "t" "v" "[" "]" "n" "N")
MENU_L_DESC=("▶ Play / Stop del chat enfocado" "⏸ Pausar / Reanudar" "⏹ Stop inmediato" "⚡ TL;DR del chat" "🔊 Auto-lectura on/off" "⏪ Rebobinar 10s" "⏩ Avanzar 10s" "⏭ Frase siguiente" "⏮ Frase anterior")
MENU_R_KEYS=("m" "z" "Z" "+/-" "d" "o" "a" "q/Esc")
MENU_R_DESC=("🔇 Mute pane" "😴 Snooze pane" "😴 Snooze GLOBAL" "🎙 Velocidad ±10%" "📊 Dashboard" "🎛️ Paleta de voz" "⚙️ Ajustes de voz y audio" "Salir del menú")

# Height cap: keep at most <max-rows> lines of the buffered frame, the
# same LINES-1 discipline the dashboard render enforces.
menu_cap_rows() { # <max-rows>
  local max_rows="$1" rest="$frame" line
  frame=""
  while [[ -n "$rest" ]]; do
    if (( max_rows <= 0 )); then break; fi
    line="${rest%%$'\n'*}"
    frame+="$line"$'\n'
    max_rows=$(( max_rows - 1 ))
    if [[ "$rest" == *$'\n'* ]]; then rest="${rest#*$'\n'}"; else rest=""; fi
  done
}

# ONE static frame, ONE physical write: reuses the dashboard render
# helpers verbatim — dashboard_term_size (popup pty → DASH_LINES /
# DASH_COLS with a validated 40x100 fallback) and _dash_add (per-line
# visible-width clamp via dashboard_clamp_line). No clamp logic here.
menu_render() {
  dashboard_term_size
  local frame="" row_l half i kl dl kr dr
  half=$(( DASH_COLS / 2 - 2 ))
  (( half < 20 )) && half=20
  _dash_add $'\e[1m⌨️  herdr-tts · Menú de voz\e[0m'
  _dash_add 'Pulsa UNA tecla: la acción se ejecuta y el menú se cierra (a = ajustes, sin cerrar).'
  _dash_add ''
  for (( i = 0; i < ${#MENU_L_KEYS[@]} || i < ${#MENU_R_KEYS[@]}; i++ )); do
    kl="${MENU_L_KEYS[i]:-}"; dl="${MENU_L_DESC[i]:-}"
    kr="${MENU_R_KEYS[i]:-}"; dr="${MENU_R_DESC[i]:-}"
    dashboard_fit row_l " ${kl}  ${dl}" "$half"
    _dash_add '%s│ %s  %s' "$row_l" "$kr" "$dr"
  done
  menu_cap_rows $(( DASH_LINES - 1 ))
  # ESC[K per line: the popup alternates frames of different widths, and
  # ESC[J only clears BELOW the cursor — without per-line erase, the tails
  # of a wider previous frame survive to the right of shorter lines.
  printf '\033[H%s\033[K\033[J' "${frame//$'\n'/$'\033[K\n'}"
}

# One key → one action, always through the EXISTING implementation path
# (the exact functions/flags the CLI cases call). Command substitution
# keeps the functions in a subshell, like the dashboard key loop does.
# Returns 1 on an unrecognized key; MENU_RESULT carries the first line
# of the action's output for the one-line confirmation.
menu_dispatch() { # <key>
  MENU_RESULT=""
  local out=""
  case "$1" in
    r|R) out=$(toggle_play 2>&1 || true) ;;
    p|P) out=$(toggle_pause_audio 2>&1 || true) ;;
    s|S) out=$(stop_audio 2>&1 || true) ;;
    t|T) out=$(read_current_pane "" "--tldr" 2>&1 || true) ;;
    v|V) out=$(toggle_auto 2>&1 || true) ;;
    "[") out=$(seek_audio -10 2>&1 || true) ;;
    "]") out=$(seek_audio +10 2>&1 || true) ;;
    n)   out=$(next_sentence_audio 2>&1 || true) ;;
    N)   out=$(prev_sentence_audio 2>&1 || true) ;;
    m|M) out=$(toggle_pane_mute 2>&1 || true) ;;
    z)   out=$(cycle_snooze pane 2>&1 || true) ;;
    Z)   out=$(cycle_snooze global 2>&1 || true) ;;
    +|=) out=$(adjust_rate 10 2>&1 || true) ;;
    -|_) out=$(adjust_rate -10 2>&1 || true) ;;
    d|D)
      menu_open_after_exit tts-dashboard
      out="📊 Cerrando el menú y abriendo el dashboard…"
      ;;
    o|O)
      menu_open_after_exit tts-palette
      out="🎛️ Cerrando el menú y abriendo la paleta de voz…"
      ;;
    *) return 1 ;;
  esac
  out="${out%%$'\n'*}"
  MENU_RESULT="${out:-Comando de voz ejecutado}"
  return 0
}

# Popup entrypoint: a two-view input loop. The MAIN view renders once,
# reads ONE key and confirms briefly: one key = one action = popup closes
# = focus restored (the ~1.5s dwell lets the confirmation be read).
# Pressing `a` switches to the SETTINGS view (the same frame the
# standalone settings popup renders): p/d/r cycle + persist a knob, R
# restarts the daemon, and q/Esc/Enter returns to the MAIN view — a
# re-render, not an exit.
# Fail-open: EOF / read failure (no tty, closed pipe) → exit 0 silently
# from either view. q/Esc in the main view exits without a message.
# Note: an arrow key sends its ESC prefix byte first, so it quits the
# menu — deliberate, matching the dashboard's "ignore exotic input" stance.
run_voice_menu() {
  local key="" view="main"
  while :; do
    if [[ "$view" == "settings" ]]; then
      settings_render
      # Clear AFTER the render: a warning or note set by the previous
      # keypress is visible on exactly the render that reports it (same
      # discipline as the standalone settings popup).
      SETTINGS_WARN=""
      SETTINGS_NOTE=""
      if ! read -rsn1 key; then
        exit 0 # EOF: fail-open, nothing changed by us
      fi
      if settings_handle_key "$key"; then
        continue # re-render with the new value (or the inline warning)
      fi
      view="main" # q / Esc / Enter → back to the main view, still inside the popup
      continue
    fi
    menu_render # one static frame, one physical write — then a single read
    if ! read -rsn1 key; then
      exit 0
    fi
    case "$key" in
      q|Q|$'\e')
        exit 0 # silent exit
        ;;
      a|A)
        view="settings" # Ajustes live inside the menu: no extra chord spent
        ;;
      *)
        if menu_dispatch "$key"; then
          # Leading newline: the frame write leaves the cursor right after
          # the last row, so the confirmation must claim a fresh line.
          printf '\n✓ %s\n' "$MENU_RESULT"
        else
          printf '\n❓ Tecla no reconocida (%s) — pulsa q para salir\n' "$key"
        fi
        sleep "$MENU_CONFIRM_SECS"
        exit 0 # one key = one action = popup closes
        ;;
    esac
  done
}

# ─── Voice settings popup (v0.15, cycle knobs) ───────────────
# One popup for the optional knobs: TTS provider, playback target,
# audio-retention days and the done settle window, plus the web redirect
# (w: free-text URL, empty clears; c: click-directo on/off). Cycle keys
# advance to the NEXT entry of their table and persist it through
# config_set (managed-key writer above). Values shown come from the live
# env the script sourced from config.env at startup; changes reach NEW
# processes only.

# Cycle tables: ordered, first element = the recommended default.
SETTINGS_PROVIDERS=(edge openai elevenlabs piper kokoro) # edge first = gratuito, por defecto
SETTINGS_TARGETS=(local winhost wsl-ps windows auto)
SETTINGS_RETENTION=(0 1 3 7 14) # 0 = retención apagada
SETTINGS_SETTLE=(0 2 5 10 15 30) # 0 = notifica al instante (sin ventana)

# Print the NEXT value of a cycle table. Pure and fork-free (no subshell
# spawns): safe to call per keypress. An unknown current value (user
# hand-edited config) restarts at the first element.
settings_cycle_value() { # <provider|target|retention|settle> <current> → next value on stdout
  local -a vals=()
  local cur="$2" i n
  case "$1" in
    provider)  vals=("${SETTINGS_PROVIDERS[@]}") ;;
    target)    vals=("${SETTINGS_TARGETS[@]}") ;;
    retention) vals=("${SETTINGS_RETENTION[@]}") ;;
    settle)    vals=("${SETTINGS_SETTLE[@]}") ;;
    *) echo "settings_cycle_value: unknown key '${1}' (provider, target, retention or settle)" >&2; return 1 ;;
  esac
  n=${#vals[@]}
  for (( i = 0; i < n; i++ )); do
    if [[ "${vals[i]}" == "$cur" ]]; then
      printf '%s\n' "${vals[$(( (i + 1) % n ))]}"
      return 0
    fi
  done
  printf '%s\n' "${vals[0]}"
}

# One settings keypress, shared by the standalone popup (run_voice_settings)
# and the settings view inside run_voice_menu: cycles the matching knob to
# the NEXT value of its table, persists it through config_set and updates
# the live env; a write failure keeps the old value and sets SETTINGS_WARN
# (rendered inline by the next frame), as does an unrecognized key.
# Uppercase R (case-sensitive on purpose, distinct from the r cycle) calls
# daemon_restart: on success it sets SETTINGS_NOTE, on a failed spawn it
# sets SETTINGS_WARN — both render inline on the next frame.
# w reads one free-text line from the popup pane (a real terminal): the
# URL persists to WEB_URL + COLLIE_URL verbatim ({pane_id} placeholder
# included) and an empty line clears the redirect (and the label), while
# a collie URL seeds WEB_LABEL="Collie" when it is still unset. c toggles
# CLICK_REDIRECT on/off; both notes mirror the CLI wording.
# Returns 1 when the key closes the view (q / Esc / Enter); any other key
# returns 0 so the caller re-renders.
settings_handle_key() { # <key>
  local key="$1" next=""
  case "$key" in
    q|Q|$'\e'|"")
      return 1
      ;;
    p|P)
      next="$(settings_cycle_value provider "$TTS_PROVIDER")"
      if config_set TTS_PROVIDER "$next"; then
        TTS_PROVIDER="$next"
      else
        SETTINGS_WARN="No se pudo guardar TTS_PROVIDER en config.env"
      fi
      ;;
    d|D)
      next="$(settings_cycle_value target "$TTS_PLAYBACK")"
      if config_set TTS_PLAYBACK "$next"; then
        TTS_PLAYBACK="$next"
      else
        SETTINGS_WARN="No se pudo guardar TTS_PLAYBACK en config.env"
      fi
      ;;
    r)
      local cur_ret
      config_get_retention_raw cur_ret
      next="$(settings_cycle_value retention "${cur_ret:-0}")"
      if config_set HERDR_TTS_AUDIO_RETENTION_DAYS "$next"; then
        HERDR_TTS_AUDIO_RETENTION_DAYS="$next"
      else
        SETTINGS_WARN="No se pudo guardar HERDR_TTS_AUDIO_RETENTION_DAYS en config.env"
      fi
      ;;
    s|S)
      next="$(settings_cycle_value settle "$TTS_SETTLE_SECONDS")"
      if config_set TTS_SETTLE_SECONDS "$next"; then
        TTS_SETTLE_SECONDS="$next"
      else
        SETTINGS_WARN="No se pudo guardar TTS_SETTLE_SECONDS en config.env"
      fi
      ;;
    w|W)
      # Free-text input inside the popup (a real terminal): one line is the
      # URL, an empty line clears the redirect. Persisted through the managed
      # writer like every other key: WEB_URL and COLLIE_URL ride together
      # (same pair the CLI --web-url path writes), and a collie URL seeds
      # WEB_LABEL="Collie" while it is still unset. The {pane_id}
      # placeholder is stored verbatim — send_ntfy_push expands it.
      local new_url=""
      printf '\n URL de redirección web\n   ej.: https://collie.midominio.com/chat/{pane_id}\n   sin {pane_id} se añade /pane/<id> · Enter vacío = desactivar\n > '
      if ! read -r new_url; then
        SETTINGS_WARN="Entrada cancelada: no se pudo leer la URL"
        return 0
      fi
      if [[ -z "$new_url" ]]; then
        if config_set WEB_URL "" && config_set COLLIE_URL "" && config_set WEB_LABEL ""; then
          WEB_URL=""
          COLLIE_URL=""
          WEB_LABEL=""
          SETTINGS_NOTE="✓ Redirección web desactivada (notificaciones estándar sin URL externa)"
        else
          SETTINGS_WARN="No se pudo guardar WEB_URL en config.env"
        fi
      else
        if config_set WEB_URL "$new_url" && config_set COLLIE_URL "$new_url"; then
          WEB_URL="$new_url"
          COLLIE_URL="$new_url"
          if [[ "${new_url,,}" =~ collie && -z "$WEB_LABEL" ]] && config_set WEB_LABEL "Collie"; then
            WEB_LABEL="Collie"
          fi
          SETTINGS_NOTE="✓ URL de redirección configurada: ${new_url}"
        else
          SETTINGS_WARN="No se pudo guardar WEB_URL en config.env"
        fi
      fi
      ;;
    c|C)
      # Click directo: ntfy Click header (tocar la tarjeta abre el navegador).
      # on/off cycle; the notes mirror the CLI --click-redirect wording.
      if [[ "$CLICK_REDIRECT" == "on" ]]; then
        next="off"
      else
        next="on"
      fi
      if config_set CLICK_REDIRECT "$next"; then
        CLICK_REDIRECT="$next"
        if [[ "$next" == "on" ]]; then
          SETTINGS_NOTE="✓ Click directo activado (abrirá navegador al pulsar la tarjeta de notificación)"
        else
          SETTINGS_NOTE="✓ Click directo desactivado (pulsar la tarjeta abrirá ntfy con reproductor; el botón abrirá web)"
        fi
      else
        SETTINGS_WARN="No se pudo guardar CLICK_REDIRECT en config.env"
      fi
      ;;
    v|V)
      # Auto-lectura de fondo on/off. The auto_muted marker stays the
      # single source of truth (the daemon stats the live file on every
      # event, so this applies al vuelo — no daemon restart needed, no
      # config.env key). The toggle here is silent on purpose: the voice
      # menu `v` is the one that speaks the spoken confirmation.
      if is_auto_muted; then
        if rm -f "$AUTO_MUTE_FILE"; then
          SETTINGS_NOTE="✓ Auto-lectura activada (te lee al terminar cada agente)"
        else
          SETTINGS_WARN="No se pudo eliminar ${AUTO_MUTE_FILE}"
        fi
      else
        if touch "$AUTO_MUTE_FILE"; then
          SETTINGS_NOTE="✓ Auto-lectura silenciada (solo manual: prefix+r / htr bajo demanda)"
        else
          SETTINGS_WARN="No se pudo crear ${AUTO_MUTE_FILE}"
        fi
      fi
      ;;
    R)
      # Restart the daemon in place: applies pending p/d/s changes without
      # leaving the view. Uppercase by design (lowercase r cycles retention).
      if daemon_restart; then
        SETTINGS_NOTE="✓ Daemon reiniciado"
      else
        SETTINGS_WARN="No se pudo relanzar el daemon"
      fi
      ;;
    *)
      SETTINGS_WARN="Tecla no reconocida (${key}) — p/d/r/s cicla un ajuste, v auto-lectura, w URL web, c click directo, q sale"
      ;;
  esac
  return 0
}

# ONE static frame, ONE physical write per render: same discipline as
# menu_render (dashboard_term_size + _dash_add clamping reused verbatim,
# frame buffered and written once). SETTINGS_WARN, when set, renders as
# a bottom status row just above the exit hint; SETTINGS_NOTE (e.g.
# the daemon-restart confirmation) renders right after it.
settings_render() {
  dashboard_term_size
  # Retention current comes from the tiered read (env > live file), NOT
  # from the neutralized startup variable: after the loader unsets it,
  # the file is the only source of truth for what the user last chose.
  local frame="" ret
  config_get_retention_raw ret
  ret="${ret:-0}"
  _dash_add $'\e[1m⚙️  herdr-tts · Ajustes de voz y audio\e[0m'
  _dash_add 'Pulsa la tecla del ajuste para ciclar su valor.'
  _dash_add ''
  _dash_add ' p  Proveedor TTS:        %s   (edge = gratuito, por defecto)' "$TTS_PROVIDER"
  # Install hint only for providers that need a local model; as an
  # annotation it belongs directly under the row it qualifies.
  if [[ "$TTS_PROVIDER" == "piper" || "$TTS_PROVIDER" == "kokoro" ]]; then
    _dash_add '    ⚠️  Requiere instalar el modelo antes: agent-tts voice install %s' "$TTS_PROVIDER"
  fi
  local auto_label="🔊 activa (te lee al terminar cada agente)"
  is_auto_muted && auto_label="🔇 silenciada (solo manual: prefix+r / htr bajo demanda)"
  _dash_add ' v  Auto-lectura:         %s' "$auto_label"
  _dash_add ' d  Destino reproducción: %s' "$TTS_PLAYBACK"
  _dash_add ' r  Audio retenido:       %s días   (0 = apagado)' "$ret"
  _dash_add ' s  Asentamiento done:    %ss   (0 = notifica al instante)' "$TTS_SETTLE_SECONDS"
  _dash_add ' w  Redirección web:      %s   (Enter vacío en w = desactiva)' "${WEB_URL:-Desactivada}"
  _dash_add ' c  Click directo:        %s   (on = navegador, off = reproductor)' "$CLICK_REDIRECT"
  _dash_add ''
  _dash_add ' r  cicla retención · se aplica al vuelo (sin reiniciar)'
  _dash_add ' R  reinicia el daemon → aplica proveedor, destino, asentamiento y redirección web al instante'
  # Transient feedback (warn/note) lives at the BOTTOM, just above the exit
  # hint, so it reads as a status line for the whole popup instead of an
  # extra settings row.
  if [[ -n "${SETTINGS_WARN:-}" ]]; then
    _dash_add ' ⚠️  %s' "$SETTINGS_WARN"
  fi
  if [[ -n "${SETTINGS_NOTE:-}" ]]; then
    _dash_add ' %s' "$SETTINGS_NOTE"
  fi
  _dash_add ''
  _dash_add ' q/Esc salir'
  menu_cap_rows $(( DASH_LINES - 1 ))
  # Same per-line erase discipline as menu_render (see comment there).
  printf '\033[H%s\033[K\033[J' "${frame//$'\n'/$'\033[K\n'}"
}

# Popup entrypoint: render, read one key, cycle + persist + re-render.
# q/Esc/Enter exit; EOF (no tty / closed pipe) exits fail-open. Every
# change re-renders so the frame always reflects the persisted state;
# a config_set failure keeps the old value and shows the warning inline.
# Standalone direct access (`--voice-settings` / tts-settings entrypoint);
# the same knobs are also reachable INSIDE the voice menu (key `a`).
run_voice_settings() {
  local key=""
  SETTINGS_WARN=""
  SETTINGS_NOTE=""
  while :; do
    settings_render
    # Clear AFTER the render: a warning set by the previous keypress is
    # visible on exactly the render that reports it, then the frame goes
    # back to clean while the next key is awaited.
    SETTINGS_WARN=""
    SETTINGS_NOTE=""
    if ! read -rsn1 key; then
      break # EOF: fail-open, nothing changed by us
    fi
    settings_handle_key "$key" || break
  done
  exit 0
}

# ─── CLI Entrypoint ──────────────────────────────────────────

# Library mode: when sourced (tests/tooling), only define functions and
# configuration; dispatch CLI arguments only when executed directly.
# ═════════════════════════════════════════════════════════════════════════
# Declarative keymap: `herdr-tts keymap init|check|emit|apply|adopt`
#
# Voice-command bindings live in a user-editable JSON file (default
# ${XDG_CONFIG_HOME:-~/.config}/herdr-tts/keymap.json, override with
# HERDR_TTS_KEYMAP_FILE). Each stable command id maps to a chord:
#   "prefix+X"          uppercase X = shift (prefix+N ≠ prefix+n)
#   "ctrl+alt+X"        or "ctrl+alt+shift+X"
#   null                unassigned
# Modifiers must be written literally (they are NOT reordered); whitespace
# is tolerated. `check` validates the file and conflicts it against the
# embedded Herdr core prefix defaults. `apply` installs the bindings into
# ${HERDR_CONFIG_DIR:-~/.config}/herdr/config.toml as a managed block
# (timestamped backups, post-write `herdr config check` with rollback).
# `adopt` rewrites keymap.json with a whole suggested style map. `emit`
# still renders ready-to-paste [[keys.command]] TOML blocks.
# ═════════════════════════════════════════════════════════════════════════

# Stable command ids (this exact set, template order). One per voice command.
KEYMAP_COMMAND_IDS=(
  play pause stop tldr auto seek_back seek_fwd sentence_next sentence_prev
  paragraph_next paragraph_prev mute snooze snooze_global rate_up rate_down
  dashboard palette menu settings
)

# Herdr v0.9.1 core prefix defaults (docs/keyboard.mdx). Canonical chords
# use lowercase modifiers; a single uppercase key letter is expanded to
# shift+<lowercase> (typing prefix+N IS shift+n physically).
keymap_core_defaults() {
  cat <<'EOF'
prefix+c|new tab
prefix+v|split right
prefix+-|split down
prefix+h|focus pane left
prefix+j|focus pane down
prefix+k|focus pane up
prefix+l|focus pane right
prefix+shift+h|swap pane left
prefix+shift+j|swap pane down
prefix+shift+k|swap pane up
prefix+shift+l|swap pane right
prefix+z|zoom pane
prefix+x|close pane
prefix+r|resize pane
prefix+[|enter copy mode
prefix+n|next tab
prefix+p|previous tab
prefix+shift+t|rename tab
prefix+shift+x|close tab
prefix+1|jump to tab 1
prefix+2|jump to tab 2
prefix+3|jump to tab 3
prefix+4|jump to tab 4
prefix+5|jump to tab 5
prefix+6|jump to tab 6
prefix+7|jump to tab 7
prefix+8|jump to tab 8
prefix+9|jump to tab 9
prefix+shift+n|new workspace
prefix+shift+w|rename workspace
prefix+shift+d|close workspace
prefix+g|goto picker
prefix+b|toggle sidebar
prefix+w|workspace nav
prefix+q|detach
EOF
}

keymap_default_json() { # default template: README direct map + nulls for the rest
  cat <<'EOF'
{
  "style": "direct",
  "bindings": {
    "play": "prefix+r",
    "pause": "prefix+p",
    "stop": "prefix+s",
    "tldr": "prefix+t",
    "auto": "prefix+v",
    "seek_back": "prefix+[",
    "seek_fwd": "prefix+]",
    "sentence_next": "prefix+n",
    "sentence_prev": "prefix+N",
    "paragraph_next": null,
    "paragraph_prev": null,
    "mute": "prefix+m",
    "snooze": "prefix+z",
    "snooze_global": "prefix+Z",
    "rate_up": "prefix+=",
    "rate_down": "prefix+-",
    "dashboard": null,
    "palette": null,
    "menu": null,
    "settings": null
  }
}
EOF
}

keymap_cmd_for() { # $1 = command id → shell invocation Herdr must run
  case "$1" in
    play)            printf '%s\n' "herdr-tts --toggle-play" ;;
    pause)           printf '%s\n' "herdr-tts --toggle-pause" ;;
    stop)            printf '%s\n' "herdr-tts --stop" ;;
    tldr)            printf '%s\n' "herdr-tts --tldr" ;;
    auto)            printf '%s\n' "herdr-tts --toggle-auto" ;;
    seek_back)       printf '%s\n' "herdr-tts --rewind" ;;
    seek_fwd)        printf '%s\n' "herdr-tts --forward" ;;
    sentence_next)   printf '%s\n' "herdr-tts --next-sentence" ;;
    sentence_prev)   printf '%s\n' "herdr-tts --prev-sentence" ;;
    paragraph_next)  printf '%s\n' "herdr-tts --next-paragraph" ;;
    paragraph_prev)  printf '%s\n' "herdr-tts --prev-paragraph" ;;
    mute)            printf '%s\n' "herdr-tts --mute-pane" ;;
    snooze)          printf '%s\n' "herdr-tts --snooze-pane" ;;
    snooze_global)   printf '%s\n' "herdr-tts --snooze-global" ;;
    rate_up)         printf '%s\n' "herdr-tts --rate-up" ;;
    rate_down)       printf '%s\n' "herdr-tts --rate-down" ;;
    dashboard)       printf '%s\n' "herdr plugin pane open --plugin herdr.tts --entrypoint tts-dashboard" ;;
    palette)         printf '%s\n' "herdr plugin pane open --plugin herdr.tts --entrypoint tts-palette" ;;
    menu)            printf '%s\n' "herdr plugin pane open --plugin herdr.tts --entrypoint tts-menu" ;;
    settings)        printf '%s\n' "herdr-tts --voice-settings" ;;
  esac
}

keymap_label_for() { # $1 = command id → human label (emit comments)
  case "$1" in
    play)            printf '%s\n' "Play / Stop reading the currently focused pane" ;;
    pause)           printf '%s\n' "Pause / Resume current audio playback" ;;
    stop)            printf '%s\n' "Stop all audio immediately (Emergency Mute)" ;;
    tldr)            printf '%s\n' "TL;DR quick summary of the currently focused pane" ;;
    auto)            printf '%s\n' "Toggle background automatic speech" ;;
    seek_back)       printf '%s\n' "Rewind 10 seconds" ;;
    seek_fwd)        printf '%s\n' "Fast-forward 10 seconds" ;;
    sentence_next)   printf '%s\n' "Next spoken sentence (semantic navigation)" ;;
    sentence_prev)   printf '%s\n' "Previous spoken sentence (semantic navigation)" ;;
    paragraph_next)  printf '%s\n' "Next spoken paragraph" ;;
    paragraph_prev)  printf '%s\n' "Previous spoken paragraph" ;;
    mute)            printf '%s\n' "Exclusive mute of the focused pane (auto-clears when the pane closes)" ;;
    snooze)          printf '%s\n' "Cycle snooze on the focused pane: 5m / 30m / 2h / off" ;;
    snooze_global)   printf '%s\n' "Cycle GLOBAL snooze (all agents silenced: meetings / focus)" ;;
    rate_up)         printf '%s\n' "Speed up voice reading by 10%" ;;
    rate_down)       printf '%s\n' "Slow down voice reading by 10%" ;;
    dashboard)       printf '%s\n' "Open the TTS dashboard popup" ;;
    palette)         printf '%s\n' "Open the voice palette popup" ;;
    menu)            printf '%s\n' "Open the one-key voice menu popup (u is free in Herdr core defaults)" ;;
    settings)        printf '%s\n' "Open the voice/audio settings popup (TTS provider, playback target, audio retention)" ;;
  esac
}

keymap_ctrlalt_for() { # $1 = command id → suggested ctrl+alt chord (rc 1 = no suggestion)
  case "$1" in
    play)            printf '%s\n' "ctrl+alt+r" ;;
    pause)           printf '%s\n' "ctrl+alt+p" ;;
    stop)            printf '%s\n' "ctrl+alt+s" ;;
    tldr)            printf '%s\n' "ctrl+alt+l" ;; # NOT ctrl+alt+t: that launches a terminal on Ubuntu/Fedora
    auto)            printf '%s\n' "ctrl+alt+v" ;;
    mute)            printf '%s\n' "ctrl+alt+m" ;;
    snooze)          printf '%s\n' "ctrl+alt+z" ;;
    snooze_global)   printf '%s\n' "ctrl+alt+g" ;;
    seek_back)       printf '%s\n' "ctrl+alt+[" ;;
    seek_fwd)        printf '%s\n' "ctrl+alt+]" ;;
    sentence_next)   printf '%s\n' "ctrl+alt+n" ;;
    sentence_prev)   printf '%s\n' "ctrl+alt+shift+n" ;;
    rate_up)         printf '%s\n' "ctrl+alt+=" ;;
    rate_down)       printf '%s\n' "ctrl+alt+-" ;;
    dashboard)       printf '%s\n' "ctrl+alt+d" ;;
    palette)         printf '%s\n' "ctrl+alt+o" ;;
    menu)            printf '%s\n' "ctrl+alt+u" ;;
    # settings: no suggested chord — the settings view lives inside the
    # voice menu (key `a`); users can still bind the id manually.
    *)               return 1 ;;
  esac
}

keymap_is_known_id() { # $1 = candidate command id
  local id
  for id in "${KEYMAP_COMMAND_IDS[@]}"; do
    [[ "$id" == "$1" ]] && return 0
  done
  return 1
}

keymap_normalize_chord() { # $1 = raw chord → canonical chord on stdout; rc 1 = invalid syntax
  local c="${1//[[:space:]]/}" lc key mods
  [[ -n "$c" ]] || return 1
  lc="${c,,}"
  if [[ "$lc" == "prefix+"* ]]; then
    key="${c:7}"; mods="prefix"
  elif [[ "$lc" == "ctrl+alt+shift+"* ]]; then
    key="${c:15}"; mods="ctrl+alt+shift"
  elif [[ "$lc" == "ctrl+alt+"* ]]; then
    key="${c:9}"; mods="ctrl+alt"
  else
    return 1
  fi
  [[ -n "$key" && "$key" != *"+"* ]] || return 1
  # A single uppercase key letter without an explicit shift modifier IS
  # shift: prefix+N and prefix+shift+n are the same physical chord.
  if [[ "$mods" != *"shift"* && "$key" =~ ^[A-Z]$ ]]; then
    mods="${mods}+shift"
    key="${key,,}"
  fi
  printf '%s+%s\n' "$mods" "$key"
}

keymap_file_mtime() { # $1 = file → human-readable mtime (GNU stat, BSD fallback)
  if stat -c %y "$1" >/dev/null 2>&1; then
    stat -c %y "$1" | cut -d'.' -f1
  else
    stat -f '%Sm' "$1"
  fi
}

keymap_help() {
  cat <<EOF
Uso: herdr-tts keymap <subcomando> [opciones]

Keymap declarativo y editable por el usuario: un archivo JSON
(${KEYMAP_FILE}) que mapea cada comando de voz a un acorde.

  keymap init [--force]   Escribir la plantilla por defecto (nunca
                          sobrescribe un archivo existente; --force reemplaza)
  keymap check [--json]   Validar el archivo (JSON, ids conocidos, sintaxis de
                          acordes, duplicados) y detectar sombras sobre los
                          defaults de Herdr core. Exit 1 solo con errores.
  keymap emit [--style S] Imprimir bloques TOML [[keys.command]] listos para
                          pegar en ~/.config/herdr/config.toml. Estilos:
                          direct (default: usa los acordes del archivo),
                          ctrlalt (familia ctrl+alt sugerida),
                          menu (un solo acorde libre → popup del menú de voz)
  keymap apply [--config P] [--dry-run]
                          Escribir los bindings validados como BLOQUE
                          GESTIONADO en ${HERDR_CONFIG_DIR:-~/.config}/herdr/config.toml
                          (backup .bak-<ts>, se conservan 3; rollback
                          automático si 'herdr config check' falla;
                          --dry-run muestra el diff sin escribir)
  keymap adopt --style S [--force]
                          Sobrescribir keymap.json con el mapa sugerido del
                          estilo S (direct, ctrlalt o menu); pide --force si
                          el archivo tiene modificaciones de usuario

Acordes válidos: "prefix+X" (X en mayúscula = shift, p. ej. prefix+N),
"ctrl+alt+X", "ctrl+alt+shift+X", o null (sin asignar). Los modificadores
se escriben literalmente; el whitespace se tolera. Override de ruta para
tests: HERDR_TTS_KEYMAP_FILE.
EOF
}

# Validated keymap state (filled by keymap_load)
KEYMAP_STYLE=""
KEYMAP_ERRORS=0
KEYMAP_WARNINGS=0
KEYMAP_IDS=()
KEYMAP_CHORDS=()   # raw chord as written ("" = unassigned)
KEYMAP_CANON=()    # canonical chord ("" = unassigned/invalid)
KEYMAP_STATUS=()   # ok | warn | error
KEYMAP_CORE=()     # core action label when shadowing
KEYMAP_ERR=()      # error message when invalid

keymap_load() { # [quiet] parse + fully validate $KEYMAP_FILE; rc 1 = structural failure.
  # "quiet" suppresses human error messages (check --json prints its own payload).
  local quiet="${1:-}"
  local parse_err bad_keys tmp
  keymap_err() { [[ "$quiet" == "quiet" ]] || echo "$1" >&2; }
  if [[ ! -f "$KEYMAP_FILE" ]]; then
    keymap_err "❌ No keymap file at $KEYMAP_FILE"
    keymap_err "   Run: herdr-tts keymap init   (then edit the chords and re-run)"
    return 1
  fi
  if ! parse_err="$(jq -e . "$KEYMAP_FILE" 2>&1 >/dev/null)"; then
    keymap_err "❌ $KEYMAP_FILE is not valid JSON: $parse_err"
    return 1
  fi
  bad_keys="$(jq -r 'keys[]? | select(. != "style" and . != "bindings")' "$KEYMAP_FILE" || true)"
  if [[ -n "$bad_keys" ]]; then
    keymap_err "❌ Unknown top-level key(s) in $KEYMAP_FILE: $(echo "$bad_keys" | tr '\n' ' ')"
    keymap_err '   Only "style" and "bindings" are allowed.'
    return 1
  fi
  KEYMAP_STYLE="$(jq -r '.style // "direct"' "$KEYMAP_FILE")"
  case "$KEYMAP_STYLE" in
    direct|ctrlalt|menu) ;;
    *)
      keymap_err "❌ Invalid style \"$KEYMAP_STYLE\" (must be direct, ctrlalt or menu)"
      return 1
      ;;
  esac
  if [[ "$(jq -r '.bindings // {} | type' "$KEYMAP_FILE")" != "object" ]]; then
    keymap_err '❌ "bindings" must be a JSON object (command id → chord or null)'
    return 1
  fi

  KEYMAP_IDS=(); KEYMAP_CHORDS=(); KEYMAP_CANON=()
  KEYMAP_STATUS=(); KEYMAP_CORE=(); KEYMAP_ERR=()
  local id chord
  while IFS=$'\t' read -r id chord; do
    KEYMAP_IDS+=("$id"); KEYMAP_CHORDS+=("$chord")
  done < <(jq -r '.bindings // {} | to_entries[] | [ .key, (if .value == null then "" else .value end) ] | @tsv' "$KEYMAP_FILE")

  local -i n=${#KEYMAP_IDS[@]} i j
  for ((i = 0; i < n; i++)); do
    KEYMAP_STATUS+=(ok); KEYMAP_CORE+=(""); KEYMAP_ERR+=(""); KEYMAP_CANON+=("")
  done

  local hit
  for ((i = 0; i < n; i++)); do
    if ! keymap_is_known_id "${KEYMAP_IDS[$i]}"; then
      KEYMAP_STATUS[$i]=error
      KEYMAP_ERR[$i]="unknown command id (stable ids: ${KEYMAP_COMMAND_IDS[*]})"
      continue
    fi
    [[ -n "${KEYMAP_CHORDS[$i]}" ]] || continue # unassigned → ok
    if ! tmp="$(keymap_normalize_chord "${KEYMAP_CHORDS[$i]}")"; then
      KEYMAP_STATUS[$i]=error
      KEYMAP_ERR[$i]="invalid chord syntax (write prefix+X, ctrl+alt+X, ctrl+alt+shift+X, or null)"
      continue
    fi
    KEYMAP_CANON[$i]="$tmp"
    hit="$(keymap_core_defaults | grep -F -- "${KEYMAP_CANON[$i]}|" | head -1 || true)"
    if [[ -n "$hit" ]]; then
      KEYMAP_STATUS[$i]=warn
      KEYMAP_CORE[$i]="${hit#*|}"
    fi
  done

  # Duplicate chords (same canonical form, two bindings) are hard errors.
  for ((i = 0; i < n; i++)); do
    [[ -n "${KEYMAP_CANON[$i]}" ]] || continue
    for ((j = i + 1; j < n; j++)); do
      [[ "${KEYMAP_CANON[$j]}" == "${KEYMAP_CANON[$i]}" ]] || continue
      KEYMAP_STATUS[$i]=error; KEYMAP_STATUS[$j]=error
      KEYMAP_ERR[$i]="duplicate chord ${KEYMAP_CHORDS[$i]} (also bound by '${KEYMAP_IDS[$j]}')"
      KEYMAP_ERR[$j]="duplicate chord ${KEYMAP_CHORDS[$j]} (also bound by '${KEYMAP_IDS[$i]}')"
    done
  done

  KEYMAP_ERRORS=0; KEYMAP_WARNINGS=0
  for ((i = 0; i < n; i++)); do
    case "${KEYMAP_STATUS[$i]}" in
      error) KEYMAP_ERRORS=$((KEYMAP_ERRORS + 1)) ;;
      warn)  KEYMAP_WARNINGS=$((KEYMAP_WARNINGS + 1)) ;;
    esac
  done
  return 0
}

keymap_check() { # $1 = "" | --json
  local json_mode=0
  [[ "${1:-}" == "--json" ]] && json_mode=1
  local load_rc=0
  keymap_load "$([[ $json_mode -eq 1 ]] && echo quiet)" || load_rc=1
  if (( load_rc )); then
    if (( json_mode )); then
      printf '{"file":"%s","style":null,"ok":false,"error_count":1,"warning_count":0,"bindings":[],"error":"invalid or missing keymap file (run: herdr-tts keymap init)"}\n' "$KEYMAP_FILE"
    fi
    return 1
  fi

  local -i n=${#KEYMAP_IDS[@]} i
  if (( json_mode )); then
    local tmpj
    tmpj="$(mktemp)"
    for ((i = 0; i < n; i++)); do
      jq -cn --arg command "${KEYMAP_IDS[$i]}" --arg chord "${KEYMAP_CHORDS[$i]}" \
        --arg status "${KEYMAP_STATUS[$i]}" --arg core "${KEYMAP_CORE[$i]}" \
        --arg error "${KEYMAP_ERR[$i]}" \
        '{command: $command,
          chord: (if $chord == "" then null else $chord end),
          status: $status,
          core: (if $core == "" then null else $core end),
          error: (if $error == "" then null else $error end)}' >> "$tmpj"
    done
    jq -s --arg file "$KEYMAP_FILE" --arg style "$KEYMAP_STYLE" \
      --argjson error_count "$KEYMAP_ERRORS" --argjson warning_count "$KEYMAP_WARNINGS" \
      '{file: $file, style: $style,
        ok: ($error_count == 0),
        error_count: $error_count, warning_count: $warning_count,
        bindings: .}' "$tmpj"
    rm -f "$tmpj"
  else
    echo "Checking $KEYMAP_FILE (style: $KEYMAP_STYLE)"
    for ((i = 0; i < n; i++)); do
      case "${KEYMAP_STATUS[$i]}" in
        warn)
          echo "⚠️  SHADOWS CORE (${KEYMAP_CORE[$i]}): ${KEYMAP_IDS[$i]} = ${KEYMAP_CHORDS[$i]}"
          ;;
        error)
          echo "❌ ${KEYMAP_ERR[$i]}: ${KEYMAP_IDS[$i]} = ${KEYMAP_CHORDS[$i]}"
          ;;
        *)
          if [[ -n "${KEYMAP_CHORDS[$i]}" ]]; then
            echo "✓ OK: ${KEYMAP_IDS[$i]} = ${KEYMAP_CHORDS[$i]}"
          else
            echo "✓ OK: ${KEYMAP_IDS[$i]} = (unassigned)"
          fi
          ;;
      esac
    done
    if (( KEYMAP_ERRORS > 0 )); then
      echo "❌ $n bindings · $KEYMAP_ERRORS error(s) · $KEYMAP_WARNINGS shadow warning(s)"
    else
      echo "✓ $n bindings · 0 errors · $KEYMAP_WARNINGS shadow warning(s) — keymap OK"
    fi
  fi
  (( KEYMAP_ERRORS == 0 ))
}

keymap_emit_block() { # $1 = chord, $2 = shell command, $3 = label
  printf '\n# %s\n[[keys.command]]\nkey = "%s"\ntype = "shell"\ncommand = "%s"\n' "$3" "$1" "$2"
}

keymap_emit() { # $1 = "" | direct | ctrlalt | menu
  local style="${1:-}"
  case "$style" in
    ""|direct|ctrlalt|menu) ;;
    *)
      echo "❌ unknown style: $style (direct, ctrlalt or menu)" >&2
      return 1
      ;;
  esac
  if [[ ! -f "$KEYMAP_FILE" ]]; then
    echo "❌ No keymap file at $KEYMAP_FILE" >&2
    echo "   Run: herdr-tts keymap init   (then edit the chords and re-run)" >&2
    return 1
  fi
  # Emit renders hard-valid files only (parse, ids, chord syntax); core
  # shadow warnings do NOT block rendering — `keymap check` reports those.
  if ! keymap_load; then
    return 1
  fi
  if (( KEYMAP_ERRORS > 0 )); then
    echo "❌ $KEYMAP_FILE has $KEYMAP_ERRORS error(s) — run: herdr-tts keymap check" >&2
    return 1
  fi

  echo "# herdr-tts keymap — paste the blocks below into ~/.config/herdr/config.toml"
  echo "# generated by: herdr-tts keymap emit${style:+ --style $style}"
  echo "# source: $KEYMAP_FILE (modified $(keymap_file_mtime "$KEYMAP_FILE"))"

  if [[ "$style" == "menu" ]]; then
    keymap_emit_block "prefix+u" \
      "herdr plugin pane open --plugin herdr.tts --entrypoint tts-menu" \
      "Open the one-key voice menu popup (u is free in Herdr core defaults)"
    return 0
  fi

  if [[ "$style" == "ctrlalt" ]]; then
    echo "# Herdr core does not own the ctrl+alt family: zero core collisions."
    echo "# TL;DR deliberately avoids ctrl+alt+t: that launches a terminal on Ubuntu/Fedora."
    local cid chord
    for cid in "${KEYMAP_COMMAND_IDS[@]}"; do
      chord="$(keymap_ctrlalt_for "$cid")" || continue
      keymap_emit_block "$chord" "$(keymap_cmd_for "$cid")" "$(keymap_label_for "$cid")"
    done
    echo "# note: paragraph_next / paragraph_prev / settings have no suggested ctrl+alt chord — assign them in keymap.json (settings also lives inside the voice menu, key \`a\`)"
    return 0
  fi

  # direct (default): render the file's own bindings, stable id order.
  keymap_render_bindings
}

# ─── keymap apply / adopt ────────────────────────────────────
# `apply` installs the validated bindings into the Herdr config as a
# managed block between exact markers; user content outside the markers
# is never touched. Every content-changing write is preceded by a
# timestamped backup (last 3 kept) and followed by `herdr config check`
# (when the herdr binary is on PATH) with automatic rollback on failure.
# `adopt` rewrites keymap.json with a whole suggested style map so the
# loop closes: init → (adopt) → check → apply.

keymap_render_bindings() { # print [[keys.command]] blocks for the loaded bindings, stable id order
  local -A chord_of=()
  local -i n=${#KEYMAP_IDS[@]} i
  for ((i = 0; i < n; i++)); do
    chord_of[${KEYMAP_IDS[$i]}]="${KEYMAP_CHORDS[$i]}"
  done
  local cid chord emitted=0
  for cid in "${KEYMAP_COMMAND_IDS[@]}"; do
    chord="${chord_of[$cid]:-}"
    if [[ -n "$chord" ]]; then
      keymap_emit_block "$chord" "$(keymap_cmd_for "$cid")" "$(keymap_label_for "$cid")"
      emitted=1
    fi
  done
  if (( ! emitted )); then
    echo "# (no chords assigned in the keymap file)"
  fi
}

# Managed block markers: generated bindings live exclusively between them.
KEYMAP_BLOCK_START='# >>> herdr-tts keymap (managed; edits inside are overwritten) >>>'
KEYMAP_BLOCK_END='# <<< herdr-tts keymap <<<'

keymap_suggested_bindings() { # $1 = style → "id<TAB>chord" lines (empty chord = null)
  local cid chord
  case "$1" in
    direct)
      keymap_default_json | jq -r '.bindings | to_entries[] | [ .key, (if .value == null then "" else .value end) ] | @tsv'
      ;;
    ctrlalt)
      for cid in "${KEYMAP_COMMAND_IDS[@]}"; do
        chord="$(keymap_ctrlalt_for "$cid")" || chord=""
        printf '%s\t%s\n' "$cid" "$chord"
      done
      ;;
    menu)
      for cid in "${KEYMAP_COMMAND_IDS[@]}"; do
        if [[ "$cid" == "menu" ]]; then chord="prefix+u"; else chord=""; fi
        printf '%s\t%s\n' "$cid" "$chord"
      done
      ;;
    *)
      echo "❌ unknown style: $1 (direct, ctrlalt or menu)" >&2
      return 1
      ;;
  esac
}

keymap_backup_file() { # $1 = existing file → copy to <file>.bak-YYYYmmdd-HHMMSS (prints the path)
  local ts b
  ts="$(date +%Y%m%d-%H%M%S)" || return 1
  b="${1}.bak-${ts}"
  if [[ -e "$b" ]]; then b="${b}.$RANDOM"; fi # same-second collision fallback (still sorts after)
  cp -p "$1" "$b" || return 1
  keymap_prune_backups "$1"
  printf '%s\n' "$b"
}

keymap_prune_backups() { # $1 = base file — keep only the 3 newest <file>.bak-* copies
  local -a baks=()
  local f
  for f in "${1}".bak-*; do
    if [[ -e "$f" ]]; then baks+=("$f"); fi
  done
  local -i n=${#baks[@]}
  if (( n > 3 )); then
    rm -f "${baks[@]:0:$((n - 3))}"
  fi
}

keymap_write_style_map() { # $1 = style — atomically write that style's suggested map into $KEYMAP_FILE (with backup)
  local style="$1"
  local bindings_json json parent backup tmp
  bindings_json="$(keymap_suggested_bindings "$style" | jq -Rsc '
    split("\n") | map(select(length > 0))
    | map(split("\t") | { (.[0]): (if .[1] == "" then null else .[1] end) })
    | add // {}')" || return 1
  json="$(printf '{"style": "%s", "bindings": %s}\n' "$style" "$bindings_json" | jq .)" || return 1
  parent="$(dirname "$KEYMAP_FILE")"
  mkdir -p "$parent" || return 1
  backup=""
  if [[ -f "$KEYMAP_FILE" ]]; then
    backup="$(keymap_backup_file "$KEYMAP_FILE")" || backup=""
  fi
  tmp="$(mktemp "$KEYMAP_FILE.XXXXXX")" || return 1
  if printf '%s\n' "$json" > "$tmp" && mv -f "$tmp" "$KEYMAP_FILE"; then
    return 0
  fi
  rm -f "$tmp"
  return 1
}

keymap_apply() { # $1 = config path override ("" = default), $2 = 1 when --dry-run
  local target
  if [[ -n "${1:-}" ]]; then
    target="$1"
  else
    target="${HERDR_CONFIG_DIR:-$HOME/.config}/herdr/config.toml"
  fi
  local dry_run="${2:-0}"

  if [[ ! -f "$KEYMAP_FILE" ]]; then
    echo "❌ No keymap file at $KEYMAP_FILE" >&2
    echo "   Run: herdr-tts keymap init   (then edit the chords and re-run)" >&2
    return 1
  fi
  # Hard errors (unknown ids, chord syntax, duplicates) refuse to apply;
  # core shadow warnings are allowed but printed.
  if ! keymap_load; then
    return 1
  fi
  if (( KEYMAP_ERRORS > 0 )); then
    echo "❌ $KEYMAP_FILE has $KEYMAP_ERRORS error(s) — refusing to apply. Run: herdr-tts keymap check" >&2
    return 1
  fi
  local -i i
  if (( KEYMAP_WARNINGS > 0 )); then
    echo "⚠️  $KEYMAP_WARNINGS shadow warning(s) against Herdr core (not blocking):"
    for ((i = 0; i < ${#KEYMAP_IDS[@]}; i++)); do
      if [[ "${KEYMAP_STATUS[$i]}" == "warn" ]]; then
        echo "⚠️  SHADOWS CORE (${KEYMAP_CORE[$i]}): ${KEYMAP_IDS[$i]} = ${KEYMAP_CHORDS[$i]}"
      fi
    done
  fi

  # Read the target preserving exact bytes (including trailing newlines).
  local content="" had_markers=0 pre="" post="" scan ns ne
  if [[ -f "$target" ]]; then
    if ! content="$(cat "$target"; printf x)"; then
      echo "❌ cannot read $target" >&2
      return 1
    fi
    content="${content%x}"
    ns=0; scan="$content"
    while [[ "$scan" == *"$KEYMAP_BLOCK_START"* ]]; do ns=$((ns + 1)); scan="${scan#*"$KEYMAP_BLOCK_START"}"; done
    ne=0; scan="$content"
    while [[ "$scan" == *"$KEYMAP_BLOCK_END"* ]]; do ne=$((ne + 1)); scan="${scan#*"$KEYMAP_BLOCK_END"}"; done
    if (( ns > 1 || ne > 1 )); then
      echo "❌ $target has duplicate herdr-tts managed-block markers — keep exactly one block (fix manually)." >&2
      return 1
    fi
    if (( ns == 1 && ne == 0 )); then
      echo "❌ $target has an unterminated herdr-tts managed block (missing '$KEYMAP_BLOCK_END') — close it or remove both markers manually." >&2
      return 1
    fi
    if (( ns == 0 && ne == 1 )); then
      echo "❌ $target has a stray herdr-tts block end marker without a start marker (fix manually)." >&2
      return 1
    fi
    if (( ns == 1 )); then
      had_markers=1
      pre="${content%%"$KEYMAP_BLOCK_START"*}"
      post="${content#*"$KEYMAP_BLOCK_END"}"
    fi
  fi

  # Managed block body: same generator as `emit`'s direct path (lockstep).
  local block
  block="# generated by: herdr-tts keymap apply — source: $KEYMAP_FILE"
  block+=$'\n'$(keymap_render_bindings)

  local new_content
  if (( had_markers )); then
    # Replace the managed region in place; bytes outside it are untouched.
    new_content="${pre}${KEYMAP_BLOCK_START}"$'\n'"${block}"$'\n'"${KEYMAP_BLOCK_END}${post}"
  else
    local base="$content"
    while [[ "$base" == *$'\n' ]]; do base="${base%$'\n'}"; done
    if [[ -n "$base" ]]; then
      new_content="${base}"$'\n\n'"${KEYMAP_BLOCK_START}"$'\n'"${block}"$'\n'"${KEYMAP_BLOCK_END}"$'\n'
    else
      new_content="${KEYMAP_BLOCK_START}"$'\n'"${block}"$'\n'"${KEYMAP_BLOCK_END}"$'\n'
    fi
  fi

  if [[ -f "$target" && "$new_content" == "$content" ]]; then
    echo "✓ $target already up to date (managed block unchanged)"
    echo "  Apply live with: herdr server reload-config"
    return 0
  fi

  if [[ "$dry_run" == "1" ]]; then
    echo "── dry-run: no files were modified ──"
    if [[ -f "$target" ]]; then
      local dtmp
      dtmp="$(mktemp "${TMPDIR:-/tmp}/herdr-tts-dryrun.XXXXXX")" || return 1
      printf '%s' "$new_content" > "$dtmp"
      diff -u --label "$target (current)" --label "$target (after apply)" "$target" "$dtmp" || true
      rm -f "$dtmp"
    else
      echo "target $target does not exist yet; the following block would be created:"
      printf '%s\n' "$new_content"
    fi
    return 0
  fi

  # Backup → atomic write (temp file in the same directory + mv).
  local parent backup=""
  parent="$(dirname "$target")"
  if ! mkdir -p "$parent"; then
    echo "❌ cannot create directory $parent" >&2
    return 1
  fi
  if [[ -f "$target" ]]; then
    backup="$(keymap_backup_file "$target")" || {
      echo "❌ backup of $target failed — aborting write" >&2
      return 1
    }
    echo "  backup: $backup"
  fi
  local wtmp mode
  wtmp="$(mktemp "$parent/.herdr-tts-apply.XXXXXX")" || return 1
  if ! printf '%s' "$new_content" > "$wtmp"; then
    rm -f "$wtmp"
    return 1
  fi
  if [[ -n "$backup" ]]; then
    mode="$(stat -c %a "$backup" 2>/dev/null || stat -f %Lp "$backup")"
    chmod "$mode" "$wtmp" 2>/dev/null || true
  else
    chmod 644 "$wtmp" 2>/dev/null || true
  fi
  if ! mv -f "$wtmp" "$target"; then
    rm -f "$wtmp"
    echo "❌ atomic write to $target failed" >&2
    return 1
  fi

  # Post-write validation: let the real herdr binary judge the config.
  local chkrc=0 chkout=""
  if command -v herdr >/dev/null 2>&1; then
    chkout="$(herdr config check 2>&1)" || chkrc=$?
    if (( chkrc != 0 )); then
      if [[ -n "$backup" ]]; then
        if mv -f "$backup" "$target"; then
          echo "❌ herdr config check failed — config rolled back to the previous state:" >&2
        else
          echo "❌ herdr config check failed AND rollback failed (backup kept at $backup):" >&2
        fi
      else
        rm -f "$target"
        echo "❌ herdr config check failed — newly created config removed:" >&2
      fi
      printf '%s\n' "$chkout" | sed 's/^/    /' >&2
      echo "   Fix the keymap (herdr-tts keymap check) and re-run: herdr-tts keymap apply" >&2
      return 1
    fi
  else
    echo "  note: 'herdr' not found on PATH — skipped post-write config validation"
  fi

  local -i nbound=0
  for ((i = 0; i < ${#KEYMAP_CHORDS[@]}; i++)); do
    if [[ -n "${KEYMAP_CHORDS[$i]}" ]]; then nbound=$((nbound + 1)); fi
  done
  echo "✓ Managed keymap block written to $target ($nbound binding(s))"
  echo "  Apply live with: herdr server reload-config"
}

keymap_adopt() { # $1 = style, $2 = 1 when --force
  local style="$1" force="${2:-0}"
  local id chord canon
  case "$style" in
    direct|ctrlalt|menu) ;;
    *)
      echo "❌ unknown style: $style (direct, ctrlalt or menu)" >&2
      return 1
      ;;
  esac

  # Target map for the requested style: id → canonical chord ("" = null).
  local -A tgt=()
  while IFS=$'\t' read -r id chord; do
    if [[ -n "$chord" ]]; then
      if canon="$(keymap_normalize_chord "$chord")"; then :; else canon="<invalid>"; fi
    else
      canon=""
    fi
    tgt[$id]="$canon"
  done < <(keymap_suggested_bindings "$style")

  if [[ ! -f "$KEYMAP_FILE" ]]; then
    # Nothing to clobber: seed the file straight from the suggested map.
    if keymap_write_style_map "$style"; then
      echo "✓ No keymap file found — wrote the $style suggested map to $KEYMAP_FILE"
      echo "  Next: herdr-tts keymap check, then herdr-tts keymap apply"
      return 0
    fi
    echo "❌ could not write $KEYMAP_FILE" >&2
    return 1
  fi

  if ! keymap_load; then
    echo "   Fix the file (herdr-tts keymap check) or reset it (herdr-tts keymap init --force)." >&2
    return 1
  fi

  # Current file bindings, canonical (invalid chords get a sentinel so they
  # never compare equal to null).
  local -A cur=()
  local -i n=${#KEYMAP_IDS[@]} i
  for ((i = 0; i < n; i++)); do
    if [[ -n "${KEYMAP_CHORDS[$i]}" ]]; then
      if canon="$(keymap_normalize_chord "${KEYMAP_CHORDS[$i]}")"; then :; else canon="<invalid>"; fi
    else
      canon=""
    fi
    cur[${KEYMAP_IDS[$i]}]="$canon"
  done

  # Already adopted? (bindings equal the target style's map, no unknown ids)
  local already=1
  for id in "${KEYMAP_COMMAND_IDS[@]}"; do
    if [[ "${cur[$id]:-}" != "${tgt[$id]:-}" ]]; then already=0; break; fi
  done
  if (( already )); then
    for ((i = 0; i < n; i++)); do
      if ! keymap_is_known_id "${KEYMAP_IDS[$i]}"; then already=0; fi
    done
  fi
  if (( already )); then
    echo "✓ $KEYMAP_FILE already adopts the $style map — nothing to do"
    return 0
  fi

  # "Modified" = any binding differing from the CURRENT style's suggested map.
  local -A sug=()
  while IFS=$'\t' read -r id chord; do
    if [[ -n "$chord" ]]; then
      if canon="$(keymap_normalize_chord "$chord")"; then :; else canon="<invalid>"; fi
    else
      canon=""
    fi
    sug[$id]="$canon"
  done < <(keymap_suggested_bindings "$KEYMAP_STYLE")

  local modified=0
  for id in "${KEYMAP_COMMAND_IDS[@]}"; do
    if [[ "${cur[$id]:-}" != "${sug[$id]:-}" ]]; then modified=1; break; fi
  done
  if (( ! modified )); then
    for ((i = 0; i < n; i++)); do
      if ! keymap_is_known_id "${KEYMAP_IDS[$i]}"; then modified=1; fi
    done
  fi

  if (( modified && ! force )); then
    echo "✋ $KEYMAP_FILE has user modifications (differs from the '$KEYMAP_STYLE' suggested map) — refusing to overwrite."
    echo "   Keep your edits and switch manually, or force with: herdr-tts keymap adopt --style $style --force"
    return 1
  fi

  if ! keymap_write_style_map "$style"; then
    echo "❌ could not write $KEYMAP_FILE" >&2
    return 1
  fi
  if (( modified )); then
    echo "✓ Forced adoption: $style suggested map written to $KEYMAP_FILE (previous file backed up)"
  else
    echo "✓ Adopted the $style suggested map into $KEYMAP_FILE"
  fi
  echo "  Next: herdr-tts keymap check, then herdr-tts keymap apply"
}

keymap_main() {
  local sub="${1:-}"
  [[ $# -gt 0 ]] && shift
  case "$sub" in
    init)
      local flag="${1:-}"
      if [[ -n "$flag" && "$flag" != "--force" ]]; then
        echo "❌ unknown option: $flag (keymap init accepts --force)" >&2
        return 1
      fi
      if [[ -e "$KEYMAP_FILE" && "$flag" != "--force" ]]; then
        echo "✋ $KEYMAP_FILE already exists — refusing to overwrite."
        echo "   Edit it in place, or run: herdr-tts keymap init --force"
        return 1
      fi
      keymap_default_json > "$KEYMAP_FILE"
      echo "✓ Keymap template written to $KEYMAP_FILE"
      echo "  Next: edit the chords, then run 'herdr-tts keymap check'"
      ;;
    check)
      local flag="${1:-}"
      if [[ -n "$flag" && "$flag" != "--json" ]]; then
        echo "❌ unknown option: $flag (keymap check accepts --json)" >&2
        return 1
      fi
      keymap_check "$flag"
      ;;
    emit)
      local style="" val
      if [[ "${1:-}" == "--style" ]]; then
        if [[ $# -lt 2 ]]; then
          echo "❌ --style requires a value (direct, ctrlalt or menu)" >&2
          return 1
        fi
        style="$2"
      elif [[ -n "${1:-}" ]]; then
        echo "❌ unknown option: $1 (keymap emit accepts --style direct|ctrlalt|menu)" >&2
        return 1
      fi
      keymap_emit "$style"
      ;;
    apply)
      local cfg="" dry=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --config)
            if [[ $# -lt 2 ]]; then
              echo "❌ --config requires a path" >&2
              return 1
            fi
            cfg="$2"; shift 2
            ;;
          --dry-run)
            dry=1; shift
            ;;
          *)
            echo "❌ unknown option: $1 (keymap apply accepts --config <path> and --dry-run)" >&2
            return 1
            ;;
        esac
      done
      keymap_apply "$cfg" "$dry"
      ;;
    adopt)
      local style="" force=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --style)
            if [[ $# -lt 2 ]]; then
              echo "❌ --style requires a value (direct, ctrlalt or menu)" >&2
              return 1
            fi
            style="$2"; shift 2
            ;;
          --force)
            force=1; shift
            ;;
          *)
            echo "❌ unknown option: $1 (keymap adopt accepts --style direct|ctrlalt|menu and --force)" >&2
            return 1
            ;;
        esac
      done
      if [[ -z "$style" ]]; then
        echo "❌ keymap adopt requires --style direct|ctrlalt|menu" >&2
        return 1
      fi
      keymap_adopt "$style" "$force"
      ;;
    help|-h|--help)
      keymap_help
      ;;
    "")
      keymap_help
      ;;
    *)
      echo "❌ unknown subcommand: $sub (use init, check, emit, apply or adopt)" >&2
      keymap_help >&2
      return 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
case "${1:-}" in
  --play|-p|--read-current)
    read_current_pane "${2:-}"
    ;;
  --highlight|-H)
    read_current_pane_visual "$@"
    ;;
  --autoscroll)
    read_current_pane_visual "$@"
    ;;
  --bionic)
    read_current_pane_visual "$@"
    ;;
