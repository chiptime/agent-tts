import sys
from agent_tts import run_podcast_server
run_podcast_server(port=int(sys.argv[1]), podcast_dir=sys.argv[2])
" "$port" "$pod_dir"
    ;;
  --podcast-publish)
    publish_current_pane_podcast
    ;;
  --status)
    show_status
    ;;
  --dashboard)
    run_dashboard
    ;;
  --voice-palette)
    run_voice_palette
    ;;
  --voice-menu)
    run_voice_menu
    ;;
  --voice-settings)
    run_voice_settings
    ;;
  --palette-preview)
    palette_preview "${2:-}"
    ;;
  keymap)
