TT_EN[km.emit.3]="                          direct (default: uses the file's chords),"
TT_EN[km.emit.4]="                          ctrlalt (suggested ctrl+alt family),"
TT_EN[km.emit.5]="                          menu (one free chord → voice menu popup)"
TT_EN[km.apply.1]="  keymap apply [--config P] [--dry-run]"
TT_EN[km.apply.2]="                          Write the validated bindings as a MANAGED"
TT_EN[km.apply.3]="                          block in %%s/herdr/config.toml"
TT_EN[km.apply.4]="                          (.bak-<ts> backups, 3 kept; automatic"
TT_EN[km.apply.5]="                          rollback if 'herdr config check' fails;"
TT_EN[km.apply.6]="                          --dry-run shows the diff without writing)"
TT_EN[km.adopt.1]="  keymap adopt --style S [--force]"
TT_EN[km.adopt.2]="                          Overwrite keymap.json with the style's suggested"
TT_EN[km.adopt.3]="                          map (direct, ctrlalt or menu); requires --force"
TT_EN[km.adopt.4]="                          when the file has user modifications"
