  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "next-paragraph" 2>/dev/null || true)
  if [[ -z "$res" || "$res" == *"Error:"* ]]; then
    echo "⏹️ No hay audio reproduciéndose actualmente"
    return 1
  fi

  local paragraph
  paragraph=$(echo "$res" | sed -n 's/.*paragraph=//p')
  if [[ -z "$paragraph" ]]; then
    paragraph="Fin de la locución"
  fi

  echo "⏭️ Siguiente párrafo: ${paragraph}"
  notify_herdr "⏭️ Siguiente párrafo" "${paragraph}"
}

prev_paragraph_audio() {
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "prev-paragraph" 2>/dev/null || true)
  if [[ -z "$res" || "$res" == *"Error:"* ]]; then
    echo "⏹️ No hay audio reproduciéndose actualmente"
    return 1
  fi

  local paragraph
  paragraph=$(echo "$res" | sed -n 's/.*paragraph=//p')
  if [[ -z "$paragraph" ]]; then
    paragraph="Inicio de la locución"
  fi

  echo "⏮️ Párrafo anterior: ${paragraph}"
  notify_herdr "⏮️ Párrafo anterior" "${paragraph}"
}

toggle_pause_audio() {
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "toggle-pause" 2>/dev/null || true)
  if [[ -z "$res" || "$res" == *"Error:"* ]]; then
    echo "⏹️ No hay audio reproduciéndose actualmente"
    return 1
  fi

  local status pos total
  status=$(echo "$res" | grep -o 'status=[a-z]*' | cut -d= -f2)
  pos=$(echo "$res" | grep -o 'pos=[0-9.]*' | cut -d= -f2)
  total=$(echo "$res" | grep -o 'total=[0-9.]*' | cut -d= -f2)

  local pos_int=${pos%.*}
  local total_int=${total%.*}
  [[ -z "$pos_int" ]] && pos_int=0
  [[ -z "$total_int" ]] && total_int=0

  local pos_m=$(( pos_int / 60 ))
  local pos_s=$(( pos_int % 60 ))
  local tot_m=$(( total_int / 60 ))
  local tot_s=$(( total_int % 60 ))
  local time_label
  time_label=$(printf "%d:%02d / %d:%02d" "$pos_m" "$pos_s" "$tot_m" "$tot_s")

  if [[ "$status" == "paused" ]]; then
    echo "⏸️ Audio pausado (${time_label})"
    notify_herdr "⏸️ Audio pausado" "${time_label} (reanudable con prefix+p)"
  else
    echo "▶️ Audio reanudado (${time_label})"
    notify_herdr "▶️ Audio reanudado" "${time_label}"
  fi
}

pause_audio() {
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "status" 2>/dev/null || true)
  if [[ "$res" == *"status=playing"* ]]; then
    toggle_pause_audio
  elif [[ "$res" == *"status=paused"* ]]; then
    echo "⏸️ Audio ya está pausado"
  else
    echo "⏹️ No hay audio reproduciéndose actualmente"
  fi
}

resume_audio() {
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "resume" 2>/dev/null || true)
  if [[ -n "$res" && "$res" != *"Error:"* ]]; then
    echo "▶️ Audio reanudado"
    notify_herdr "▶️ Audio reanudado" ""
  else
    echo "⏹️ No hay audio reproduciéndose actualmente"
  fi
}

get_player_status() {
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "status" 2>/dev/null || true)
  if [[ -z "$res" || "$res" == *"Error:"* ]]; then
    echo "⏹️ En reposo (sin reproducción activa)"
    return 0
  fi
  local status pos total
  status=$(echo "$res" | grep -o 'status=[a-z]*' | cut -d= -f2)
  pos=$(echo "$res" | grep -o 'pos=[0-9.]*' | cut -d= -f2)
  total=$(echo "$res" | grep -o 'total=[0-9.]*' | cut -d= -f2)
  local sent
  sent=$(echo "$res" | sed -n 's/.*sentence=//p')

  if [[ "$status" == "synthesizing" ]]; then
    echo "⏳ Estado: sintetizando respuesta de voz..."
    return 0
  fi

  local pos_int=${pos%.*}
  local total_int=${total%.*}
  [[ -z "$pos_int" ]] && pos_int=0
  [[ -z "$total_int" ]] && total_int=0

  local pos_m=$(( pos_int / 60 ))
  local pos_s=$(( pos_int % 60 ))
  local tot_m=$(( total_int / 60 ))
  local tot_s=$(( total_int % 60 ))
  local time_label
  time_label=$(printf "%d:%02d / %d:%02d" "$pos_m" "$pos_s" "$tot_m" "$tot_s")

  local icon="🔊"
  [[ "$status" == "paused" ]] && icon="⏸️"
  if [[ -n "$sent" ]]; then
    echo "${icon} Estado: ${status} (${time_label}) | Frase: \"${sent}\""
  else
    echo "${icon} Estado: ${status} (${time_label})"
  fi
}

adjust_rate() {
  local step="$1" # +10 or -10
  local current_num
  current_num=$(echo "${TTS_RATE}" | tr -d '+%' | grep -o '[-0-9]*' || echo "20")
  [[ -z "$current_num" ]] && current_num=20
  local new_num=$(( current_num + step ))
  (( new_num > 100 )) && new_num=100
  (( new_num < -50 )) && new_num=-50
  if (( new_num >= 0 )); then
    TTS_RATE="+${new_num}%"
  else
    TTS_RATE="${new_num}%"
  fi
  save_config
  echo "✓ Velocidad ajustada: ${TTS_RATE}"
  notify_herdr "⚡ Velocidad de voz" "${TTS_RATE}"
}

build_provider_flags() {
  PROVIDER_FLAGS=(--provider "${TTS_PROVIDER:-edge}")
  [[ -n "${OPENAI_API_KEY:-}" ]] && PROVIDER_FLAGS+=(--openai-key "$OPENAI_API_KEY")
  [[ -n "${OPENAI_BASE_URL:-}" ]] && PROVIDER_FLAGS+=(--openai-base-url "$OPENAI_BASE_URL")
  [[ -n "${OPENAI_TTS_MODEL:-}" ]] && PROVIDER_FLAGS+=(--openai-model "$OPENAI_TTS_MODEL")
  local el_key="${ELEVENLABS_API_KEY:-${ELEVENLABS_KEY:-}}"
  [[ -n "$el_key" ]] && PROVIDER_FLAGS+=(--eleven-key "$el_key")
  [[ -n "${ELEVENLABS_MODEL:-}" ]] && PROVIDER_FLAGS+=(--eleven-model "$ELEVENLABS_MODEL")
  [[ -n "${PIPER_MODEL:-}" ]] && PROVIDER_FLAGS+=(--piper-model "$PIPER_MODEL")
  if [[ "${TTS_AUTO_LANG:-off}" == "on" || "${TTS_AUTO_LANG:-off}" == "true" || "${TTS_AUTO_LANG:-off}" == "1" ]]; then
    PROVIDER_FLAGS+=(--auto-lang)
  fi
  # Optional playback target: forward to the engine only when not local
  # (default behavior unchanged otherwise).
  if [[ -n "${TTS_PLAYBACK:-}" && "${TTS_PLAYBACK}" != "local" ]]; then
    PROVIDER_FLAGS+=(--playback "${TTS_PLAYBACK}")
  fi
}

speak_text() {
  local text="$1"
  local voice="${2:-$TTS_VOICE}"
  local rate="${3:-$TTS_RATE}"
  local tldr_flag="${4:-}"
  local target_pane="${5:-}"
  local agent_kind="${6:-}"
  local session_id="${7:-}"

  # Stop any currently playing audio first (new request takes priority)
  stop_audio

  build_provider_flags

  local -a extra_flags=()
  if [[ "$tldr_flag" == "--tldr" || "$tldr_flag" == "tldr" ]]; then
    extra_flags+=(--tldr)
  fi

  # Agent Transcript Connectors (Vision B): the engine owns transcript
  # knowledge; this host only hands over the agent identity + session id.
  # Empty values (agy/shell panes) are omitted -> scrollback fallback.
  [[ -n "$agent_kind" ]] && extra_flags+=(--agent "$agent_kind")
  [[ -n "$session_id" ]] && extra_flags+=(--session-id "$session_id")

  local err_tmp
  err_tmp=$(mktemp "/tmp/herdr-tts-err.XXXXXX")

  # Launch audio synthesis asynchronously in background and catch any runtime/synthesis errors
  (
    set +e
    "$VENV_PYTHON" "$ENGINE_SCRIPT" "$text" --voice "$voice" --rate "$rate" --max-chars "$TTS_MAX_CHARS" "${extra_flags[@]}" "${PROVIDER_FLAGS[@]}" > "$err_tmp" 2>&1
    local ret=$?
    if [[ $ret -ne 0 ]]; then
      report_tts_error "${target_pane:-Herdr}" "$err_tmp" "$ret"
    fi
    rm -f "$err_tmp"
  ) &
  local child_pid=$!
  echo "$child_pid" > "$PID_FILE"
  echo "$child_pid" > "$LOCK_FILE"
}

play_audio_file() {
  local file="$1"
  stop_audio
  local err_tmp
  err_tmp=$(mktemp "/tmp/herdr-tts-play-err.XXXXXX")
  # Playback errors must surface through the status popup, not only the log
  (
    set +e
    "$VENV_PYTHON" "$ENGINE_SCRIPT" --play-file "$file" > "$err_tmp" 2>&1
    local ret=$?
    if [[ $ret -ne 0 ]]; then
      report_tts_error "reproducción local" "$err_tmp" "$ret"
    fi
    rm -f "$err_tmp"
  ) &
  local child_pid=$!
  echo "$child_pid" > "$PID_FILE"
  echo "$child_pid" > "$LOCK_FILE"
}

send_ntfy_push() {
  local pane_id="$1"
  local agent="$2"
  local state="$3"
  local workspace="${4:-}"
  local title_desc="${5:-}"
  local audio_path="${6:-}"

  [[ -z "$NTFY_TOPIC" ]] && return 0

  local ntfy_url="${NTFY_SERVER}/${NTFY_TOPIC}"
  local focus_cmd="herdr agent focus ${pane_id}"
  local display_name="${agent} (${pane_id})"
  if [[ -n "$title_desc" && "$title_desc" != "$agent" ]]; then
    display_name="${agent} [${title_desc}] (${pane_id})"
  fi

  local action_buttons=""
  local target_url=""

  if [[ -n "$WEB_URL" ]]; then
    if [[ "$WEB_URL" == *"{pane_id}"* ]]; then
      target_url="${WEB_URL//\{pane_id\}/${pane_id}}"
    elif [[ -n "$pane_id" ]]; then
      target_url="${WEB_URL%/}/pane/${pane_id}"
    else
      target_url="${WEB_URL}"
    fi

    local btn_label="Abrir Web"
    if [[ -n "$WEB_LABEL" ]]; then
      btn_label="Abrir ${WEB_LABEL}"
    elif [[ "${WEB_URL,,}" =~ collie ]]; then
      btn_label="Abrir Collie"
    fi

    action_buttons="view, 📱 ${btn_label}, ${target_url}; copy, 📋 Copiar comando, ${focus_cmd}, clear=true"
  else
    action_buttons="copy, 📋 Copiar comando, ${focus_cmd}, clear=true"
  fi

  local title=""
  local body=""
  local priority="default"
  local tags="robot"

  case "$state" in
    done)
      title="✅ ${display_name} terminó"
      body="Agente ${display_name}${workspace:+ en ${workspace}} finalizó su tarea.\n\n→ Para ver: ${focus_cmd}"
      priority="default"
      tags="white_check_mark,robot"
      [[ -n "$audio_path" && -s "$audio_path" ]] && tags="white_check_mark,robot,loudspeaker"
      ;;
    blocked)
      title="🔴 ${display_name} necesita atención"
      body="Agente ${display_name}${workspace:+ en ${workspace}} está bloqueado y espera input.\n\n→ Para ver: ${focus_cmd}"
      priority="high"
      tags="rotating_light,warning"
      [[ -n "$audio_path" && -s "$audio_path" ]] && tags="rotating_light,warning,loudspeaker"
      ;;
    idle)
      title="💤 ${display_name} idle"
      body="Agente ${display_name}${workspace:+ en ${workspace}} pasó a idle."
      priority="low"
      tags="zzz"
      ;;
    *)
      return 0
      ;;
  esac

  local -a headers=(
    -H "Title: ${title}"
    -H "Priority: ${priority}"
    -H "Tags: ${tags}"
  )
  if [[ -n "$target_url" && "$CLICK_REDIRECT" == "on" ]]; then
    headers+=(-H "Click: ${target_url}")
  fi
  if [[ -n "$action_buttons" ]]; then
    headers+=(-H "Actions: ${action_buttons}")
  fi

  if [[ -n "$audio_path" && -f "$audio_path" && -s "$audio_path" ]]; then
    local safe_body="${body//$'\n'/ · }"
    local audio_bytes
    audio_bytes=$(stat -c%s "$audio_path" 2>/dev/null || echo "unknown")
    headers+=(
      -H "Message: ${safe_body}"
      -H "Filename: ${pane_id//:/_}-response.mp3"
    )
    echo "[$(date +%H:%M:%S)] [ntfy] 📤 Enviando push con audio (${audio_bytes} bytes) para ${pane_id} a ${NTFY_TOPIC}"
    curl -s --connect-timeout 5 --max-time 30 "${headers[@]}" -T "${audio_path}" "${ntfy_url}" > /dev/null 2>&1 || true
  else
    echo "[$(date +%H:%M:%S)] [ntfy] 📤 Enviando push de texto para ${pane_id} a ${NTFY_TOPIC}"
    curl -s --connect-timeout 5 --max-time 15 "${headers[@]}" -d "${body}" "${ntfy_url}" > /dev/null 2>&1 || true
  fi
}

get_focused_pane() {
  local pane
  # 1. Check Herdr API snapshot focused_pane_id
  pane=$(herdr api snapshot 2>/dev/null | jq -r '.result.snapshot.focused_pane_id // empty' 2>/dev/null || true)
  if [[ -n "$pane" ]]; then
    echo "$pane"
    return 0
  fi

  # 2. Check herdr pane current helper
  pane=$(herdr pane current 2>/dev/null | jq -r '.result.pane.pane_id // empty' 2>/dev/null || true)
  if [[ -n "$pane" ]]; then
    echo "$pane"
    return 0
  fi

  # 3. Check snapshot for focused == true
  pane=$(herdr api snapshot 2>/dev/null | jq -r '(.result.snapshot.panes[]? | select(.focused == true) | .pane_id) // empty' 2>/dev/null | head -n 1 || true)
  if [[ -n "$pane" ]]; then
    echo "$pane"
    return 0
  fi

  # 4. Fallback to env
  echo "${HERDR_PANE_ID:-${HERDR_PANE:-}}"
}

read_pane_text() {
  local target_pane="$1"
  local raw=""

  # 1. Prefer herdr pane read (works for ANY pane: agents, OpenCode, Claude, shells)
  raw=$(herdr pane read "$target_pane" --lines 300 --format text 2>/dev/null || true)

  # 2. Fallback to herdr agent read if pane read was empty
  if [[ -z "$raw" || "$raw" =~ ^[[:space:]]*$ ]]; then
    raw=$(herdr agent read "$target_pane" --lines 300 --format text 2>/dev/null || true)
  fi

  # If output is JSON wrapped, extract result.text
  if [[ "$raw" =~ ^[[:space:]]*\{.*"result" ]]; then
    local parsed
    parsed=$(echo "$raw" | jq -r '.result.text // .result // empty' 2>/dev/null || true)
    if [[ -n "$parsed" ]]; then
      echo "$parsed"
      return 0
    fi
  fi
  echo "$raw"
}

# Structured transcript knowledge lives in the ENGINE (agent-tts): this host
# only forwards the agent identity + session id via --agent/--session-id, and
# agent-tts resolves the last assistant message with its connector layer
# (OpenCode SQLite, Claude Code JSONL) or falls back to scrollback itself.

publish_podcast_episode() {
  local title="$1"
  local description="$2"
  local audio_file="$3"

  local pod_dir="${DATA_DIR}/podcast"
  mkdir -p "$pod_dir"
  "$VENV_PYTHON" -c "
import sys
from agent_tts.podcast import PodcastFeed
with open('$audio_file', 'rb') as f:
    data = f.read()
feed = PodcastFeed(base_dir='$pod_dir', base_url='http://localhost:${PODCAST_PORT}')
feed.add_episode(data, title='''$title''', description='''$description''')
" 2>/dev/null || true
  echo "[$(date +%H:%M:%S)] 🎙️ Episodio publicado en el feed privado de podcast"
}

publish_current_pane_podcast() {
  local target_pane
  target_pane=$(get_focused_pane)
  if [[ -z "$target_pane" ]]; then
    echo "⚠️ No hay ningún pane enfocado en Herdr" >&2
    return 1
  fi
  local text
  text=$(read_pane_text "$target_pane")
  if [[ -z "$text" || "$text" =~ ^[[:space:]]*$ ]]; then
    echo "ℹ️ El pane ${target_pane} no tiene contenido para publicar"
    return 0
  fi
  local tmp_audio="/tmp/herdr-tts-pod-${target_pane//:/_}-$RANDOM.mp3"
  echo "🎙️ Generando audio y publicando episodio en el feed de podcast..."
  render_text_audio "$tmp_audio" "$text" >/dev/null 2>&1 || true
  if [[ -s "$tmp_audio" ]]; then
    publish_podcast_episode "Actualización en ${target_pane}" "$text" "$tmp_audio"
    notify_herdr "🎙️ Podcast RSS" "Nuevo episodio publicado"
    echo "✓ Episodio publicado con éxito. RSS: http://localhost:${PODCAST_PORT}/podcast.xml"
    rm -f "$tmp_audio"
  else
    echo "Error: Falló la síntesis de audio" >&2
  fi
}

read_current_pane() {
  local target_pane="${1:-}"
  local tldr_flag="${2:-}"
  if [[ -z "$target_pane" ]]; then
    target_pane=$(get_focused_pane)
  fi

  if [[ -z "$target_pane" ]]; then
    echo "⚠️ No hay ningún pane enfocado en Herdr" >&2
    notify_herdr "⚠️ Herdr Voice" "No hay ningún pane enfocado"
    return 1
  fi

  local text
  text=$(read_pane_text "$target_pane")

  if [[ -z "$text" || "$text" =~ ^[[:space:]]*$ ]]; then
    echo "ℹ️ El pane ${target_pane} no tiene contenido para leer"
    notify_herdr "ℹ️ Herdr Voice" "El pane ${target_pane} no tiene contenido para leer"
    return 0
  fi

  # Agent identity for the connector layer: the engine (agent-tts) resolves
  # the transcript itself from these two ids; agy/shell panes yield empty
  # values and keep the scrollback path with turn extraction.
  local agent_kind=""
  local session_id=""
  local agent_info
  agent_info=$(herdr agent get "$target_pane" 2>/dev/null) || true
  if [[ -n "$agent_info" ]]; then
    agent_kind=$(echo "$agent_info" | jq -r '.result.agent.agent_session.agent // empty' 2>/dev/null || true)
    session_id=$(echo "$agent_info" | jq -r '.result.agent.agent_session.value // empty' 2>/dev/null || true)
  fi

  if [[ "$tldr_flag" == "--tldr" || "$tldr_flag" == "tldr" ]]; then
    echo "▶️ Resumiendo (TL;DR) y leyendo respuesta en ${target_pane}..."
    notify_herdr "Resumen TL;DR" "Sintetizando resumen para ${target_pane}..."
    speak_text "$text" "$TTS_VOICE" "$TTS_RATE" "--tldr" "$target_pane" "$agent_kind" "$session_id"
  else
    echo "▶️ Transcribiendo y leyendo respuesta en ${target_pane}..."
    notify_herdr "Transcribiendo respuesta" "Sintetizando voz para ${target_pane}..."
    speak_text "$text" "$TTS_VOICE" "$TTS_RATE" "" "$target_pane" "$agent_kind" "$session_id"
  fi
}

read_current_pane_visual() {
  local -a visual_flags=()
  local target_pane=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --highlight|-H) visual_flags+=(--highlight); shift ;;
      --autoscroll) visual_flags+=(--autoscroll); shift ;;
      --bionic) visual_flags+=(--bionic); shift ;;
      --zen) visual_flags+=(--zen); shift ;;
      --tldr|--summarize) visual_flags+=(--tldr); shift ;;
      *)
        if [[ -z "$target_pane" && "$1" != -* ]]; then
          target_pane="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$target_pane" ]]; then
    target_pane=$(get_focused_pane)
  fi

  if [[ -z "$target_pane" ]]; then
    echo "⚠️ No hay ningún pane enfocado en Herdr" >&2
    notify_herdr "⚠️ Herdr Voice" "No hay ningún pane enfocado"
    return 1
  fi

  local text
  text=$(read_pane_text "$target_pane")

  if [[ -z "$text" || "$text" =~ ^[[:space:]]*$ ]]; then
    echo "ℹ️ El pane ${target_pane} no tiene contenido para leer"
    notify_herdr "ℹ️ Herdr Voice" "El pane ${target_pane} no tiene contenido para leer"
    return 0
  fi

  # Agent identity for the connector layer (see read_current_pane): the
  # engine resolves the transcript from these ids; scrollback text is the
  # fallback the engine applies itself when no connector matches.
  local agent_kind=""
  local session_id=""
  local agent_info
  agent_info=$(herdr agent get "$target_pane" 2>/dev/null) || true
  if [[ -n "$agent_info" ]]; then
    agent_kind=$(echo "$agent_info" | jq -r '.result.agent.agent_session.agent // empty' 2>/dev/null || true)
    session_id=$(echo "$agent_info" | jq -r '.result.agent.agent_session.value // empty' 2>/dev/null || true)
  fi

  local -a source_flags=()
  [[ -n "$agent_kind" ]] && source_flags+=(--agent "$agent_kind")
  [[ -n "$session_id" ]] && source_flags+=(--session-id "$session_id")

  stop_audio
  build_provider_flags

  echo "▶️ Iniciando lectura sincronizada en ${target_pane}..."
  if ! "$VENV_PYTHON" "$ENGINE_SCRIPT" "$text" --voice "$TTS_VOICE" --rate "$TTS_RATE" --max-chars "$TTS_MAX_CHARS" "${visual_flags[@]}" "${source_flags[@]}" "${PROVIDER_FLAGS[@]}"; then
    notify_herdr "❌ Error en TTS (${target_pane})" "Fallo en reproducción o lectura visual" "request"
  fi
}

render_pane_audio() {
  local target_pane="${1:-}"
  local output_file="${2:-}"

  if [[ -z "$target_pane" ]]; then
    target_pane=$(get_focused_pane)
  fi

  if [[ -z "$target_pane" || -z "$output_file" ]]; then
    echo "Uso: herdr-tts --render-pane <pane_id> <output_file.mp3>" >&2
    return 1
  fi

  local text
  text=$(read_pane_text "$target_pane")
  if [[ -z "$text" || "$text" =~ ^[[:space:]]*$ ]]; then
    return 1
  fi

  build_provider_flags
  if "$VENV_PYTHON" "$ENGINE_SCRIPT" "$text" --voice "$TTS_VOICE" --rate "$TTS_RATE" --max-chars "$TTS_MAX_CHARS" --output "$output_file" --no-play "${PROVIDER_FLAGS[@]}"; then
    # Audio ledger for the dashboard history (best effort; no agent context
    # here). The 5th field carries the first ~120 chars of the spoken text.
    local hist_snippet
    history_snippet hist_snippet "$text"
    append_audio_history "$target_pane" "-" "$(audio_duration_secs "$output_file")" "$hist_snippet"
    return 0
  fi
  return 1
}

render_text_audio() {
  local output_file="${1:-}"
  shift || true
  local -a source_flags=()
  local -a text_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent)
        source_flags+=(--agent "${2:-}")
        { [[ $# -ge 2 ]] && shift 2; } || shift
        ;;
      --session-id)
        source_flags+=(--session-id "${2:-}")
        { [[ $# -ge 2 ]] && shift 2; } || shift
        ;;
      *)
        text_args+=("$1")
        shift
        ;;
    esac
  done
  local text="${text_args[*]:-}"

  if [[ -z "$output_file" ]]; then
    echo "Uso: herdr-tts --render-text <output_file.mp3> [texto...] [--agent <tipo>] [--session-id <id>]" >&2
    return 1
  fi

  if [[ -z "$text" && ! -t 0 ]]; then
    text=$(cat)
  fi

  if [[ -z "$text" ]]; then
    return 1
  fi

  build_provider_flags
  "$VENV_PYTHON" "$ENGINE_SCRIPT" "$text" --voice "$TTS_VOICE" --rate "$TTS_RATE" --max-chars "$TTS_MAX_CHARS" --output "$output_file" --no-play "${source_flags[@]}" "${PROVIDER_FLAGS[@]}"
}

toggle_play() {
  local target_pane=""
  local tldr_flag=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --tldr|tldr)
        tldr_flag="--tldr"
        shift
        ;;
      *)
        if [[ -z "$target_pane" ]]; then
          target_pane="$1"
        fi
        shift
        ;;
    esac
  done

  if is_playing; then
    stop_audio
  else
    read_current_pane "$target_pane" "$tldr_flag"
  fi
}

is_auto_muted() {
  [[ -f "$AUTO_MUTE_FILE" ]]
}

toggle_auto() {
  if is_auto_muted; then
    rm -f "$AUTO_MUTE_FILE"
    echo "🔊 Lectura automática de fondo activada"
    notify_herdr "🔊 Herdr Voice" "Lectura automática activada"
    speak_text "Lectura automática activada."
  else
    touch "$AUTO_MUTE_FILE"
    echo "🔇 Lectura automática de fondo silenciada"
    notify_herdr "🔇 Herdr Voice" "Lectura automática silenciada (solo manual)"
    speak_text "Lectura automática silenciada."
  fi
}

show_status() {
  echo "━━━ Herdr TTS Status ━━━"
  local p_status
  p_status=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd "status" 2>/dev/null || true)
  if [[ -n "$p_status" && "$p_status" != *"Error:"* ]]; then
    local status pos total
    status=$(echo "$p_status" | grep -o 'status=[a-z]*' | cut -d= -f2)
    pos=$(echo "$p_status" | grep -o 'pos=[0-9.]*' | cut -d= -f2)
    total=$(echo "$p_status" | grep -o 'total=[0-9.]*' | cut -d= -f2)
    local pos_int=${pos%.*}
    local total_int=${total%.*}
    local pos_m=$(( ${pos_int:-0} / 60 ))
    local pos_s=$(( ${pos_int:-0} % 60 ))
    local tot_m=$(( ${total_int:-0} / 60 ))
    local tot_s=$(( ${total_int:-0} % 60 ))
    local time_label
    time_label=$(printf "%d:%02d / %d:%02d" "$pos_m" "$pos_s" "$tot_m" "$tot_s")
    if [[ "$status" == "synthesizing" ]]; then
      echo "  Reproducción: ⏳ Sintetizando respuesta de voz (Lock activo)"
    elif [[ "$status" == "paused" ]]; then
      echo "  Reproducción: ⏸️ Pausado en ${time_label} (Lock activo)"
    else
      echo "  Reproducción: 🔊 Hablando en ${time_label} (Lock activo)"
    fi
  elif is_playing; then
    echo "  Reproducción: 🔊 Hablando ahora (Lock activo)"
  else
    echo "  Reproducción: ⏹️ En reposo"
  fi

  if is_auto_muted; then
    echo "  Auto-lectura: 🔇 Silenciada en PC (Solo manual vía prefix+r)"
  else
    echo "  Auto-lectura: 🔊 Activa en altavoces del PC"
  fi

  # Snooze / mute / debounce gating state
  local gate_state g_until muted_list
  gate_state=$(load_snooze_state)
  g_until=$(jq -r '(.global_snooze_until // 0)' <<<"$gate_state")
  if (( g_until > $(date +%s) )); then
    echo "  Snooze global: 😴 activo hasta las $(fmt_epoch_clock "$g_until") (prefix+Z cicla 5m → 30m → 2h → off)"
  else
    echo "  Snooze global: ⚪ Desactivado (prefix+Z cicla 5m → 30m → 2h → off)"
  fi
  muted_list=$(jq -r '[.panes // {} | to_entries[] | select(.value.muted == true) | .key] | join(", ")' <<<"$gate_state")
  echo "  Panes silenciados: ${muted_list:-ninguno} (prefix+m, se reactivan al cerrarse el pane)"
  echo "  Debounce anti-spam: ${TTS_DEBOUNCE_SECONDS}s por (pane, estado) — TTS_DEBOUNCE_SECONDS / --debounce"

  echo "  Alcance auto: ${TTS_AUTO_SCOPE} (focused = solo chat activo; all = cualquiera sin solaparse)"
  echo "  Proveedor:    ${TTS_PROVIDER} (edge = Edge Neural TTS gratuito; openai = OpenAI TTS; elevenlabs = ElevenLabs; piper = 100% Offline Local Neural)"
  if [[ "$TTS_PROVIDER" == "openai" ]]; then
    local masked_key="no configurada"
    if [[ -n "$OPENAI_API_KEY" ]]; then
      masked_key="${OPENAI_API_KEY:0:7}...${OPENAI_API_KEY: -4}"
    fi
    echo "  OpenAI TTS:   Modelo: ${OPENAI_TTS_MODEL} | Base URL: ${OPENAI_BASE_URL} | API Key: ${masked_key}"
  elif [[ "$TTS_PROVIDER" =~ ^eleven ]]; then
    local masked_key="no configurada"
    if [[ -n "$ELEVENLABS_API_KEY" ]]; then
      masked_key="${ELEVENLABS_API_KEY:0:5}...${ELEVENLABS_API_KEY: -4}"
    fi
    echo "  ElevenLabs:   Modelo: ${ELEVENLABS_MODEL} | API Key: ${masked_key}"
  elif [[ "$TTS_PROVIDER" == "piper" || "$TTS_PROVIDER" == "local" ]]; then
    echo "  Piper Local:  Modelo ONNX: ${PIPER_MODEL:-'(voz por defecto / PATH)'}"
  fi
  echo "  Voz:          ${TTS_VOICE}"
  echo "  Velocidad:    ${TTS_RATE}"
  echo "  Max chars:    ${TTS_MAX_CHARS}"
  echo "  Idioma auto:  ${TTS_AUTO_LANG} (detección automática y cambio de voz entre ES y EN)"
  if [[ "$PODCAST_ENABLED" == "on" ]]; then
    echo "  Podcast RSS:  🔔 Activo (http://localhost:${PODCAST_PORT}/podcast.xml | Servidor: --podcast-serve)"
  else
    echo "  Podcast RSS:  ⚪ Desactivado (opcional vía --podcast on | servidor vía --podcast-serve)"
  fi

  if [[ -n "$NTFY_TOPIC" ]]; then
    echo "  Push móvil:   🔔 Activo (ntfy: ${NTFY_TOPIC} | Servidor: ${NTFY_SERVER})"
  else
    echo "  Push móvil:   ⚪ Desactivado (opcional vía --ntfy-topic <topic>)"
  fi
  if [[ -n "$WEB_URL" ]]; then
    local label="${WEB_LABEL:-}"
    if [[ -z "$label" ]]; then
      [[ "${WEB_URL,,}" =~ collie ]] && label="Collie" || label="Web"
    fi
    echo "  Redirección:  📱 ${label} (${WEB_URL})"
    echo "  Click directo: ${CLICK_REDIRECT} (on = abrir web al tocar notificación; off = abrir reproductor de audio)"
  else
    echo "  Redirección:  ⚪ Desactivada (opcional vía --web-url <url> o --collie-url <url>)"
  fi

  echo "  Plugin root:  ${PLUGIN_ROOT}"
  echo "  Config:       ${CONFIG_FILE}"
}

# ─── Snooze / Mute / Debounce gating (pre-engine) ────────────
# Lightweight timestamp state shared by all watchers and CLI toggles.
# Writes are atomic (temp file + mv in the same directory); reads fail
# open: a missing or corrupt file is treated as "no snooze, no mute"
# so speech never breaks because of leftover state.

SNOOZE_STAGE_SECONDS=(300 1800 7200) # 5m → 30m → 2h
SNOOZE_STAGE_LABELS=("5 minutos" "30 minutos" "2 horas")

fmt_epoch_clock() {
  local epoch="$1"
  date -d "@${epoch}" +%H:%M 2>/dev/null || date -r "$epoch" +%H:%M 2>/dev/null || echo "??:??"
}

load_snooze_state() {
  if [[ -s "$SNOOZE_STATE_FILE" ]]; then
    jq -c . "$SNOOZE_STATE_FILE" 2>/dev/null || echo '{}'
  else
    echo '{}'
  fi
}

save_snooze_state() {
  local json="$1"
  local tmp
  tmp=$(mktemp "${SNOOZE_STATE_FILE}.XXXXXX") 2>/dev/null || return 1
  printf '%s' "$json" > "$tmp" && mv -f "$tmp" "$SNOOZE_STATE_FILE"
}

# Cycle snooze for the focused pane (scope=pane) or for all agents
# (scope=global): 5m → 30m → 2h → off. Announces the new state. An
# explicit pane id (used by the dashboard cursor) wins over focus.
cycle_snooze() {
  local scope="${1:-pane}" # pane | global
  local target_pane="${2:-}"

  if [[ "$scope" == "pane" ]]; then
    if [[ -z "$target_pane" ]]; then
      target_pane=$(get_focused_pane)
    fi
    if [[ -z "$target_pane" ]]; then
      echo "⚠️ No hay ningún pane enfocado en Herdr" >&2
      notify_herdr "⚠️ Herdr Voice" "No hay ningún pane enfocado"
      return 1
    fi
  fi

  local now state stage until_ts new_stage new_until msg
  now=$(date +%s)
  state=$(load_snooze_state)

  if [[ "$scope" == "pane" ]]; then
    stage=$(jq -r --arg p "$target_pane" '(.panes[$p].snooze_stage // 0)' <<<"$state")
    until_ts=$(jq -r --arg p "$target_pane" '(.panes[$p].snooze_until // 0)' <<<"$state")
  else
    stage=$(jq -r '(.global_snooze_stage // 0)' <<<"$state")
    until_ts=$(jq -r '(.global_snooze_until // 0)' <<<"$state")
  fi

  # An expired snooze counts as off for the cycle
  (( until_ts <= now )) && stage=0

  new_stage=$(( stage + 1 ))
  if (( new_stage > ${#SNOOZE_STAGE_SECONDS[@]} )); then
    new_stage=0
  fi

  if (( new_stage > 0 )); then
    new_until=$(( now + SNOOZE_STAGE_SECONDS[new_stage - 1] ))
    local label="${SNOOZE_STAGE_LABELS[new_stage - 1]}"
    local clock
    clock=$(fmt_epoch_clock "$new_until")
    if [[ "$scope" == "pane" ]]; then
      msg="😴 Snooze ${target_pane}: ${label} (sin voz hasta las ${clock})"
    else
      msg="😴 Snooze GLOBAL: ${label} (todos los agentes en silencio hasta las ${clock})"
    fi
  else
    new_until=0
    if [[ "$scope" == "pane" ]]; then
      msg="🔊 Snooze desactivado en ${target_pane}"
    else
      msg="🔊 Snooze GLOBAL desactivado (los agentes vuelven a hablar)"
    fi
  fi

  if [[ "$scope" == "pane" ]]; then
    state=$(jq -c --arg p "$target_pane" --argjson stage "$new_stage" --argjson until "$new_until" \
      '.panes = ((.panes // {}) + {($p): ((.panes[$p] // {}) + {snooze_stage: $stage, snooze_until: $until})})' <<<"$state")
  else
    state=$(jq -c --argjson stage "$new_stage" --argjson until "$new_until" \
      '. + {global_snooze_stage: $stage, global_snooze_until: $until}' <<<"$state")
  fi
  save_snooze_state "$state" || true

  echo "$msg"
  notify_herdr "😴 Herdr TTS Snooze" "$msg"
}

# Exclusive mute of the focused pane (or of an explicitly passed pane id,
# as done by the dashboard cursor). Tied to the pane lifecycle, not to a
# timer: the daemon prune drops the flag as soon as the pane disappears
# from `herdr agent list`, so it auto-clears when the pane closes.
toggle_pane_mute() {
  local target_pane="${1:-}"
  if [[ -z "$target_pane" ]]; then
    target_pane=$(get_focused_pane)
  fi
  if [[ -z "$target_pane" ]]; then
    echo "⚠️ No hay ningún pane enfocado en Herdr" >&2
    notify_herdr "⚠️ Herdr Voice" "No hay ningún pane enfocado"
    return 1
  fi

  local state muted
  state=$(load_snooze_state)
  muted=$(jq -r --arg p "$target_pane" '(.panes[$p].muted // false)' <<<"$state")

  if [[ "$muted" == "true" ]]; then
    state=$(jq -c --arg p "$target_pane" '.panes[$p].muted = false' <<<"$state")
    echo "🔊 Voz reactivada en ${target_pane}"
    notify_herdr "🔊 Herdr TTS" "Voz reactivada en ${target_pane}"
  else
    state=$(jq -c --arg p "$target_pane" \
      '.panes = ((.panes // {}) + {($p): ((.panes[$p] // {}) + {muted: true})})' <<<"$state")
    echo "🔇 Pane ${target_pane} silenciado (se reactiva al cerrarse el pane)"
    notify_herdr "🔇 Herdr TTS" "Pane ${target_pane} silenciado (auto al cerrar)"
  fi
  save_snooze_state "$state" || true
}

# Pane lifecycle hook: runs on every daemon sweep with the live agent list.
# Mute (plus snooze/debounce leftovers) for panes that no longer exist are
# dropped, which is what makes pane mute auto-clear when the pane closes.
prune_snooze_state() {
  local raw_agents="$1"
  local panes now state pruned
  panes=$(printf '%s' "$raw_agents" | jq -c '[.result.agents[]?.pane_id | select(. != null)]' 2>/dev/null) || return 0
  now=$(date +%s)
  state=$(load_snooze_state)
  pruned=$(jq -c --argjson panes "$panes" --argjson now "$now" --argjson win "${TTS_DEBOUNCE_SECONDS:-20}" '
    .panes = ((.panes // {}) | with_entries(select(.key as $k | ($panes | index($k)) != null)))
    | .debounce = ((.debounce // {}) | with_entries(
        select((.key as $k | ($panes | index($k)) != null)
               and (($now - (.value.done // 0)) < $win))))' <<<"$state") || return 0
  [[ "$pruned" == "$state" ]] || save_snooze_state "$pruned" || true
}

# ─── Ambient pane-title glyphs (v0.11) ───────────────────────
# The daemon sweep piggybacks a title sync: agent panes whose voice state
# needs attention (done/blocked, muted, snoozed) get a glyph prefix on
# their pane title. Idempotent and rename-only-on-change: the pane's
# ORIGINAL title is cached once in the snooze state file (field
# `title_original` under the pane key — the existing prune sweep drops it
# for free when the pane closes) and every sweep only calls
# `herdr pane rename` when the live title drifted from the expected one.
# RESTORE is sacred: as soon as no glyph applies, the pane goes back to
# its cached original title and the cache entry is dropped; without a
# cache, any leading run of our own markers is stripped instead. Titles
# that match neither the expected value nor our marker pattern (and have
# no cache) are ADOPTED as the new original so integrations that rename
# panes are never fought over.

TITLE_GLYPH_DONE="✔"     # agent_status done/blocked
TITLE_GLYPH_MUTE="🔇"    # pane muted in the gating ledger
TITLE_GLYPH_SNOOZE="😴"  # per-pane snooze active in the gating ledger
TITLE_GLYPH_SEP=" | "    # joins the glyph block with the original title
# Leading marker run matcher/stripper (literal alternation, multibyte-safe).
TITLE_GLYPHS_RE='^((✔|🔇|😴)[[:space:]]?)+\|[[:space:]]?'

strip_title_glyphs() { # <out-var> <title>
  local _sg_s="$2"
  while [[ "$_sg_s" =~ $TITLE_GLYPHS_RE ]]; do
    _sg_s="${_sg_s#${BASH_REMATCH[0]}}"
  done
  printf -v "$1" '%s' "$_sg_s"
}

# One sweep of title sync over the agent list the daemon already fetched:
# ONE jq pass over the agents snapshot + ONE over the gating ledger, then
# only the drifted panes get a `herdr pane rename` spawn. Fails open: no
# agents snapshot or no jq output means nothing to do.
sync_pane_titles() { # <raw_agents_json>
  local now state rows
  now=$(date +%s)
  state=$(load_snooze_state)
  rows=$(printf '%s' "$1" | jq -r '
      .result.agents[]?
      | "\(.pane_id // "")\t\(.agent_status // "")\t\((.terminal_title_stripped // .terminal_title // "") | gsub("[\\t\\r\\n]"; " "))"
    ' 2>/dev/null) || return 0
  [[ -z "$rows" ]] && return 0

  # Single pass over the gating ledger: muted flag, active per-pane snooze
  # and any cached original title, keyed by pane_id.
  local -A s_muted=() s_snoozed=() s_orig=()
  local kp km ku ko
  while IFS=$'\t' read -r kp km ku ko; do
    [[ -z "$kp" ]] && continue
    [[ "$km" == "true" ]] && s_muted["$kp"]=1
    if [[ "$ku" =~ ^[0-9]+$ ]] && (( ku > now )); then
      s_snoozed["$kp"]=1
    fi
    [[ -n "$ko" ]] && s_orig["$kp"]="$ko"
  done < <(jq -r '
      ((.panes // {}) | to_entries[])
      | [ .key,
          ((.value.muted // false)|tostring),
          ((.value.snooze_until // 0)|tostring),
          ((.value.title_original // "")|tostring) ] | @tsv
    ' <<<"$state" 2>/dev/null || true)

  local changed=false
  local p st title glyphs original expected clean
  while IFS=$'\t' read -r p st title; do
    # Never touch panes without an agent entry or without a title to guard.
    [[ -z "$p" || "$p" == "null" || -z "$title" ]] && continue
    original="${s_orig[$p]:-}"

    glyphs=""
    case "$st" in done|blocked) glyphs+="$TITLE_GLYPH_DONE" ;; esac
    [[ -n "${s_muted[$p]:-}" ]] && glyphs+="$TITLE_GLYPH_MUTE"
    [[ -n "${s_snoozed[$p]:-}" ]] && glyphs+="$TITLE_GLYPH_SNOOZE"

    if [[ -z "$glyphs" ]]; then
      # Restore path: no glyph applies anymore.
      if [[ -n "$original" ]]; then
        if [[ "$title" != "$original" ]]; then
          herdr pane rename "$p" "$original" >/dev/null 2>&1 || true
          changed=true
        fi
        state=$(jq -c --arg p "$p" 'del(.panes[$p].title_original)' <<<"$state")
        changed=true
      else
        strip_title_glyphs clean "$title"
        if [[ "$clean" != "$title" ]]; then
          herdr pane rename "$p" "$clean" >/dev/null 2>&1 || true
          changed=true
        fi
      fi
      continue
    fi

    # Prefix path: recover (or adopt) the original title first.
    if [[ -z "$original" ]]; then
      if [[ "$title" =~ $TITLE_GLYPHS_RE ]]; then
        strip_title_glyphs clean "$title" # daemon restarted, cache lost
      else
        clean="$title"
      fi
      original="$clean"
      state=$(jq -c --arg p "$p" --arg o "$original" \
        '.panes = ((.panes // {}) + {($p): ((.panes[$p] // {}) + {title_original: $o})})' <<<"$state")
      changed=true
    elif [[ "$title" != "$original" && ! "$title" =~ $TITLE_GLYPHS_RE ]]; then
      # Integration renamed the pane mid-session: adopt its title as the
      # new original instead of fighting over the label.
      original="$title"
      state=$(jq -c --arg p "$p" --arg o "$original" \
        '.panes = ((.panes // {}) + {($p): ((.panes[$p] // {}) + {title_original: $o})})' <<<"$state")
      changed=true
    fi
    expected="${glyphs}${TITLE_GLYPH_SEP}${original}"
    if [[ "$title" != "$expected" ]]; then
      herdr pane rename "$p" "$expected" >/dev/null 2>&1 || true
      changed=true
    fi
  done <<<"$rows"

  if [[ "$changed" == true ]]; then
    save_snooze_state "$state" || true
  fi
  return 0
}

# Daemon call-site guard: with TTS_TITLE_GLYPHS=0 the title sync is fully
# off and the sweep spawns NOTHING for titles (not even a jq pass).
daemon_title_sync() { # <raw_agents_json>
  [[ "${TTS_TITLE_GLYPHS:-1}" == "0" ]] && return 0
  sync_pane_titles "$1"
}

# Decide whether a watcher done/blocked event must be silenced BEFORE it
# reaches the synthesis engine. Returns 0 = gate (no speech, no engine
# call, log only), 1 = allow. Allowed events refresh the (pane, status)
# debounce ledger; the same pane repeating the same status inside the
# window is dropped, while a different status (done right after blocked)
# is never debounced.
gate_agent_event() {
  local pane_id="$1"
  local status="$2"
  local agent_name="${3:-$pane_id}"
  local now state muted until_ts last_seen

  now=$(date +%s)
  state=$(load_snooze_state)

  # 1. Per-pane mute (lifecycle-tied, cleared on pane close)
  muted=$(jq -r --arg p "$pane_id" '(.panes[$p].muted // false)' <<<"$state")
  if [[ "$muted" == "true" ]]; then
    echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): ${status} omitido (pane silenciado con prefix+m)"
    return 0
  fi

  # 2. Per-pane snooze
  until_ts=$(jq -r --arg p "$pane_id" '(.panes[$p].snooze_until // 0)' <<<"$state")
  if (( until_ts > now )); then
    echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): ${status} omitido (snooze hasta las $(fmt_epoch_clock "$until_ts"))"
    return 0
  fi

  # 3. Global snooze (meetings / focus)
  until_ts=$(jq -r '(.global_snooze_until // 0)' <<<"$state")
  if (( until_ts > now )); then
    echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): ${status} omitido (snooze GLOBAL hasta las $(fmt_epoch_clock "$until_ts"))"
    return 0
  fi

  # 4. Anti-spam debounce keyed by (pane_id, status)
  last_seen=$(jq -r --arg p "$pane_id" --arg s "$status" '(.debounce[$p][$s] // 0)' <<<"$state")
  if (( now - last_seen < TTS_DEBOUNCE_SECONDS )); then
    echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): ${status} repetido en menos de ${TTS_DEBOUNCE_SECONDS}s (debounce, omitido)"
    return 0
  fi

  # Allowed: record this (pane, status) sighting atomically
  state=$(jq -c --arg p "$pane_id" --arg s "$status" --argjson t "$now" \
    '.debounce = ((.debounce // {}) + {($p): ((.debounce[$p] // {}) + {($s): $t})})' <<<"$state")
  save_snooze_state "$state" || true
  return 1
}

# ─── Audio history ledger ────────────────────────────────────
# Append-only TSV ledger consumed by the dashboard: one line per rendered
# audio — <ISO timestamp> <TAB> <pane> <TAB> <agent> <TAB> <duration>
# [<TAB> <snippet>]. v0.11 added the 5th field: the first ~120 chars of
# the spoken text, single-line sanitized. Consumers must treat each row
# as 4-field (legacy) or 5-field; rows are never rewritten in place.
# Best effort by design: a history write failure must never break the
# speech path.

# Duration (seconds, 1 decimal) of a finished render. The engine prints no
# duration on --no-play renders and no IPC session survives them, so the
# real value comes from decoding the MP3 with the engine's own miniaudio
# (already in the venv). Budget: one extra engine-environment invocation
# per completed render, best effort, never blocking on failure.
audio_duration_secs() {
  local audio_file="$1"
  [[ -s "$audio_file" ]] || return 0
  "$VENV_PYTHON" -c '
import sys
import miniaudio
decoded = miniaudio.decode(open(sys.argv[1], "rb").read())
print(len(decoded.samples) / float(decoded.sample_rate * decoded.nchannels))
' "$audio_file" 2>/dev/null || true
}

# First ~120 chars of the spoken text as a single sanitized line: ANSI
# escape sequences stripped, CR/LF/tabs folded to spaces, control chars
# dropped, whitespace collapsed. Internal names are _hs_-prefixed on
# purpose: printf -v must reach the CALLER's variable, so no local may
# shadow a plausible out-var name (same discipline as dashboard_clamp_line).
history_snippet() { # <out-var> <text>
  local _hs_esc=$'\033' _hs_buf
  _hs_buf=$(printf '%s' "$2" \
    | sed -E -e "s/${_hs_esc}\\[[0-9;?]*[a-zA-Z]//g" -e "s/${_hs_esc}[@-Z\\\\-_]//g" \
    | tr '\n\t\r' '   ' \
    | tr -d '\000-\010\013\014\016-\037\177' \
    | tr -s ' ' \
    | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  printf -v "$1" '%s' "${_hs_buf:0:120}"
}

append_audio_history() { # <pane_id> <agent> <duration> [snippet]
  local pane_id="${1:--}"
  local agent="${2:--}"
  local duration="${3:--}"
  local snippet
  history_snippet snippet "${4:-}"
  # An empty probe result (engine decode failed) keeps the v1 "-" column.
  [[ -n "$duration" ]] || duration="-"
  mkdir -p "${HISTORY_FILE%/*}" 2>/dev/null || true
  if [[ -n "$snippet" ]]; then
    printf '%s\t%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$pane_id" "$agent" "$duration" "$snippet" \
      >> "$HISTORY_FILE" 2>/dev/null || true
  else
    # No usable snippet → keep the plain legacy 4-field row (no empty tail).
    printf '%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$pane_id" "$agent" "$duration" \
      >> "$HISTORY_FILE" 2>/dev/null || true
  fi
}

# ─── Watcher daemon ──────────────────────────────────────────

watch_agent_pane() {
  local pane_id="$1"
  local agent_name="$2"
  local prev_state="working"

  while true; do
    herdr agent wait "$pane_id" --until done --until blocked --until idle 2>/dev/null || {
      sleep 3
      continue
    }

    local info
    info=$(herdr agent get "$pane_id" 2>/dev/null) || { sleep 3; continue; }
    local new_state
    new_state=$(echo "$info" | jq -r '.result.agent.agent_status // .result.agent_status // "unknown"' 2>/dev/null || echo "unknown")
    # Agent identity for the connector layer: the engine (agent-tts) owns the
    # transcript knowledge and resolves the last assistant message itself.
    local agent_kind
    agent_kind=$(echo "$info" | jq -r '.result.agent.agent_session.agent // empty' 2>/dev/null || true)
    local session_id
    session_id=$(echo "$info" | jq -r '.result.agent.agent_session.value // empty' 2>/dev/null || true)

    if [[ "$new_state" != "$prev_state" && "$new_state" != "working" && "$new_state" != "unknown" ]]; then
      local workspace
      workspace=$(echo "$info" | jq -r '.result.agent.workspace_id // .result.workspace_id // ""' 2>/dev/null || true)
      local title_desc
      title_desc=$(echo "$info" | jq -r '.result.agent.terminal_title_stripped // .result.agent.terminal_title // .result.terminal_title // ""' 2>/dev/null || true)

      echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): ${prev_state} → ${new_state}"

      # Pre-engine gating: snooze / mute / debounce. A gated event is
      # logged and dropped before any synthesis, playback or push; the
      # audio mutex below is untouched (it only serializes playback).
      if [[ "$new_state" == "done" || "$new_state" == "blocked" ]] && ! gate_agent_event "$pane_id" "$new_state" "$agent_name"; then
        # 0.6s grace period for multiplexer scrollback flush
        sleep 0.6

        # Connector flags only: the engine resolves the structured transcript
        # (OpenCode SQLite, Claude Code JSONL) and falls back to the scrollback
        # text on its own when no connector matches.
        local -a render_flags=()
        [[ -n "$agent_kind" ]] && render_flags+=(--agent "$agent_kind")
        [[ -n "$session_id" ]] && render_flags+=(--session-id "$session_id")

        local pane_text
        pane_text=$(read_pane_text "$pane_id")

        if [[ -n "$pane_text" && ! "$pane_text" =~ ^[[:space:]]*$ ]]; then
          local tmp_audio="/tmp/herdr-tts-${pane_id//:/_}-${BASHPID:-$$}-$RANDOM.mp3"

          # 1. Synthesize audio file once, surfacing failures through the status popup
          local synth_err
          synth_err=$(mktemp "/tmp/herdr-tts-synth-err.XXXXXX")
          if ! render_text_audio "$tmp_audio" "$pane_text" "${render_flags[@]}" > "$synth_err" 2>&1; then
            report_tts_error "${pane_id}" "$synth_err" 1
          fi
          rm -f "$synth_err"

          # Audio ledger for the dashboard history (best effort). The
          # 5th field carries the first ~120 chars of the spoken text.
          if [[ -s "$tmp_audio" ]]; then
            local hist_snippet
            history_snippet hist_snippet "$pane_text"
            append_audio_history "$pane_id" "${agent_kind:-$agent_name}" "$(audio_duration_secs "$tmp_audio")" "$hist_snippet"
          fi

          # 2. Push notification (mobile via ntfy, if configured)
          if [[ -n "$NTFY_TOPIC" ]]; then
            send_ntfy_push "$pane_id" "$agent_name" "$new_state" "$workspace" "$title_desc" "$tmp_audio"
          fi

          # 2.5 Private Podcast Feed (if enabled)
          if [[ "$PODCAST_ENABLED" == "on" && -s "$tmp_audio" ]]; then
            publish_podcast_episode "${agent_name} (${new_state}): ${title_desc:-$workspace}" "$pane_text" "$tmp_audio"
          fi

          # 3. Local desktop voice playback
          local should_speak_local=true
          if is_auto_muted; then
            should_speak_local=false
          elif [[ "$TTS_AUTO_SCOPE" == "focused" ]]; then
            local current_focused
            current_focused=$(get_focused_pane)
            if [[ "$current_focused" != "$pane_id" ]]; then
              echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): terminó en segundo plano (no enfocado, omitiendo voz local)"
              should_speak_local=false
            fi
          fi

          if is_playing; then
            echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): ya hay otro chat hablando en local (omitido para evitar solapamiento)"
            should_speak_local=false
          fi

          if [[ "$should_speak_local" == true && -s "$tmp_audio" ]]; then
            echo "[$(date +%H:%M:%S)] ${agent_name} (${pane_id}): vocalizando en altavoces locales"
            play_audio_file "$tmp_audio"
          fi

          # Clean up temporary audio file after local player decodes it
          if [[ "$should_speak_local" == true ]]; then
            ( sleep 6 && rm -f "$tmp_audio" ) &
          else
            rm -f "$tmp_audio"
          fi
        fi
      elif [[ "$new_state" == "idle" && "$prev_state" == "working" && -n "$NTFY_TOPIC" ]]; then
        send_ntfy_push "$pane_id" "$agent_name" "idle" "$workspace" "$title_desc" ""
      fi
    fi

    prev_state="$new_state"
    herdr agent wait "$pane_id" --until working 2>/dev/null || sleep 3
    prev_state="working"
  done
}

run_daemon() {
  echo "🔊 Iniciando Herdr TTS Daemon (con Mutex y Scope ${TTS_AUTO_SCOPE})..."
  show_status

  CHILD_PIDS=()
  cleanup() {
    for pid in "${CHILD_PIDS[@]:-}"; do
      kill "$pid" 2>/dev/null || true
    done
    rm -f /tmp/herdr-tts-watcher-*.lock 2>/dev/null || true
    stop_audio
    exit 0
  }
  trap cleanup EXIT INT TERM

  while true; do
    local raw_agents
    raw_agents=$(herdr agent list 2>/dev/null) || { sleep 4; continue; }

    # Pane lifecycle: drop mute/snooze/debounce state for closed panes
    prune_snooze_state "$raw_agents"

    # Ambient title glyphs (done/muted/snoozed) piggyback on this sweep —
    # no extra `herdr agent list`, only rename spawns for drifted panes.
    daemon_title_sync "$raw_agents"

    while IFS=$'\t' read -r pane_id agent_name; do
      [[ -z "$pane_id" || "$pane_id" == "null" ]] && continue

      local lock_file="/tmp/herdr-tts-watcher-${pane_id//:/_}.lock"
      if [[ -f "$lock_file" ]]; then
        local existing_pid
        existing_pid=$(cat "$lock_file" 2>/dev/null || true)
        if [[ -n "$existing_pid" ]] && kill -0 "$existing_pid" 2>/dev/null; then
          continue
        fi
      fi

      watch_agent_pane "$pane_id" "$agent_name" &
      local child_pid=$!
      echo "$child_pid" > "$lock_file"
      CHILD_PIDS+=("$child_pid")
    done < <(echo "$raw_agents" | jq -r '.result.agents[]? | "\(.pane_id)\t\(.agent)"' 2>/dev/null || true)

    sleep 4
  done
}

# ─── Dashboard pane (v3, per-chat view) ──────────────────────
# Compact in-terminal status panel (--dashboard), designed to run as a
# Herdr plugin pane ([[panes]] entrypoint). Pure ANSI clear+redraw at a
# ~1s cadence; zero external TUI dependencies. v3 reorganizes the panel
# around CHATS instead of TTS internals: the roster merges `herdr agent
# list` (agent state + chat title), the snooze/mute ledger and the
# debounce ledger under the same pane_id merge key, and the audio history
# renders grouped per chat. Read-only with respect to the gate/mutex/
# watcher machinery: every mutation goes through the existing mute /
# snooze / rate functions, never through side channels.

DASHBOARD_ROSTER_REFRESH_TICKS=3   # `herdr agent list` every N ticks (cached)
DASHBOARD_ENGINE_REFRESH_TICKS=3   # engine IPC status every N ticks (cached, v2)
DASHBOARD_SNIPPET_MAX_CHARS=48     # width cap for the engine text snippet
DASHBOARD_ROSTER_TITLE_CHARS=40    # chat title width cap in the roster
DASHBOARD_HISTORY_TITLE_CHARS=30   # chat title width cap in history headers
DASHBOARD_HISTORY_BUDGET=24        # global row budget for the history section
DASHBOARD_HISTORY_AUDIO_ROWS=3     # audios rendered per chat group
DASHBOARD_HISTORY_SCAN_LINES=400   # ledger tail scanned per tick (bounded cost)
DASH_TERM_FALLBACK_LINES=40        # pty-size fallback when LINES/COLUMNS/tput fail
DASH_TERM_FALLBACK_COLS=100
DASH_WIDTH_BASE=110                # field caps scale down below this popup width
DASH_ANSI_RE=$'\e\[[0-9;?]*[a-zA-Z]' # CSI matcher for visible-width math
DASH_LAST_FRAME=""                 # previous tick's frame (change-detection)

# Globals shared between refresh / scan / order / render ticks.
declare -A DASH_TITLE_BY_PANE=()   # pane_id -> chat title (from agent list)
declare -A HIST_RANK=()            # pane_id -> audio recency rank (0 = newest)
DASH_DROPPED=0                     # chats hidden by the roster overflow cap
DASH_HIST_ROWS_TOTAL=0             # rows the full history render would need
HIST_PANES=(); HIST_COUNTS=(); HIST_LASTTS=(); HIST_LASTEPOCH=(); HIST_ITEMS=()

fmt_mmss() {
  local secs="$1"
  printf '%02d:%02d' $(( secs / 60 )) $(( secs % 60 ))
}

# Fit a string to a fixed CHARACTER width (truncate with an ellipsis, or
# pad with spaces) into <out-var>. Bash parameter expansion is multibyte
# aware, unlike printf field precision which counts bytes and breaks
# UTF-8 chat titles. Var-setting on purpose: render loops call this per
# line and must not fork a subshell per row.
dashboard_fit() { # <out-var> <string> <width>
  local s="$2" w="$3"
  if (( ${#s} > w )); then
    s="${s:0:w-1}…"
  fi
  while (( ${#s} < w )); do
    s+=" "
  done
  printf -v "$1" '%s' "$s"
}

# Sets <out-var> to a compact Spanish age label: 42s / 5m / 2h.
dashboard_fmt_age() { # <out-var> <secs>
  local secs="$2"
  (( secs < 0 )) && secs=0
  if (( secs < 60 )); then
    printf -v "$1" '%ss' "$secs"
  elif (( secs < 3600 )); then
    printf -v "$1" '%sm' "$(( secs / 60 ))"
  else
    printf -v "$1" '%sh' "$(( secs / 3600 ))"
  fi
  return 0
}

# Sets <out-var> to the duration label: numeric seconds -> mm:ss; anything
# else (the "-" probe-failure marker from the ledger) passes through.
dashboard_fmt_dur() { # <out-var> <value>
  local d="$2"
  if [[ "$d" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    printf -v "$1" '%02d:%02d' $(( ${d%%.*} / 60 )) $(( ${d%%.*} % 60 ))
  else
    printf -v "$1" '%s' "$d"
  fi
}

dashboard_cleanup() {
  printf '\033[0m\033[?25h\033[2J\033[H'
}

# ─── Render pipeline (v3.1): atomic single-write frames ──────
# The popup is repainted by building the WHOLE frame in a buffer and
# emitting it once (cursor-home + content + erase-below), never with a
# full-screen clear or per-line writes. Every line is clamped to the
# real popup width and the frame height is capped at LINES-1 so long
# lines and tall frames can never wrap or scroll the layout apart.

# Resolve the popup pty size each tick: exported LINES/COLUMNS first,
# then tput against the tty, then a fixed 40x100 fallback. Both values
# are validated so a stale or garbage source can't poison the clamps.
dashboard_term_size() { # sets DASH_LINES / DASH_COLS
  if [[ "${LINES:-}" =~ ^[0-9]+$ && "${COLUMNS:-}" =~ ^[0-9]+$ ]] \
     && (( LINES > 2 && COLUMNS > 10 )); then
    DASH_LINES=$LINES
    DASH_COLS=$COLUMNS
    return 0
  fi
  local l="" c=""
  if command -v tput >/dev/null 2>&1; then
    l=$(tput lines 2>/dev/null) || l=""
    c=$(tput cols 2>/dev/null) || c=""
  fi
  if [[ "$l" =~ ^[0-9]+$ && "$c" =~ ^[0-9]+$ ]] && (( l > 2 && c > 10 )); then
    DASH_LINES=$l
    DASH_COLS=$c
    return 0
  fi
  DASH_LINES=$DASH_TERM_FALLBACK_LINES
  DASH_COLS=$DASH_TERM_FALLBACK_COLS
}

# Dynamic field widths: below DASH_WIDTH_BASE columns the padded
# title/agent/snippet fields shrink proportionally (with floors) so the
# worst-case composed line still lands inside the popup width. Exact
# wcwidth is impossible in pure bash; these caps plus the per-line clamp
# below are the wrap guarantee.
dashboard_calc_widths() { # $1 = COLUMNS
  local cols="$1"
  DASH_W_ROSTER_TITLE=$DASHBOARD_ROSTER_TITLE_CHARS
  DASH_W_AGENT=9
  DASH_W_HIST_TITLE=$DASHBOARD_HISTORY_TITLE_CHARS
  DASH_W_SNIPPET=$DASHBOARD_SNIPPET_MAX_CHARS
  if (( cols >= DASH_WIDTH_BASE )); then
    return 0
  fi
  DASH_W_ROSTER_TITLE=$(( cols * DASHBOARD_ROSTER_TITLE_CHARS / DASH_WIDTH_BASE ))
  DASH_W_AGENT=$(( cols * 9 / DASH_WIDTH_BASE ))
  DASH_W_HIST_TITLE=$(( cols * DASHBOARD_HISTORY_TITLE_CHARS / DASH_WIDTH_BASE ))
  DASH_W_SNIPPET=$(( cols * DASHBOARD_SNIPPET_MAX_CHARS / DASH_WIDTH_BASE ))
  if (( DASH_W_ROSTER_TITLE < 10 )); then DASH_W_ROSTER_TITLE=10; fi
  if (( DASH_W_AGENT < 3 )); then DASH_W_AGENT=3; fi
  if (( DASH_W_HIST_TITLE < 8 )); then DASH_W_HIST_TITLE=8; fi
  if (( DASH_W_SNIPPET < 8 )); then DASH_W_SNIPPET=8; fi
}

# Truncate a raw line to <max> visible chars. ANSI escapes are not
# counted and always survive (trailing SGR resets can never be cut, so
# colors never leak across lines); visible width is the codepoint count
# of the ANSI-free text — an upper bound of the rendered column width,
# which is exactly the safe direction for wrap-avoidance. Fork-free:
# the render loop calls this once per line.
dashboard_clamp_line() { # <out-var> <raw-line> <max-visible>
  # Internal names are clamp-prefixed on purpose: `printf -v "$1"` must
  # reach the CALLER's variable, so no local may shadow a plausible
  # out-var name like `out` or `line`.
  local _clamp_buf="" _clamp_rest="$2" _clamp_max="$3" _clamp_run=""
  while [[ -n "$_clamp_rest" ]]; do
    if [[ "$_clamp_rest" =~ ^($DASH_ANSI_RE) ]]; then
      _clamp_buf+="${BASH_REMATCH[0]}"
      _clamp_rest="${_clamp_rest#"${BASH_REMATCH[0]}"}"
    else
      _clamp_run="${_clamp_rest%%$'\033'*}"
      _clamp_rest="${_clamp_rest#"$_clamp_run"}"
      if (( _clamp_max > 0 )); then
        if (( ${#_clamp_run} > _clamp_max )); then _clamp_run="${_clamp_run:0:_clamp_max}"; fi
        _clamp_buf+="$_clamp_run"
        _clamp_max=$(( _clamp_max - ${#_clamp_run} ))
      fi
    fi
  done
  printf -v "$1" '%s' "$_clamp_buf"
}

# Frame-buffer append: format one line, clamp it to the popup width and
# append it to the caller's `frame` variable (dynamic scoping). Fork-free.
_dash_add() { # <fmt> [args...]
  local out
  printf -v out "$@"
  dashboard_clamp_line out "$out" "$DASH_COLS"
  frame+="$out"$'\n'
}

# Chat roster from Herdr (v3): pane_id, agent kind, agent_status and chat
# title in a single jq pass. Fails open: with no CLI or no agents the
# roster stays empty and the chats section renders "sin datos de herdr".
dashboard_refresh_roster() {
  DASH_PANES=()
  DASH_AGENTS=()
  DASH_STATUSES=()
  DASH_TITLES=()
  DASH_TITLE_BY_PANE=()
  local raw
  raw=$(herdr agent list 2>/dev/null) || return 0
  local pid agent st title
  while IFS=$'\t' read -r pid agent st title; do
    [[ -z "$pid" || "$pid" == "null" ]] && continue
    agent="${agent:-desconocido}"
    st="${st:-unknown}"
    DASH_PANES+=("$pid")
    DASH_AGENTS+=("$agent")
    DASH_STATUSES+=("$st")
    DASH_TITLES+=("$title")
    DASH_TITLE_BY_PANE["$pid"]="$title"
  done < <(printf '%s' "$raw" | jq -r '
      .result.agents[]?
      | "\(.pane_id // "")\t\(.agent // "")\t\(.agent_status // "")\t\((.terminal_title_stripped // .terminal_title // "") | gsub("[\\t\\r\\n]"; " "))"
    ' 2>/dev/null || true)
}

# Live engine status (v2) through the same host→engine invocation the
# --toggle-pause flow uses. Queried on the roster cache cadence: one python
# spawn every N ticks for the WHOLE dashboard, never per pane. Fails open:
# with no engine session the cache stays empty and the Motor line renders
# the static fallback plus an explicit "motor: no responde" note.
dashboard_refresh_engine() {
  DASH_ENGINE_STATUS=""
  local res
  res=$("$VENV_PYTHON" "$ENGINE_SCRIPT" --ipc-cmd status 2>/dev/null) || return 0
  [[ -z "$res" || "$res" == *"Error:"* ]] && return 0
  DASH_ENGINE_STATUS="$res"
}

# Word-field extraction from the single-line engine payload (`key=value`
# tokens whose values never contain spaces). First match wins: engine
# fields precede the free-text fields, so a snippet containing e.g.
# "pos=" can never shadow the real field. Set-e safe via `|| true`.
dashboard_engine_field() {
  local payload="$1" key="$2" value=""
  value=$(printf '%s' "$payload" | grep -o "${key}=[^ ]*" | head -n 1 | cut -d= -f2) || true
  printf '%s' "$value"
}

# Trailing free-text snippet (may contain spaces): everything after the
# last `text=` marker, v1's `sed -n 's/.*key=//p'` convention.
dashboard_engine_text() {
  printf '%s' "$1" | sed -n 's/.*text=//p'
}

# Spanish label for the engine state word reported by the IPC payload.
dashboard_engine_state_label() {
  case "$1" in
    playing)      printf '▶ reproduciendo' ;;
    paused)       printf '⏸ pausado' ;;
    stopped)      printf '⏹ detenido' ;;
    synthesizing) printf '⌛ sintetizando' ;;
    *)            printf '%s' "${1:-desconocido}" ;;
  esac
}

# Audio history grouped per chat (v3): ONE python pass over the ledger
# tail does the grouping, the last-audio recency ordering and the
# local-time -> epoch conversion (datetime applies per-date DST rules,
# which a hand-rolled calendar or a cached zone offset cannot). It emits
# TSV rows — `H <pane> <count> <last_iso> <last_epoch>` group headers,
# each followed by `A <iso> <epoch> <dur>` audio rows in chronological
# order (the render walks them backwards for newest-first). Per-chat
# counts are computed within the scanned window so cost stays bounded on
# a ledger that is append-only and never rotated. Fails open: no file,
# no python or corrupt rows leave the history arrays empty and the
# section hidden.
dashboard_scan_history() {
  HIST_PANES=(); HIST_COUNTS=(); HIST_LASTTS=(); HIST_LASTEPOCH=(); HIST_ITEMS=()
  HIST_RANK=()
  DASH_HIST_ROWS_TOTAL=0
  [[ -s "$HISTORY_FILE" ]] || return 0
  local rows
  rows=$(tail -n "$DASHBOARD_HISTORY_SCAN_LINES" "$HISTORY_FILE" 2>/dev/null | "$VENV_PYTHON" -c '
import sys
from datetime import datetime

def epoch(ts):
    try:
        return str(int(datetime.fromisoformat(ts).timestamp()))
    except ValueError:
        return "-"

rows = []
for line in sys.stdin.read().split("\n"):
    f = line.split("\t")
    if len(f) < 2 or not f[1]:
        continue
    rows.append(f)
groups = {}
for idx, f in enumerate(rows):
    ts = f[0] if f[0] else "-"
    dur = f[3] if len(f) > 3 else "-"
    g = groups.setdefault(f[1], {"count": 0, "last": 0, "items": []})
    g["count"] += 1
    g["last"] = idx
    g["items"].append((ts, dur))
    del g["items"][:-3]
out = []
for pane, g in sorted(groups.items(), key=lambda kv: -kv[1]["last"]):
    items = g["items"]
    last_ts = items[-1][0] if items else "-"
    out.append("\t".join(["H", pane, str(g["count"]), last_ts, epoch(last_ts)]))
    for ts, dur in items:
        out.append("\t".join(["A", ts, epoch(ts), dur]))
sys.stdout.write("\n".join(out) + ("\n" if out else ""))
' 2>/dev/null) || rows=""
  [[ -z "$rows" ]] && return 0
  local kind f2 f3 f4 f5 gi=-1
  while IFS=$'\t' read -r kind f2 f3 f4 f5; do
    case "$kind" in
      H)
        gi=$(( gi + 1 ))
        HIST_PANES[gi]="$f2"
        HIST_COUNTS[gi]="$f3"
        HIST_LASTTS[gi]="$f4"
        HIST_LASTEPOCH[gi]="$f5"
        HIST_ITEMS[gi]=""
        ;;
      A)
        (( gi >= 0 )) && HIST_ITEMS[gi]+="${f2}|${f3}|${f4};"
        ;;
    esac
  done <<<"$rows"
  local i shown
  for (( i = 0; i < ${#HIST_PANES[@]}; i++ )); do
    HIST_RANK[${HIST_PANES[$i]}]="$i"
    shown=$(( HIST_COUNTS[i] < DASHBOARD_HISTORY_AUDIO_ROWS ? HIST_COUNTS[i] : DASHBOARD_HISTORY_AUDIO_ROWS ))
    DASH_HIST_ROWS_TOTAL=$(( DASH_HIST_ROWS_TOTAL + 1 + shown ))
  done
  return 0
}

# Sort the roster into visible order (v3): needs-attention first
# (done/blocked -> working -> idle -> unknown), ties broken by most recent
# audio in the history ledger, then by agent-list order (stable insertion
# sort). The visible order is written back into the DASH_* arrays so the
# j/k cursor walks exactly what is on screen. The overflow cap drops from
# the tail — the oldest-idle chats — and never hides needs-attention
# (done/blocked) chats.
dashboard_order_roster() {
  local cap="$1"
  DASH_DROPPED=0
  local n=${#DASH_PANES[@]}
  if (( n == 0 )); then
    return 0
  fi
  (( cap >= 1 )) || cap=1
  local -a pri=() rank=() idx=()
  local i p pri0=0
  for (( i = 0; i < n; i++ )); do
    p="${DASH_STATUSES[$i]}"
    case "$p" in
      done|blocked) pri[i]=0 ;;
      working)      pri[i]=1 ;;
      idle)         pri[i]=2 ;;
      *)            pri[i]=3 ;; # unknown states render literally, sort last
    esac
    rank[i]=${HIST_RANK[${DASH_PANES[$i]}]:-999999}
    idx[i]=$i
    (( pri[i] == 0 )) && pri0=$(( pri0 + 1 ))
  done
  # Needs-attention chats are never dropped, even when the cap is tight.
  (( cap < pri0 )) && cap=$pri0
  local a b j
  for (( i = 1; i < n; i++ )); do
    a=${idx[i]}
    j=$(( i - 1 ))
    while (( j >= 0 )); do
      b=${idx[j]}
      if (( pri[b] < pri[a] || (pri[b] == pri[a] && rank[b] <= rank[a]) )); then
        break
      fi
      idx[$(( j + 1 ))]=$b
      j=$(( j - 1 ))
    done
    idx[$(( j + 1 ))]=$a
  done
  if (( n > cap )); then
    local keep=$(( cap - 1 )) # reserve one row for the "more chats" notice
    (( keep < pri0 )) && keep=$pri0
    DASH_DROPPED=$(( n - keep ))
    n=$keep
  fi
  local -a np=() na=() ns=() nt=()
  for (( i = 0; i < n; i++ )); do
    a=${idx[i]}
    np+=("${DASH_PANES[a]}")
    na+=("${DASH_AGENTS[a]}")
    ns+=("${DASH_STATUSES[a]}")
    nt+=("${DASH_TITLES[a]}")
  done
  DASH_PANES=("${np[@]}")
  DASH_AGENTS=("${na[@]}")
  DASH_STATUSES=("${ns[@]}")
  DASH_TITLES=("${nt[@]}")
}

# Keep the cursor on a rendered chat: after a resort or an overflow cap
# the previously selected pane may no longer be visible; snap to the
# first visible chat instead of aiming m/z at a hidden row.
dashboard_cursor_ensure() {
  local current="$1" i n=${#DASH_PANES[@]}
  if (( n == 0 )); then
    printf ''
    return 0
  fi
  for (( i = 0; i < n; i++ )); do
    if [[ "${DASH_PANES[i]}" == "$current" ]]; then
      printf '%s' "$current"
      return 0
    fi
  done
  printf '%s' "${DASH_PANES[0]}"
}

# Move the selection cursor inside the roster (delta +1 / -1, wrapping).
dashboard_step_cursor() {
  local current="$1" delta="$2"
  local n=${#DASH_PANES[@]}
  if (( n == 0 )); then
    printf '%s' "$current"
    return 0
  fi
  local idx i=0
  for (( idx = 0; idx < n; idx++ )); do
    if [[ "${DASH_PANES[$idx]}" == "$current" ]]; then
      i=$idx
      break
    fi
  done
  i=$(( (i + delta + n) % n ))
  printf '%s' "${DASH_PANES[$i]}"
}

# One screen of the dashboard. State reads reuse the existing gating
# helpers (load_snooze_state, is_playing, is_auto_muted) and fail open:
# a missing or corrupt state file renders "off / sin datos", never an error.
dashboard_render() {
  local selected="$1" msg="${2:-}" msg_time="${3:-}"
  local now
  now=$(date +%s)

  # v3.1: resolve the popup pty size and scale the padded field widths
  # before composing anything.
  dashboard_term_size
  dashboard_calc_widths "$DASH_COLS"
  local frame="" roster_fmt
  roster_fmt="║ %s%s%s %s %-${DASH_W_AGENT}s%s\033[0m"

  _dash_add '╔═══ 🎙️  herdr-tts · Panel de voz ════════════════════ %s ═╗' "$(date +%H:%M:%S)"

  # Single jq pass over the cached gate state: line 1 = global summary,
  # then one TSV row per tracked pane (muted, snooze_until, last event
  # seen by the debounce ledger + its timestamp). Everything sanitized
  # to numeric defaults so a hand-edited state file can't crash the loop.
  local state
  state=$(load_snooze_state)
  local g_until=0 f1 f2 f3 f4 f5
  local -A pane_muted pane_until pane_last_status pane_last_ts
  while IFS=$'\t' read -r f1 f2 f3 f4 f5; do
    if [[ "$f1" == "__GLOBAL__" ]]; then
      [[ "$f2" =~ ^[0-9]+$ ]] && g_until="$f2"
      continue
    fi
    [[ -z "$f1" ]] && continue
    [[ "$f2" == "true" ]] && pane_muted["$f1"]="true"
    [[ "$f3" =~ ^[0-9]+$ ]] && pane_until["$f1"]="$f3"
    [[ -n "$f4" && "$f4" != "-" ]] && pane_last_status["$f1"]="$f4"
    [[ "$f5" =~ ^[0-9]+$ ]] && pane_last_ts["$f1"]="$f5"
  done < <(jq -r '
    . as $root
    | (["__GLOBAL__", ((.global_snooze_until // 0)|tostring)] | @tsv),
      ((((.panes // {}) | keys) + (($root.debounce // {}) | keys) | unique) as $all
      | $all[]
      | . as $p
      | (($root.panes[$p].muted // false)|tostring) as $m
      | (($root.panes[$p].snooze_until // 0)|tostring) as $u
      | (($root.debounce[$p] // {}) | to_entries | sort_by(.value) | (last // {key:"-", value:0})) as $e
      | [ $p, $m, $u, ($e.key|tostring), ($e.value|tostring) ] | @tsv)
  ' <<<"$state" 2>/dev/null || true)

  if (( g_until > now )); then
    _dash_add '║ Global  😴 snooze GLOBAL activo · quedan %s (hasta %s)' \
      "$(fmt_mmss $(( g_until - now )))" "$(fmt_epoch_clock "$g_until")"
  else
    _dash_add '║ Global  ⚪ snooze global off · (Z cicla 5m → 30m → 2h → off)'
  fi

  # Motor line (v2): live IPC status when the engine answers — colored
  # state, mm:ss progress, provider/voice and a truncated text snippet.
  # Otherwise the v1 static lock-file fallback stays, upgraded with an
  # explicit "motor: no responde" fail-open note.
  local auto_label="🔊 activa"
  if is_auto_muted; then
    auto_label="🔇 silenciada"
  fi
  if [[ -n "${DASH_ENGINE_STATUS:-}" ]]; then
    local e_state e_pos e_total e_provider e_voice e_text e_color
    e_state=$(dashboard_engine_field "$DASH_ENGINE_STATUS" status)
    e_pos=$(dashboard_engine_field "$DASH_ENGINE_STATUS" pos)
    e_total=$(dashboard_engine_field "$DASH_ENGINE_STATUS" total)
    e_provider=$(dashboard_engine_field "$DASH_ENGINE_STATUS" provider)
    e_voice=$(dashboard_engine_field "$DASH_ENGINE_STATUS" voice)
    e_text=$(dashboard_engine_text "$DASH_ENGINE_STATUS")
    if ! [[ "$e_pos" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then e_pos=0; fi
    if ! [[ "$e_total" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then e_total=0; fi
    case "$e_state" in
      playing)      e_color=$'\033[32m' ;;
      paused)       e_color=$'\033[33m' ;;
      synthesizing) e_color=$'\033[36m' ;;
      *)            e_color=$'\033[90m' ;;
    esac
    _dash_add '║ Motor   %s%s · %s / %s · %s · %s · %.*s\033[0m · auto-lectura %s' \
      "$e_color" "$(dashboard_engine_state_label "$e_state")" \
      "$(fmt_mmss "${e_pos%%.*}")" "$(fmt_mmss "${e_total%%.*}")" \
      "${e_provider:-?}" "${e_voice:-?}" \
      "$DASH_W_SNIPPET" "${e_text:-—}" \
      "$auto_label"
  else
    local engine_label="⚪ En reposo"
    if is_playing; then
      engine_label="🔊 Reproduciendo"
    fi
    _dash_add '║ Motor   %s · motor: no responde · auto-lectura %s' "$engine_label" "$auto_label"
  fi
  _dash_add '║ Config  proveedor %s · voz %s (%s) · playback %s · debounce %ss' \
    "$TTS_PROVIDER" "$TTS_VOICE" "$TTS_RATE" "${TTS_PLAYBACK:-local}" "$TTS_DEBOUNCE_SECONDS"

  # v3.1 height budget: the frame may never exceed LINES-1 rows (the
  # last line's newline lands on the bottom row without scrolling).
  # Fixed cost is header + global + motor + config + roster header +
  # footer; under height pressure the history budget shrinks first
  # (24 → 0) and only then the roster cap drops oldest-idle chats —
  # needs-attention chats and the fixed lines are never sacrificed.
  # The scan runs before printing because the roster sort needs per-chat
  # audio recency and the cap needs the history row count.
  dashboard_scan_history
  local rows_cap=$(( DASH_LINES - 1 ))
  if (( rows_cap < 1 )); then rows_cap=1; fi
  local n=${#DASH_PANES[@]}
  local hist_budget=$DASHBOARD_HISTORY_BUDGET
  if (( hist_budget > DASH_HIST_ROWS_TOTAL )); then hist_budget=$DASH_HIST_ROWS_TOTAL; fi
  local fixed=6 # header + global + motor + config + roster header + footer
  if [[ -n "$msg" ]]; then fixed=$(( fixed + 1 )); fi
  local avail=$(( rows_cap - fixed ))
  local hist_header=0
  if (( hist_budget > 0 && avail >= 2 )); then
    hist_header=1
    avail=$(( avail - 1 ))
  fi
  if (( hist_budget + n > avail )); then
    hist_budget=$(( avail - n ))
    if (( hist_budget < 0 )); then hist_budget=0; fi
    if (( hist_budget == 0 && hist_header == 1 )); then
      hist_header=0
      avail=$(( avail + 1 ))
    fi
  fi
  dashboard_order_roster $(( avail - hist_budget ))
  n=${#DASH_PANES[@]} # the roster cap may have shrunk the visible roster

  _dash_add '╠═══ Chats (j/k mueve el cursor · m silencia · z snooze) ══════'
  local i pid agent st title marker color icon overlay overlay_lbl
  if (( n == 0 )); then
    _dash_add '║  (sin datos de herdr: CLI no disponible o sin agentes)'
  fi
  for (( i = 0; i < n; i++ )); do
    pid="${DASH_PANES[i]}"
    agent="${DASH_AGENTS[i]}"
    st="${DASH_STATUSES[i]}"
    title="${DASH_TITLES[i]}"
    marker="  "
    [[ "$pid" == "$selected" ]] && marker="▸ "
    # Agent state icon + color: needs-attention states first by design.
    case "$st" in
      working)      color=$'\033[32m'; icon="▶" ;;
      done|blocked) color=$'\033[33m'; icon="✔" ;;
      idle)         color=$'\033[90m'; icon="·" ;;
      *)            color=$'\033[90m'; icon="$st" ;; # unknown: literal value
    esac
    # Voice overlays appended after the agent kind: mute, active snooze
    # countdown, then the anti-spam (debounce) hold with its remaining
    # window. All three can stack on the same chat line.
    overlay=""
    if [[ "${pane_muted[$pid]:-false}" == "true" ]]; then
      overlay+=" 🔇"
    fi
    if (( ${pane_until[$pid]:-0} > now )); then
      printf -v overlay_lbl '%02d:%02d' \
        $(( (${pane_until[$pid]} - now) / 60 )) $(( (${pane_until[$pid]} - now) % 60 ))
      overlay+=" 😴 ${overlay_lbl}"
    fi
    if (( TTS_DEBOUNCE_SECONDS > 0 )) \
       && [[ -n "${pane_last_status[$pid]:-}" ]] \
       && (( now - ${pane_last_ts[$pid]:-0} < TTS_DEBOUNCE_SECONDS )); then
      overlay+=" ⏱$(( now - ${pane_last_ts[$pid]} ))s"
    fi
    dashboard_fit title "$title" "$DASH_W_ROSTER_TITLE"
    _dash_add "$roster_fmt" "$marker" "$color" "$icon" "$title" "$agent" "$overlay"
  done
  if (( DASH_DROPPED > 0 )); then
    _dash_add '║  … y %d chats más (los que piden atención nunca se ocultan)' "$DASH_DROPPED"
  fi

  # History grouped per chat (v3): header + last audios per group, newest
  # group first (the scan already ordered groups by last-audio recency).
  # Hidden when the ledger is empty OR when the height budget shrank it
  # away (hist_budget == 0).
  if (( hist_budget > 0 )); then
    _dash_add '╠═══ Historial por chat (más reciente arriba) ════════════════'
    local remaining=$hist_budget gi k ts epoch dur age_lbl dur_lbl gtitle gcount audio_word
    local -a parts_arr=()
    for (( gi = 0; gi < ${#HIST_PANES[@]} && remaining > 0; gi++ )); do
      pid="${HIST_PANES[gi]}"
      gtitle="${DASH_TITLE_BY_PANE[$pid]:-}"
      # Closed panes (no agent-list entry anymore) keep their audio group,
      # labeled by pane id so the ledger never loses the thread.
      [[ -z "$gtitle" ]] && gtitle="$pid"
      gcount="${HIST_COUNTS[gi]}"
      audio_word="audios"
      (( gcount == 1 )) && audio_word="audio"
      epoch="${HIST_LASTEPOCH[gi]}"
      if [[ "$epoch" =~ ^[0-9]+$ ]]; then
        dashboard_fmt_age age_lbl $(( now - epoch ))
      else
        age_lbl="-"
      fi
      dashboard_fit gtitle "$gtitle" "$DASH_W_HIST_TITLE"
      _dash_add '║ ── %s · %d %s · último hace %s' "$gtitle" "$gcount" "$audio_word" "$age_lbl"
      remaining=$(( remaining - 1 ))
      # Last ≤3 audios, newest first (items are stored chronological as
      # iso|epoch|duration triples).
      parts_arr=()
      IFS=';' read -r -a parts_arr <<< "${HIST_ITEMS[gi]%;}"
      for (( k = ${#parts_arr[@]} - 1; k >= 0 && remaining > 0; k-- )); do
        ts="${parts_arr[k]%%|*}"
        epoch="${parts_arr[k]#*|}"; epoch="${epoch%%|*}"
        dur="${parts_arr[k]##*|}"
        if [[ "$epoch" =~ ^[0-9]+$ ]]; then
          dashboard_fmt_age age_lbl $(( now - epoch ))
        else
          age_lbl="-"
        fi
        dashboard_fmt_dur dur_lbl "$dur"
        _dash_add '║    · %s · hace %s' "$dur_lbl" "$age_lbl"
        remaining=$(( remaining - 1 ))
      done
    done
  fi

  _dash_add '╚═══ q salir · j/k chat · m silenciar · z snooze pane · Z snooze global · +/- velocidad ═╝'
  if [[ -n "$msg" ]]; then
    _dash_add '   » [%s] %s' "${msg_time:-}" "$msg"
  fi

  # v3.1 atomic repaint: ONE physical write per tick — cursor-home, the
  # whole frame, erase-below. No full-screen clear (which scrolled and
  # painted progressively) and no per-line output. A frame byte-identical
  # to the previous tick skips the write; the clock line is part of the
  # frame, so a live dashboard still redraws at ~1Hz while an idle one
  # stays perfectly still.
  if [[ "$frame" != "$DASH_LAST_FRAME" ]]; then
    printf '\033[H%s\033[J' "$frame"
    DASH_LAST_FRAME=$frame
  fi
}

# adjust_rate mutates TTS_RATE in its own process: when invoked from the
# key loop it runs in a command-substitution subshell, so the parent must
# adopt the value the function just persisted or repeated presses would
# all start from the stale session rate.
dashboard_sync_rate() {
  local new_rate
  new_rate=$(printf '%s' "$1" | grep -oE '^[^:]*: [+-][0-9]+%$' | grep -oE '[+-][0-9]+%' | head -n 1) || return 0
  [[ -n "$new_rate" ]] && TTS_RATE="$new_rate"
  return 0
}

# Entry point of the dashboard pane. The key loop doubles as the refresh
# loop: `read -t 1` waits up to one second for a key, so an idle dashboard
# redraws at ~1Hz while keypresses are handled instantly. Only the chat
# roster and the engine status hit external processes, both on the same
# every-N-ticks cache cadence; the history scan is one tail + one jq pass
# per tick and everything else is local, fork-free bash.
run_dashboard() {
  local refresh_secs="${HERDR_TTS_DASHBOARD_REFRESH:-1}"
  local selected="" msg="" msg_time="" key="" rc=0 tick=0
  local -a DASH_PANES=() DASH_AGENTS=() DASH_STATUSES=() DASH_TITLES=()
  local DASH_ENGINE_STATUS=""

  trap dashboard_cleanup EXIT
  trap 'exit 0' INT TERM
  printf '\033[?25l'

  while true; do
    if (( tick % DASHBOARD_ROSTER_REFRESH_TICKS == 0 )) || (( ${#DASH_PANES[@]} == 0 )); then
      dashboard_refresh_roster
    fi
    if (( tick % DASHBOARD_ENGINE_REFRESH_TICKS == 0 )); then
      dashboard_refresh_engine
    fi
    tick=$(( tick + 1 ))

    if [[ -z "$selected" ]] && (( ${#DASH_PANES[@]} > 0 )); then
      selected="${DASH_PANES[0]}"
    fi

    dashboard_render "$selected" "$msg" "$msg_time"
    msg="" msg_time=""
    # The render may have re-sorted or overflow-capped the roster; keep
    # the cursor on a chat that is actually on screen so m/z never fire
    # against a hidden row.
    selected=$(dashboard_cursor_ensure "$selected")

    rc=0
    key=""
    read -rsn1 -t "$refresh_secs" key || rc=$?
    if (( rc == 1 )); then
      break # stdin closed: leave instead of spinning on EOF
    fi
    case "$key" in
      q|Q) break ;;
      j|J) selected=$(dashboard_step_cursor "$selected" 1) ;;
      k|K) selected=$(dashboard_step_cursor "$selected" -1) ;;
      m|M)
        msg=$(toggle_pane_mute "$selected" 2>&1 || true)
        msg="${msg%%$'\n'*}"; msg_time=$(date +%H:%M:%S)
        ;;
      z)
        msg=$(cycle_snooze pane "$selected" 2>&1 || true)
        msg="${msg%%$'\n'*}"; msg_time=$(date +%H:%M:%S)
        ;;
      Z)
        msg=$(cycle_snooze global 2>&1 || true)
        msg="${msg%%$'\n'*}"; msg_time=$(date +%H:%M:%S)
        ;;
      +|=)
        msg=$(adjust_rate 10 2>&1 || true)
        dashboard_sync_rate "$msg"
        msg="${msg%%$'\n'*}"; msg_time=$(date +%H:%M:%S)
        ;;
      -|_)
        msg=$(adjust_rate -10 2>&1 || true)
        dashboard_sync_rate "$msg"
        msg="${msg%%$'\n'*}"; msg_time=$(date +%H:%M:%S)
        ;;
      *) ;; # ignore anything else (arrow escapes, modifiers, ...)
    esac
  done

  dashboard_cleanup
  trap - EXIT INT TERM
}

# ─── Voice palette (v0.11, fzf popup) ────────────────────────
# `--voice-palette` renders an fzf picker inside a Herdr popup pane with
# one entry per audio turn (newest first, from the history ledger) plus
# one entry per agent chat with zero audios. Snapshot per open: no live
# loop. Accept focuses the chat; ctrl-m / ctrl-z apply mute / snooze to
# the selected pane through the existing CLI flags (they accept an
# optional explicit pane id) and exit without focusing anything.

PALETTE_TITLE_CHARS=35         # chat title cap in the entry line
PALETTE_SNIPPET_CHARS=60       # snippet cap in the entry line
PALETTE_HISTORY_SCAN_LINES=400 # ledger tail scanned per palette open

palette_trunc() { # <out-var> <string> <width> — truncate with ellipsis, no padding
  local _pt_s="$2" _pt_w="$3"
  if (( ${#_pt_s} > _pt_w )); then
    _pt_s="${_pt_s:0:_pt_w-1}…"
  fi
  printf -v "$1" '%s' "$_pt_s"
}

# Reversed history rows (newest first) as TSV: hhmm, pane, dur, snippet,
# epoch. ONE python pass (same interpreter as the dashboard scan) because
# datetime applies per-date DST rules to the epoch column, which a
# hand-rolled calendar cannot. Legacy 4-field rows yield snippet "-".
# Fails open: no file, no python or corrupt rows → empty output.
palette_history_rows() { # [scan_lines] (omit = whole ledger)
  local cap="${1:-}" input_lines
  [[ -s "$HISTORY_FILE" ]] || return 0
  if [[ -n "$cap" ]]; then
    input_lines=$(tail -n "$cap" "$HISTORY_FILE" 2>/dev/null) || return 0
  else
    input_lines=$(cat "$HISTORY_FILE" 2>/dev/null) || return 0
  fi
  [[ -z "$input_lines" ]] && return 0
  printf '%s\n' "$input_lines" | "$VENV_PYTHON" -c '
import sys
from datetime import datetime

rows = []
for line in sys.stdin.read().split("\n"):
    f = line.split("\t")
    if len(f) < 4 or not f[1]:
        continue
    ts, pane, dur = f[0], f[1], f[3]
    snippet = f[4] if len(f) > 4 and f[4] else "-"
    hhmm = ts[11:16] if len(ts) >= 16 else "??:??"
    try:
        epoch = str(int(datetime.fromisoformat(ts).timestamp()))
    except ValueError:
        epoch = "0"
    rows.append("\t".join([hhmm, pane, dur, snippet, epoch]))
sys.stdout.write("".join(r + "\n" for r in reversed(rows)))
' 2>/dev/null || return 0
}

# Palette entries, one per line: display field + tab-delimited hidden
# fields (<pane_id> <ts_epoch>, or <pane_id> "chat" for zero-audio rows).
# Audio turns come newest first; zero-audio chats follow in agent-list
# order. Prints to stdout so the smoke battery can diff the format.
palette_build_entries() {
  local -A p_title=()
  local -a p_order=()
  local raw pid title
  raw=$(herdr agent list 2>/dev/null) || raw=""
  if [[ -n "$raw" ]]; then
    while IFS=$'\t' read -r pid title; do
      [[ -z "$pid" || "$pid" == "null" ]] && continue
      p_title["$pid"]="${title:-$pid}"
      p_order+=("$pid")
    done < <(printf '%s' "$raw" | jq -r '
        .result.agents[]?
        | "\(.pane_id // "")\t\((.terminal_title_stripped // .terminal_title // "") | gsub("[\\t\\r\\n]"; " "))"
      ' 2>/dev/null || true)
  fi

  local -a entries=()
  local -A has_audio=()
  local hhmm pane dur snippet epoch line chat_title dur_lbl
  while IFS=$'\t' read -r hhmm pane dur snippet epoch; do
    [[ -z "$pane" ]] && continue
    has_audio["$pane"]=1
    chat_title="${p_title[$pane]:-$pane}"
    palette_trunc chat_title "$chat_title" "$PALETTE_TITLE_CHARS"
    palette_trunc snippet "$snippet" "$PALETTE_SNIPPET_CHARS"
    dashboard_fmt_dur dur_lbl "$dur"
    printf -v line '%s · %s · %s · %s\t%s\t%s' "$hhmm" "$chat_title" "$dur_lbl" "$snippet" "$pane" "$epoch"
    entries+=("$line")
  done < <(palette_history_rows "$PALETTE_HISTORY_SCAN_LINES")

  local pid2
  for pid2 in ${p_order[@]+"${p_order[@]}"}; do
    [[ -n "${has_audio[$pid2]:-}" ]] && continue
    chat_title="${p_title[$pid2]:-$pid2}"
    palette_trunc chat_title "$chat_title" "$PALETTE_TITLE_CHARS"
    entries+=("(sin audios) · ${chat_title}"$'\t'"${pid2}"$'\t'"chat")
  done

  local e
  for e in ${entries[@]+"${entries[@]}"}; do
    printf '%s\n' "$e"
  done
  return 0
}

run_voice_palette() {
  if ! command -v fzf >/dev/null 2>&1; then
    echo "❌ fzf no está instalado: la paleta de voz lo necesita para funcionar" >&2
    echo "   Instálalo (p. ej. 'sudo apt install fzf' o 'brew install fzf') y vuelve a abrirla." >&2
    return 1
  fi

  local -a entries=()
  mapfile -t entries < <(palette_build_entries)
  if (( ${#entries[@]} == 0 )); then
    echo "ℹ️ Sin chats ni audios que mostrar en la paleta"
    return 0
  fi

  local sel pane_id
  # Snapshot-per-open: fzf exits on accept (enter / ctrl-o) or on the
  # ctrl-m / ctrl-z actions (execute-silent applies the mutation through
  # the CLI flags and abort skips the accept path entirely).
  sel=$(printf '%s\n' "${entries[@]}" | fzf \
    --delimiter '\t' \
    --with-nth 1 \
    --reverse \
    --height 100% \
    --header 'enter/ctrl-o: enfocar chat · ctrl-m: silenciar pane · ctrl-z: snooze pane · esc: salir' \
    --preview "'$SCRIPT' --palette-preview {2}" \
    --preview-window 'right:50%:wrap' \
    --bind 'ctrl-o:accept' \
    --bind "ctrl-m:execute-silent('$SCRIPT' --mute-pane {2})+abort" \
    --bind "ctrl-z:execute-silent('$SCRIPT' --snooze-pane {2})+abort") || return 0

  pane_id=$(printf '%s' "$sel" | cut -f2)
  [[ -z "$pane_id" ]] && return 0
  herdr pane focus "$pane_id" >/dev/null 2>&1 || true
  echo "🎯 Chat ${pane_id} enfocado (la paleta se cierra en 2s)"
  sleep 2
  return 0
}

# fzf preview helper: chat header (title, agent+state, voice gating) plus
# ALL history turns of the pane, newest first. Fails open everywhere.
palette_preview() { # <pane_id>
  local pane_id="${1:-}"
  if [[ -z "$pane_id" ]]; then
    echo "Uso: herdr-tts --palette-preview <pane_id>" >&2
    return 1
  fi

  # Chat header: title/agent/status from the agent roster (fail-open: no
  # herdr CLI still renders the pane id and an explicit note).
  local raw="" pid agent st title=""
  raw=$(herdr agent list 2>/dev/null) || raw=""
  if [[ -n "$raw" ]]; then
    while IFS=$'\t' read -r pid agent st title; do
      if [[ "$pid" == "$pane_id" ]]; then
        break
      fi
      title=""
    done < <(printf '%s' "$raw" | jq -r '
        .result.agents[]?
        | "\(.pane_id // "")\t\(.agent // "")\t\(.agent_status // "")\t\((.terminal_title_stripped // .terminal_title // "") | gsub("[\\t\\r\\n]"; " "))"
      ' 2>/dev/null || true)
  fi
  [[ -z "$title" ]] && title="$pane_id"
  echo "📌 ${title}"
  if [[ -z "$raw" ]]; then
    echo "   ⚠️ herdr CLI no disponible (sin datos de agente)"
  else
    echo "   agente: ${agent:-?} · estado: ${st:-?}"
  fi

  # Voice gating state for the pane, mirroring the dashboard overlays.
  local now state muted until_ts last_status last_ts gate=""
  now=$(date +%s)
  state=$(load_snooze_state)
  muted=$(jq -r --arg p "$pane_id" '(.panes[$p].muted // false)' <<<"$state" 2>/dev/null) || muted=false
  until_ts=$(jq -r --arg p "$pane_id" '(.panes[$p].snooze_until // 0)' <<<"$state" 2>/dev/null) || until_ts=0
  last_status=$(jq -r --arg p "$pane_id" \
    '(.debounce[$p] // {} | to_entries | sort_by(.value) | (last // {key:"",value:0}).key)' \
    <<<"$state" 2>/dev/null) || last_status=""
  last_ts=$(jq -r --arg p "$pane_id" \
    '(.debounce[$p] // {} | to_entries | sort_by(.value) | (last // {key:"",value:0}).value)' \
    <<<"$state" 2>/dev/null) || last_ts=0
  if [[ "$muted" == "true" ]]; then
    gate="🔇 silenciado"
  fi
  if [[ "$until_ts" =~ ^[0-9]+$ ]] && (( until_ts > now )); then
    gate+="${gate:+ · }😴 snooze $(fmt_mmss $(( until_ts - now ))) restantes (hasta $(fmt_epoch_clock "$until_ts"))"
  fi
  if (( TTS_DEBOUNCE_SECONDS > 0 )) \
     && [[ -n "$last_status" && "$last_status" != "null" ]] \
     && [[ "$last_ts" =~ ^[0-9]+$ ]] \
     && (( now - last_ts < TTS_DEBOUNCE_SECONDS )); then
    gate+="${gate:+ · }⏱ debounce activo ($(( TTS_DEBOUNCE_SECONDS - (now - last_ts) ))s)"
  fi
  [[ -z "$gate" ]] && gate="🔊 voz activa"
  echo "   gating: ${gate}"
  echo

  echo "── Turnos de audio (recientes primero) ──"
  local hhmm pid dur snippet epoch dur_lbl n=0
  while IFS=$'\t' read -r hhmm pid dur snippet epoch; do
    [[ "$pid" != "$pane_id" ]] && continue
    dashboard_fmt_dur dur_lbl "$dur"
    echo "${hhmm} · ${dur_lbl} · ${snippet}"
    n=$(( n + 1 ))
  done < <(palette_history_rows) # whole ledger, newest first
  if (( n == 0 )); then
    echo "sin turnos"
  fi
  return 0
}

# ─── Voice menu (v0.12, one-key popup) ───────────────────────
# Herdr core has no key sequences: every binding is a single prefix+X
# chord, so a literal "prefix + namespace + command" chain cannot be
# expressed. The voice menu simulates it with ONE free core letter
# (suggested binding: prefix+u → the open-menu action): the popup
# renders a static cheat sheet, reads exactly one key and dispatches it
# to the same functions/flags the CLI flags, the palette and the
# dashboard already use (no explicit pane id → focused pane, the same
# default as --mute-pane / --snooze-pane). Herdr closes a popup when
# its command exits, so one key = one action = popup closes = focus
# restored.

MENU_CONFIRM_SECS="${HERDR_TTS_MENU_CONFIRM_SECS:-1.5}"
[[ "$MENU_CONFIRM_SECS" =~ ^[0-9]+([.][0-9]+)?$ ]] || MENU_CONFIRM_SECS=1.5

# Cheat-sheet data: two columns of key + description, zipped at render
# time. Static on purpose — the menu never queries Herdr, so the frame
# costs nothing and is always a single physical write.
MENU_L_KEYS=("r" "p" "s" "t" "v" "[" "]" "n" "N")
MENU_L_DESC=("▶ Play / Stop del chat enfocado" "⏸ Pausar / Reanudar" "⏹ Stop inmediato" "⚡ TL;DR del chat" "🔊 Auto-lectura on/off" "⏪ Rebobinar 10s" "⏩ Avanzar 10s" "⏭ Frase siguiente" "⏮ Frase anterior")
MENU_R_KEYS=("m" "z" "Z" "+/-" "d" "o" "q/Esc")
MENU_R_DESC=("🔇 Mute pane" "😴 Snooze pane" "😴 Snooze GLOBAL" "🎙 Velocidad ±10%" "📊 Dashboard" "🎛️ Paleta de voz" "Salir del menú")

# Height cap: keep at most <max-rows> lines of the buffered frame, the
# same LINES-1 discipline the dashboard render enforces.
menu_cap_rows() { # <max-rows>
  local max_rows="$1" rest="$frame" line
  frame=""
  while [[ -n "$rest" ]]; do
    if (( max_rows <= 0 )); then break; fi
    line="${rest%%$'\n'*}"
    frame+="$line"$'\n'
    max_rows=$(( max_rows - 1 ))
    if [[ "$rest" == *$'\n'* ]]; then rest="${rest#*$'\n'}"; else rest=""; fi
  done
}

# ONE static frame, ONE physical write: reuses the dashboard render
# helpers verbatim — dashboard_term_size (popup pty → DASH_LINES /
# DASH_COLS with a validated 40x100 fallback) and _dash_add (per-line
# visible-width clamp via dashboard_clamp_line). No clamp logic here.
menu_render() {
  dashboard_term_size
  local frame="" row_l half i kl dl kr dr
  half=$(( DASH_COLS / 2 - 2 ))
  (( half < 20 )) && half=20
  _dash_add $'\e[1m⌨️  herdr-tts · Menú de voz\e[0m'
  _dash_add 'Pulsa UNA tecla: la acción se ejecuta y el menú se cierra solo.'
  _dash_add ''
  for (( i = 0; i < ${#MENU_L_KEYS[@]} || i < ${#MENU_R_KEYS[@]}; i++ )); do
    kl="${MENU_L_KEYS[i]:-}"; dl="${MENU_L_DESC[i]:-}"
    kr="${MENU_R_KEYS[i]:-}"; dr="${MENU_R_DESC[i]:-}"
    dashboard_fit row_l " ${kl}  ${dl}" "$half"
    _dash_add '%s│ %s  %s' "$row_l" "$kr" "$dr"
  done
  menu_cap_rows $(( DASH_LINES - 1 ))
  printf '\033[H%s\033[J' "$frame"
}

# One key → one action, always through the EXISTING implementation path
# (the exact functions/flags the CLI cases call). Command substitution
# keeps the functions in a subshell, like the dashboard key loop does.
# Returns 1 on an unrecognized key; MENU_RESULT carries the first line
# of the action's output for the one-line confirmation.
menu_dispatch() { # <key>
  MENU_RESULT=""
  local out=""
  case "$1" in
    r|R) out=$(toggle_play 2>&1 || true) ;;
    p|P) out=$(toggle_pause_audio 2>&1 || true) ;;
    s|S) out=$(stop_audio 2>&1 || true) ;;
    t|T) out=$(read_current_pane "" "--tldr" 2>&1 || true) ;;
    v|V) out=$(toggle_auto 2>&1 || true) ;;
    "[") out=$(seek_audio -10 2>&1 || true) ;;
    "]") out=$(seek_audio +10 2>&1 || true) ;;
    n)   out=$(next_sentence_audio 2>&1 || true) ;;
    N)   out=$(prev_sentence_audio 2>&1 || true) ;;
    m|M) out=$(toggle_pane_mute 2>&1 || true) ;;
    z)   out=$(cycle_snooze pane 2>&1 || true) ;;
    Z)   out=$(cycle_snooze global 2>&1 || true) ;;
    +|=) out=$(adjust_rate 10 2>&1 || true) ;;
    -|_) out=$(adjust_rate -10 2>&1 || true) ;;
    d|D)
      herdr plugin pane open --plugin herdr.tts --entrypoint tts-dashboard >/dev/null 2>&1 || true
      out="📊 Abriendo el dashboard…"
      ;;
    o|O)
      herdr plugin pane open --plugin herdr.tts --entrypoint tts-palette >/dev/null 2>&1 || true
      out="🎛️ Abriendo la paleta de voz…"
      ;;
    *) return 1 ;;
  esac
  out="${out%%$'\n'*}"
  MENU_RESULT="${out:-Comando de voz ejecutado}"
  return 0
}

# Popup entrypoint: render once, read ONE key, confirm briefly, exit.
# The ~1.5s dwell lets the confirmation be read; Herdr then closes the
# popup and restores focus. Fail-open: EOF / read failure (no tty,
# closed pipe) → exit 0 silently. q/Esc exits without a message. Note:
# an arrow key sends its ESC prefix byte first, so it quits the menu —
# deliberate, matching the dashboard's "ignore exotic input" stance.
run_voice_menu() {
  local key=""
  menu_render # one static frame, one physical write — then a single read
  if ! read -rsn1 key; then
    exit 0
  fi
  case "$key" in
    q|Q|$'\e')
      ;; # silent exit
    *)
      if menu_dispatch "$key"; then
        # Leading newline: the frame write leaves the cursor right after
        # the last row, so the confirmation must claim a fresh line.
        printf '\n✓ %s\n' "$MENU_RESULT"
      else
        printf '\n❓ Tecla no reconocida (%s) — pulsa q para salir\n' "$key"
      fi
      sleep "$MENU_CONFIRM_SECS"
      ;;
  esac
  exit 0
}

# ─── CLI Entrypoint ──────────────────────────────────────────

# Library mode: when sourced (tests/tooling), only define functions and
# configuration; dispatch CLI arguments only when executed directly.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
case "${1:-}" in
  --play|-p|--read-current)
    read_current_pane "${2:-}"
    ;;
  --highlight|-H)
    read_current_pane_visual "$@"
    ;;
  --autoscroll)
    read_current_pane_visual "$@"
    ;;
  --bionic)
    read_current_pane_visual "$@"
    ;;
  --zen)
    read_current_pane_visual "$@"
    ;;
  --stop|-s)
    stop_audio
    ;;
  --toggle-play|-r)
    shift
    toggle_play "$@"
    ;;
  --tldr|--summarize)
    shift || true
    read_current_pane "${1:-}" "--tldr"
    ;;
  --toggle-auto|--toggle|-t)
    toggle_auto
    ;;
  --snooze|--snooze-pane)
    # Optional explicit pane id (used by the voice palette); without one
    # the focused pane is targeted, as before.
    cycle_snooze pane "${2:-}"
    ;;
  --snooze-global)
    cycle_snooze global
    ;;
  --mute|--mute-pane)
    # Optional explicit pane id (used by the voice palette); without one
    # the focused pane is targeted, as before.
    toggle_pane_mute "${2:-}"
    ;;
  --debounce)
    if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
      TTS_DEBOUNCE_SECONDS="$2"
      save_config
      echo "✓ Ventana anti-spam (debounce): ${TTS_DEBOUNCE_SECONDS}s por (pane, estado); 0 = desactivado"
    else
      echo "Error: --debounce requiere un número de segundos (entero ≥ 0)" >&2
      exit 1
    fi
    ;;
  --gate-check)
    # Diagnostic for the pre-engine gate: exit 0 = event would be gated,
    # exit 1 = event would reach the engine.
    if gate_agent_event "${2:-}" "${3:-}" "${4:-diagnostic}"; then exit 0; else exit 1; fi
    ;;
  --auto-on)
    rm -f "$AUTO_MUTE_FILE"
    echo "🔊 Lectura automática activada"
    ;;
  --auto-off)
    touch "$AUTO_MUTE_FILE"
    echo "🔇 Lectura automática silenciada"
    ;;
  --scope)
    if [[ "${2:-}" == "focused" || "${2:-}" == "all" ]]; then
      TTS_AUTO_SCOPE="$2"
      save_config
      echo "✓ Alcance de auto-lectura: $TTS_AUTO_SCOPE"
    else
      echo "Error: Scope debe ser 'focused' o 'all'" >&2
      exit 1
    fi
    ;;
  --ntfy-topic)
    if [[ "${2:-}" == "off" || "${2:-}" == "none" || -z "${2:-}" ]]; then
      NTFY_TOPIC=""
      save_config
      echo "✓ Notificaciones móviles de ntfy desactivadas"
    else
      NTFY_TOPIC="$2"
      save_config
      echo "✓ Topic de ntfy configurado: $NTFY_TOPIC"
    fi
    ;;
  --ntfy-server)
    NTFY_SERVER="${2:-https://ntfy.sh}"
    save_config
    echo "✓ Servidor ntfy configurado: $NTFY_SERVER"
    ;;
  --web-url|--collie-url|--redirect-url)
    opt="$1"
    if [[ "${2:-}" == "off" || "${2:-}" == "none" || -z "${2:-}" ]]; then
      WEB_URL=""
      COLLIE_URL=""
      WEB_LABEL=""
      save_config
      echo "✓ Redirección web desactivada (notificaciones estándar sin URL externa)"
    else
      WEB_URL="$2"
      COLLIE_URL="$2"
      if [[ "$opt" == "--collie-url" && -z "$WEB_LABEL" ]]; then
        WEB_LABEL="Collie"
      fi
      save_config
      echo "✓ URL de redirección configurada: $WEB_URL"
    fi
    ;;
  --web-label)
    WEB_LABEL="${2:-}"
    save_config
    echo "✓ Etiqueta de botón web: ${WEB_LABEL:-auto}"
    ;;
  --click-redirect)
    if [[ "${2:-}" == "on" || "${2:-}" == "true" || "${2:-}" == "1" ]]; then
      CLICK_REDIRECT="on"
      echo "✓ Click directo activado (abrirá navegador al pulsar la tarjeta de notificación)"
    else
      CLICK_REDIRECT="off"
      echo "✓ Click directo desactivado (pulsar tarjeta abrirá ntfy con reproductor; botón abrirá web)"
    fi
    save_config
    ;;
  --play-file)
    play_audio_file "${2:-}"
    ;;
  --render-pane)
    render_pane_audio "${2:-}" "${3:-}"
    ;;
  --render-text)
    shift
    render_text_audio "$@"
    ;;
  --speak)
    shift
    speak_text "$*"
    ;;
  --seek)
    seek_audio "${2:-+10}"
    ;;
  --rewind)
    seek_audio "-10"
    ;;
  --forward)
    seek_audio "+10"
    ;;
  --next-sentence)
    next_sentence_audio
    ;;
  --prev-sentence)
    prev_sentence_audio
    ;;
  --next-paragraph)
    next_paragraph_audio
    ;;
  --prev-paragraph)
    prev_paragraph_audio
    ;;
  --pause)
    pause_audio
    ;;
  --resume)
    resume_audio
    ;;
  --toggle-pause)
    toggle_pause_audio
    ;;
  --rate-up)
    adjust_rate 10
    ;;
  --rate-down)
    adjust_rate -10
    ;;
  --player-status)
    get_player_status
    ;;
  --voice)
    TTS_VOICE="$2"
    save_config
    echo "✓ Voz configurada: $TTS_VOICE"
    speak_text "Voz cambiada a ${TTS_VOICE}."
    ;;
  --rate)
    TTS_RATE="$2"
    save_config
    echo "✓ Velocidad configurada: $TTS_RATE"
    speak_text "Velocidad ajustada."
    ;;
  --provider)
    prov="${2:-edge}"
    prov="${prov,,}"
    if [[ "$prov" == "edge" || "$prov" == "openai" || "$prov" == "elevenlabs" || "$prov" == "eleven" || "$prov" == "piper" || "$prov" == "local" ]]; then
      TTS_PROVIDER="$prov"
      save_config
      echo "✓ Proveedor TTS configurado: $TTS_PROVIDER"
      notify_herdr "🎙️ Proveedor TTS" "$TTS_PROVIDER"
    else
      echo "Error: Proveedor inválido '$prov'. Opciones válidas: edge, openai, elevenlabs, piper, local" >&2
      exit 1
    fi
    ;;
  --piper-model)
    PIPER_MODEL="${2:-}"
    save_config
    if [[ -n "$PIPER_MODEL" ]]; then
      echo "✓ Modelo Piper configurado: $PIPER_MODEL"
    else
      echo "✓ Modelo Piper reseteado a por defecto"
    fi
    ;;
  --openai-key)
    OPENAI_API_KEY="${2:-}"
    save_config
    if [[ -n "$OPENAI_API_KEY" ]]; then
      echo "✓ OpenAI API Key configurada"
    else
      echo "✓ OpenAI API Key eliminada"
    fi
    ;;
  --openai-base-url)
    OPENAI_BASE_URL="${2:-https://api.openai.com/v1}"
    save_config
    echo "✓ OpenAI Base URL configurada: $OPENAI_BASE_URL"
    ;;
  --openai-model)
    OPENAI_TTS_MODEL="${2:-tts-1}"
    save_config
    echo "✓ OpenAI TTS Model configurado: $OPENAI_TTS_MODEL"
    ;;
  --eleven-key|--elevenlabs-key)
    ELEVENLABS_API_KEY="${2:-}"
    save_config
    if [[ -n "$ELEVENLABS_API_KEY" ]]; then
      echo "✓ ElevenLabs API Key configurada"
    else
      echo "✓ ElevenLabs API Key eliminada"
    fi
    ;;
  --eleven-model|--elevenlabs-model)
    ELEVENLABS_MODEL="${2:-eleven_multilingual_v2}"
    save_config
    echo "✓ ElevenLabs Model configurado: $ELEVENLABS_MODEL"
    ;;
  --auto-lang)
    if [[ "${2:-}" == "on" || "${2:-}" == "true" || "${2:-}" == "1" ]]; then
      TTS_AUTO_LANG="on"
      echo "✓ Detección de idioma y cambio dinámico de voz activado"
      notify_herdr "🌐 Detección de idioma" "Activada (cambio dinámico de voz)"
    else
      TTS_AUTO_LANG="off"
      echo "✓ Detección de idioma desactivada"
      notify_herdr "🌐 Detección de idioma" "Desactivada"
    fi
    save_config
    ;;
  --podcast)
    if [[ "${2:-}" == "on" || "${2:-}" == "true" || "${2:-}" == "1" ]]; then
      PODCAST_ENABLED="on"
      echo "✓ Publicación automática en feed de podcast activada"
      notify_herdr "🎙️ Podcast RSS" "Publicación activada"
    else
      PODCAST_ENABLED="off"
      echo "✓ Publicación automática en feed de podcast desactivada"
      notify_herdr "🎙️ Podcast RSS" "Publicación desactivada"
    fi
    save_config
    ;;
  --podcast-port)
    PODCAST_PORT="${2:-8844}"
    save_config
    echo "✓ Puerto de podcast configurado: $PODCAST_PORT"
    ;;
  --podcast-serve|--podcast-server)
    # NOTE: no `local` here — this runs at script top level, where `local`
    # is fatal under `set -euo pipefail`.
    port="${2:-$PODCAST_PORT}"
    pod_dir="${DATA_DIR}/podcast"
    mkdir -p "$pod_dir"
    echo "🎙️ Servidor de Podcast RSS iniciado en http://0.0.0.0:${port}/podcast.xml"
    "$VENV_PYTHON" -c "from agent_tts.podcast import run_podcast_server; run_podcast_server(port=${port}, podcast_dir='${pod_dir}')"
    ;;
  --podcast-publish)
    publish_current_pane_podcast
    ;;
  --status)
    show_status
    ;;
  --dashboard)
    run_dashboard
    ;;
  --voice-palette)
    run_voice_palette
    ;;
  --voice-menu)
    run_voice_menu
    ;;
  --palette-preview)
    palette_preview "${2:-}"
    ;;
  _daemon)
    run_daemon
    ;;
  --help|-h)
    cat <<EOF
Uso: herdr-tts [OPCIONES]

Acciones principales:
  --toggle-play (-r)       Play / Stop toggle en el pane actual enfocado (Tecla: prefix+r)
  --tldr                   Resumen rápido TL;DR del pane actual enfocado (Tecla: prefix+t)
  --stop (-s)              Detener inmediatamente cualquier audio sonando (Tecla: prefix+s)
  --toggle-pause           Pausar / Reanudar audio en reproducción (Tecla: prefix+p)
  --seek <+/-s>            Avanzar o retroceder segundos (p. ej. +10 o -10)
  --rewind                 Retroceder 10 segundos (Tecla: prefix+[)
  --forward                Avanzar 10 segundos (Tecla: prefix+])
  --next-sentence          Avanzar a la siguiente frase en reproducción (Tecla: prefix+n)
  --prev-sentence          Retroceder a la frase anterior en reproducción (Tecla: prefix+N)
  --next-paragraph         Avanzar al siguiente párrafo en reproducción
  --prev-paragraph         Retroceder al párrafo anterior en reproducción
  --play (-p)              Leer la última respuesta del chat enfocado
  --toggle-auto (-t)       Alternar lectura automática de fondo (Tecla: prefix+v)
  --scope focused|all      'focused' (solo chat activo) | 'all' (cualquiera sin solapar)

Experiencia visual y lectura sincronizada:
  --highlight (-H)         Leer respuesta en terminal con resaltado karaoke en tiempo real
  --autoscroll             Leer con auto-scroll sincronizado al compás de la voz
  --bionic                 Lectura biónica (fijación en negrita de las primeras letras)
  --zen                    Modo Zen (pantalla completa, alto contraste, sin distracciones)

Silencio granular (snooze y mute por pane, antes de llamar al motor):
  --snooze                 Snooze del pane enfocado: 5m → 30m → 2h → off (Tecla: prefix+z)
  --snooze-global          Snooze GLOBAL de todos los agentes, ideal para reuniones (Tecla: prefix+Z)
  --mute-pane              Silenciar el pane enfocado; se reactiva al cerrarse el pane (Tecla: prefix+m)
  --debounce <segundos>    Ventana anti-spam por (pane, estado); 0 = desactivado (default: 20)
  --gate-check <pane> <estado> [agente]
                           Diagnóstico del gating: exit 0 = evento filtrado, exit 1 = llegaría al motor

Configuración de voz y velocidad:
  --voice <nombre>         Cambiar voz (elvira, alvaro, ximena, dalia, jorge)
  --rate <velocidad>       Cambiar velocidad (+20%, +10%, +0%)
  --auto-lang on|off       Detección automática de idioma y cambio dinámico de voz
  --rate-up                Acelerar lectura +10% en caliente (Tecla: prefix+=)
  --rate-down              Ralentizar lectura -10% en caliente (Tecla: prefix+-)

Proveedores de síntesis (TTS Providers):
  --provider <motor>       Seleccionar proveedor: edge (gratis), openai, elevenlabs, piper (offline)
  --piper-model <ruta>     Ruta al archivo de modelo Piper ONNX (.onnx)
  --openai-key <key>       API key para OpenAI TTS
  --openai-base-url <url>  Base URL personalizada (default: https://api.openai.com/v1)
  --openai-model <model>   Modelo OpenAI TTS (default: tts-1)
  --eleven-key <key>       API key para ElevenLabs
  --eleven-model <model>   Modelo ElevenLabs (default: eleven_multilingual_v2)

Notificaciones móviles (opcional):
  --ntfy-topic <topic>     Topic de ntfy.sh para recibir push con audio en móvil (o 'off')
  --ntfy-server <url>      Servidor ntfy personalizado (default: https://ntfy.sh)
  --web-url <url>          URL opcional de web UI / dashboard (p. ej. Collie) (o 'off')
  --collie-url <url>       Alias de --web-url para Collie
  --web-label <texto>      Etiqueta personalizada para el botón de acción web
  --click-redirect on|off  Redirigir al tocar la tarjeta de notificación (default: off)

Podcast RSS privado (para escuchar en móvil con Pocket Casts / Overcast / Apple Podcasts):
  --podcast on|off         Activar publicación automática de audios en el feed RSS
  --podcast-serve [puerto] Iniciar servidor local HTTP de podcast (default: 8844)
  --podcast-port <puerto>  Cambiar puerto del servidor podcast (default: 8844)
  --podcast-publish        Publicar respuesta actual directamente al feed de podcast

Información:
   --status                 Ver estado actual, lock y configuración
   --dashboard              Panel TUI en vivo (pane de Herdr): estado por chat,
                            audios agrupados por chat, snoozes e historial
                            (controles: q salir · j/k chat · m silenciar · z snooze pane · Z snooze global · +/- velocidad)
    --voice-palette          Selector interactivo (fzf, pane de Herdr) de chats y
                            audios: enter enfoca, ctrl-m silencia, ctrl-z snooze
    --voice-menu             Menú de voz de una sola tecla (popup): muestra los
                            comandos, lee una tecla, la ejecuta y se cierra
                            (suggested: prefix+u → action open-menu)
    --palette-preview <pane> Cabecera de chat + turnos de audio del pane (preview fzf)
EOF
    ;;
  *)
    run_daemon
    ;;
esac
fi
